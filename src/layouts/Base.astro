---
import "../styles/global.css";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const {
  title = "Ollastack — AI agent forms, mailboxes & email testing",
  description = "One platform for AI agents: forms they can submit, agent mailboxes that send and receive email, and disposable inboxes for email testing in CI.",
  current,
} = Astro.props;
const origin = (Astro.site ?? new URL("https://ollastack.com")).origin;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://ollastack.com").toString();
// Social scrapers require an absolute image URL.
const ogImage = `${origin}/og.png`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ollastack — AI agent forms, mailboxes and email testing" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#fafaf7" />
  <title>{title}</title>
</head>
<body>
  <AnnouncementBar />
  <Nav current={current} />
  <main><slot /></main>
  <Footer />
</body>
</html>
