---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { posts, fmtDate, type PostMeta } from "../data/posts";

interface Props {
  slug: string;
  title: string;
  description: string;
  publishedAt: string;
  updatedAt: string;
  readingTime: string;
  ctaLocation: string;
  faq?: { q: string; a: string }[];
}

const APP = "https://login.ollastack.com";
const SITE = "https://ollastack.com";
const { slug, title, description, publishedAt, updatedAt, readingTime, ctaLocation, faq } = Astro.props;

// Determine category for post
function getPostCategory(s: string): { label: string; href: string; icon: string } {
  const lower = s.toLowerCase();
  if (lower.includes("agent") || lower.includes("ai")) {
    return { label: "AI Agents", href: "/blog?cat=ai-agents", icon: "🤖" };
  }
  if (lower.includes("email") || lower.includes("test") || lower.includes("otp") || lower.includes("inbox")) {
    return { label: "Email Testing", href: "/blog?cat=email-testing", icon: "✉️" };
  }
  if (lower.includes("vs") || lower.includes("alternative")) {
    return { label: "Comparisons", href: "/blog?cat=comparisons", icon: "⚖️" };
  }
  if (lower.includes("migrate") || lower.includes("migration")) {
    return { label: "Migrations", href: "/blog?cat=migrations", icon: "🚀" };
  }
  if (lower.includes("webhook") || lower.includes("quickstart") || lower.includes("form") || lower.includes("backend")) {
    return { label: "Integrations", href: "/blog?cat=integrations", icon: "⚡" };
  }
  return { label: "Engineering", href: "/blog", icon: "💡" };
}

const category = getPostCategory(slug);

// FAQPage structured data
const faqLd =
  faq && faq.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

// Related posts
const collectionPosts: PostMeta[] = (
  await getCollection("blog", ({ data }) => data.draft !== true)
).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString().slice(0, 10),
  readingTime: `${p.data.readingTime} min read`,
}));
const STOP = new Set(["the","a","an","to","for","and","in","of","with","your","from","how","2026","without","vs","form","forms","email","api"]);
const toks = (s: string) => new Set(s.split("-").filter((t) => t.length > 2 && !STOP.has(t)));
const cur = toks(slug);
const related: PostMeta[] = [...posts, ...collectionPosts]
  .filter((p) => p.slug !== slug)
  .map((p) => ({ p, score: [...toks(p.slug)].filter((t) => cur.has(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.date.localeCompare(a.p.date))
  .slice(0, 4)
  .map((x) => x.p);

// Article structured data
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  author: { "@type": "Organization", name: "Ollastack", url: SITE },
  publisher: {
    "@type": "Organization",
    name: "Ollastack",
    logo: { "@type": "ImageObject", url: `${SITE}/logo.svg` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE}/blog/${slug}/` },
  image: `${SITE}/og.png`,
};
---

<Base title={title} description={description} current="blog">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />}

  <div class="blog-shell">
    <!-- LEFT RAIL: Table of Contents -->
    <aside class="left-rail">
      <div class="left-sticky">
        <a href="/blog" class="back-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>All Articles</span>
        </a>

        <div class="toc-card">
          <div class="toc-card-header">
            <div class="toc-card-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span>On this page</span>
            </div>
            <span class="toc-badge" id="toc-count"></span>
          </div>
          <nav class="toc-list" id="toc" aria-label="Table of contents">
            <!-- Dynamically populated -->
          </nav>
        </div>
      </div>
    </aside>

    <!-- MAIN ARTICLE -->
    <article class="post">
      <header class="post-hero">
        <div class="post-badges">
          <a href={category.href} class="category-badge">
            <span class="cat-icon">{category.icon}</span>
            <span class="cat-label">{category.label}</span>
          </a>
          <span class="read-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readingTime}
          </span>
        </div>

        <h1 class="post-title">{title}</h1>

        <div class="post-meta-bar">
          <div class="author-box">
            <div class="author-avatar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="4" fill="#DC2626" />
                <path d="M6 8C8 7 11 7 13 8C15 9 18 8 18 8" stroke="white" stroke-width="2" stroke-linecap="round"/>
                <path d="M6 12C8 11 11 11 13 12C15 13 18 12 18 12" stroke="white" stroke-width="2" stroke-linecap="round"/>
                <path d="M6 16C8 15 11 15 13 16C15 17 18 16 18 16" stroke="white" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="author-details">
              <span class="author-name">Ollastack Engineering</span>
              <span class="author-role">Product & Architecture</span>
            </div>
          </div>

          <div class="meta-divider"></div>

          <div class="date-info">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <time datetime={publishedAt}>{fmtDate(publishedAt)}</time>
          </div>
        </div>
      </header>

      <section class="body">
        <slot />

        {faq && faq.length > 0 && (
          <section class="post-faq">
            <div class="faq-header">
              <span class="faq-pill">FAQ</span>
              <h2 id="faq">Frequently Asked Questions</h2>
            </div>
            <div class="faq-list">
              {faq.map((f) => (
                <details class="faq-item">
                  <summary class="faq-summary">
                    <span>{f.q}</span>
                    <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="faq-answer">
                    <p>{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </section>

      <!-- Bottom Related Articles -->
      {related.length > 0 && (
        <section class="related-section" aria-label="Related articles">
          <div class="related-header">
            <span class="section-badge">EXPLORE MORE</span>
            <h3>Related Articles</h3>
          </div>
          <div class="related-grid">
            {related.map((p) => (
              <a href={`/blog/${p.slug}/`} class="related-card">
                <div class="related-meta">
                  <span class="related-cat">{getPostCategory(p.slug).label}</span>
                  <span class="related-time">{p.readingTime}</span>
                </div>
                <h4 class="related-title">{p.title}</h4>
                <div class="related-arrow">
                  <span>Read article</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>

    <!-- RIGHT RAIL: Developer CTA Card -->
    <aside class="right-rail">
      <div class="right-sticky">
        <div class="cta-box">
          <div class="cta-box-badge">
            <span class="pulse-dot"></span>
            <span>FOR DEVELOPERS & AGENTS</span>
          </div>

          <div class="cta-logo-wrap">
            <div class="cta-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M4 7C7 5 11 5 14 7C17 9 20 8 20 8" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M4 12C7 10 11 10 14 12C17 14 20 13 20 13" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M4 17C7 15 11 15 14 17C17 19 20 18 20 18" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <div class="cta-brand">Ollastack</div>
              <div class="cta-subbrand">API Platform</div>
            </div>
          </div>

          <h4 class="cta-heading">The message layer for AI workflows</h4>
          <p class="cta-desc">
            One single API for agent mailboxes, form ingestion, and automated disposable test inboxes in CI.
          </p>

          <ul class="cta-features">
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Instant agent email generation</span>
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Zero-backend form handling</span>
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Fast OTP verification in CI/CD</span>
            </li>
          </ul>

          <a href={`${APP}/register`} class="cta-action-btn">
            <span>Start free sandbox</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <p class="cta-guarantee">No credit card · Free tier includes 50 runs/mo</p>
        </div>
      </div>
    </aside>
  </div>
</Base>

<script is:inline>
  // Table of Contents Scroll-Spy
  (function () {
    const toc = document.getElementById("toc");
    const countEl = document.getElementById("toc-count");
    if (!toc) return;

    const headings = Array.from(document.querySelectorAll("article .body h2[id]"));
    if (!headings.length) {
      toc.innerHTML = '<p class="toc-empty">No sections found</p>';
      return;
    }

    if (countEl) {
      countEl.textContent = `${headings.length}`;
    }

    toc.innerHTML = headings
      .map((h, i) => {
        const num = String(i + 1).padStart(2, "0");
        return (
          `<a href="#${h.id}" class="toc-link" data-target="${h.id}">` +
          `<span class="toc-index">${num}</span>` +
          `<span class="toc-text">${h.textContent}</span>` +
          `</a>`
        );
      })
      .join("");

    const links = Array.from(toc.querySelectorAll("a[data-target]"));
    const byId = Object.fromEntries(links.map((a) => [a.getAttribute("data-target"), a]));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove("active"));
            const link = byId[entry.target.id];
            if (link) {
              link.classList.add("active");
              link.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
          }
        }
      },
      { rootMargin: "-90px 0px -70% 0px", threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  })();
</script>

<style>
  /* ==========================================================================
     MODERN DEVELOPER BLOG POST LAYOUT
     ========================================================================== */

  .blog-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 260px;
    gap: 48px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px 32px 100px;
    align-items: start;
    box-sizing: border-box;
  }

  /* ------------------- Left Rail & TOC ------------------- */
  .left-rail {
    position: sticky;
    top: 88px;
    align-self: start;
  }
  .left-sticky {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: calc(100vh - 110px);
  }
  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #475569;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 8px 16px;
    border-radius: 9999px;
    transition: all 0.2s ease;
    text-decoration: none;
    align-self: flex-start;
  }
  .back-pill:hover {
    color: #DC2626;
    background: #fff1f2;
    border-color: #fecdd3;
    transform: translateX(-3px);
  }

  .toc-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .toc-card-header {
    background: #f8fafc;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e2e8f0;
  }
  .toc-card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #334155;
  }
  .toc-badge {
    font-size: 11px;
    font-weight: 700;
    color: #DC2626;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    padding: 1px 7px;
    border-radius: 999px;
  }
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 8px;
    max-height: calc(100vh - 240px);
    overflow-y: auto;
  }
  .toc-list::-webkit-scrollbar { width: 3px; }
  .toc-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  
  .toc-list :global(.toc-link) {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
    font-size: 13px;
    line-height: 1.4;
    color: #64748b;
  }
  .toc-list :global(.toc-index) {
    font-size: 11px;
    font-family: var(--font-mono);
    color: #94a3b8;
    padding-top: 1px;
    flex-shrink: 0;
  }
  .toc-list :global(.toc-text) {
    font-weight: 500;
  }
  .toc-list :global(.toc-link:hover) {
    color: #0f172a;
    background: #f1f5f9;
  }
  .toc-list :global(.toc-link.active) {
    color: #DC2626;
    background: #fff1f2;
    font-weight: 700;
  }
  .toc-list :global(.toc-link.active .toc-index) {
    color: #DC2626;
    font-weight: 700;
  }
  .toc-list :global(.toc-empty) {
    font-size: 12px;
    color: #94a3b8;
    text-align: center;
    padding: 12px;
  }

  /* ------------------- Article & Hero ------------------- */
  .post {
    min-width: 0;
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
  }

  .post-hero {
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid #e2e8f0;
  }
  .post-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #DC2626;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    padding: 4px 12px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .category-badge:hover {
    background: #ffe4e6;
    transform: translateY(-1px);
  }
  .read-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: 2.45rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #0f172a;
    margin: 0 0 24px;
    word-break: break-word;
  }

  .post-meta-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    padding-top: 16px;
    border-top: 1px dashed #e2e8f0;
  }
  .author-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .author-avatar {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #fee2e2;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #fca5a5;
  }
  .author-details {
    display: flex;
    flex-direction: column;
  }
  .author-name {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
  }
  .author-role {
    font-size: 11.5px;
    color: #64748b;
    line-height: 1.2;
  }
  .meta-divider {
    width: 1px;
    height: 24px;
    background: #e2e8f0;
  }
  .date-info {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #64748b;
    font-weight: 500;
  }

  /* ------------------- Article Body & Prose ------------------- */
  .body :global(.lede) {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #334155;
    font-weight: 400;
    margin: 0 0 36px;
    padding: 16px 20px;
    background: #f8fafc;
    border-left: 4px solid #DC2626;
    border-radius: 0 10px 10px 0;
  }

  .body :global(h2) {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 52px 0 18px;
    scroll-margin-top: 96px;
    padding-bottom: 8px;
    border-bottom: 1px solid #f1f5f9;
  }
  .body :global(h3) {
    font-size: 1.3rem;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.01em;
    line-height: 1.4;
    margin: 36px 0 14px;
    scroll-margin-top: 96px;
  }
  .body :global(p) {
    font-size: 1.05rem;
    line-height: 1.78;
    color: #334155;
    margin: 0 0 20px;
  }
  .body :global(strong) {
    color: #0f172a;
    font-weight: 700;
  }
  .body :global(ul),
  .body :global(ol) {
    font-size: 1.05rem;
    line-height: 1.78;
    color: #334155;
    padding-left: 24px;
    margin: 0 0 22px;
  }
  .body :global(li) {
    margin-bottom: 8px;
  }

  /* Inline Code */
  .body :global(:not(pre) > code) {
    background: #f1f5f9 !important;
    color: #0f172a !important;
    border: 1px solid #e2e8f0 !important;
    padding: 2px 7px !important;
    border-radius: 6px !important;
    font-family: var(--font-mono);
    font-size: 0.88em;
    font-weight: 600;
  }

  /* Links in body */
  .body :global(a) {
    color: #DC2626 !important;
    font-weight: 600;
    text-decoration: underline !important;
    text-decoration-color: rgba(225, 29, 72, 0.4) !important;
    text-underline-offset: 3px !important;
    transition: all 0.15s ease;
  }
  .body :global(a:hover) {
    color: #be123c !important;
    text-decoration-color: #be123c !important;
  }

  /* Code Blocks */
  .body :global(.code),
  .body :global(pre.code),
  .body :global(pre) {
    background: #0f172a !important;
    color: #f8fafc !important;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 22px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.65;
    overflow-x: auto;
    margin: 20px 0 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  /* Key Takeaways Callout */
  .body :global(.takeaways-box) {
    background: #fdf2f4 !important;
    border: 1px solid #fecdd3 !important;
    border-left: 5px solid #DC2626 !important;
    border-radius: 14px !important;
