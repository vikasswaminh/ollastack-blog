---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { posts, fmtDate, type PostMeta } from "../data/posts";

interface Props {
  slug: string;
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  readingTime: string;
  ctaLocation?: string;
  faq?: { q: string; a: string }[];
}

const APP = "https://login.ollastack.com";
const SITE = "https://ollastack.com";
const {
  slug,
  title,
  description,
  publishedAt,
  updatedAt = publishedAt,
  readingTime,
  ctaLocation = "blog",
  faq,
} = Astro.props;

// Determine category for post
function getPostCategory(s: string): { label: string; href: string; icon: string } {
  const lower = s.toLowerCase();
  if (lower.includes("agent") || lower.includes("ai") || lower.includes("read-otp")) {
    return { label: "AI Agents", href: "/blog?cat=ai-agents", icon: "🤖" };
  }
  if (lower.includes("email") || lower.includes("test") || lower.includes("otp") || lower.includes("inbox") || lower.includes("playwright") || lower.includes("cypress")) {
    return { label: "Email Testing", href: "/blog?cat=email-testing", icon: "✉️" };
  }
  if (lower.includes("vs") || lower.includes("alternative")) {
    return { label: "Comparisons", href: "/blog?cat=comparisons", icon: "⚖️" };
  }
  if (lower.includes("migrate") || lower.includes("migration")) {
    return { label: "Migrations", href: "/blog?cat=migrations", icon: "🚀" };
  }
  if (lower.includes("webhook") || lower.includes("quickstart") || lower.includes("form") || lower.includes("backend") || lower.includes("react") || lower.includes("vue") || lower.includes("svelte")) {
    return { label: "Integrations", href: "/blog?cat=integrations", icon: "🔌" };
  }
  return { label: "Engineering", href: "/blog", icon: "💡" };
}

const category = getPostCategory(slug);

const fmtMonthYear = (iso: string) => {
  try {
    const d = new Date(iso.includes("T") ? iso : iso + "T00:00:00Z");
    return d.toLocaleDateString("en-US", { month: "long", year: "numeric" });
  } catch {
    return "January 2026";
  }
};

// FAQPage structured data
const faqLd =
  faq && faq.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

// Founder Special sidebar posts
const founderSpecialPosts = [
  { title: "Form Backend vs Form Builder: What Developers Should Choose in 2026", slug: "form-backend-for-ai-agents" },
  { title: "How to Automate OTP Email Testing in CI/CD Pipelines", slug: "how-to-automate-otp-email-testing-in-ci-cd-pipelines" },
  { title: "How to Build a Form Backend for a Static Site Without Writing a Server", slug: "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" },
  { title: "Self-Host vs Hosted Form Backend: Complete Decision Framework", slug: "self-host-vs-hosted-form-backend" },
  { title: "Per-Tenant SMTP: Send Notifications from Each Client's Domain", slug: "per-tenant-smtp-guide" },
  { title: "Form Webhooks Done Right: Cryptographic Signatures & Replay", slug: "form-webhooks-guide" },
  { title: "Zero Trust Inbound Endpoints: Securing Forms Against Automated Spam", slug: "secure-forms-honeypot-captcha" },
  { title: "ML Spam Quarantine: Why Your Form Backend Must Fail Open", slug: "ml-quarantine-explained" },
  { title: "Assert on Email in Playwright & Cypress Test Suites", slug: "assert-on-email-in-playwright-cypress" },
  { title: "Accept File Uploads in Static Forms Without S3 or Servers", slug: "file-uploads-forms-multipart" },
  { title: "Form Design for Higher Conversions & Zero Spam", slug: "form-design-conversion" },
  { title: "12-Month Security Engineer Blueprint for Form & Mail Endpoints", slug: "api-security-longform" },
  { title: "BGP & Global Anycast Routing for Inbound Mail Delivery", slug: "2026-07-20-debug-deliverability-longform" },
  { title: "DKIM, SPF & DMARC for Transactional Form Notifications", slug: "dkim-spf-dmarc-custom-sender" },
];

// AI Special sidebar posts
const aiSpecialPosts = [
  { title: "What Is an Agent Email API and Why Does It Matter for AI Workflows?", slug: "what-is-an-agent-email-api" },
  { title: "Build an AI Agent That Sends and Receives Email (with MCP)", slug: "build-ai-agent-that-sends-and-receives-email" },
  { title: "Give Your AI Agent an Email Identity (Full Duplex Comms)", slug: "agent-email-identity" },
  { title: "Can AI Agents Submit Forms Safely? What Developers Must Know", slug: "can-ai-agents-submit-forms-safely" },
  { title: "Read OTP Verification Code in AI Agent Workflows", slug: "read-otp-verification-code-in-ai-agent" },
  { title: "Test Email in Docker & CI with Ephemeral Disposable Inboxes", slug: "test-inbox-docker" },
  { title: "AgentMail Alternative: Agent Inboxes + Forms + CI Testing", slug: "agentmail-alternative" },
  { title: "Email for AI Agents: Dedicated Inboxes vs Send-Only APIs", slug: "email-for-ai-agents" },
  { title: "How to Secure Public Form Endpoints from AI Scraping & Abuse", slug: "secure-forms-honeypot-captcha" },
  { title: "Next.js 15 Serverless Form Backend Integration Guide", slug: "nextjs-quickstart-hosted-form" },
  { title: "Free Temporary & Disposable Email APIs for Automation", slug: "free-temporary-email-api" },
  { title: "Inbound Webhooks & Automated Parsing for AI Agents", slug: "inbound-email-api" },
  { title: "Automated OTP Verification in GitHub Actions Workflows", slug: "test-otp-email-in-ci" },
];

// Related posts
const collectionPosts: PostMeta[] = (
  await getCollection("blog", ({ data }) => data.draft !== true)
).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString().slice(0, 10),
  readingTime: `${p.data.readingTime} min read`,
}));
const STOP = new Set(["the","a","an","to","for","and","in","of","with","your","from","how","2026","without","vs","form","forms","email","api"]);
const toks = (s: string) => new Set(s.split("-").filter((t) => t.length > 2 && !STOP.has(t)));
const cur = toks(slug);
const related: PostMeta[] = [...posts, ...collectionPosts]
  .filter((p) => p.slug !== slug)
  .map((p) => ({ p, score: [...toks(p.slug)].filter((t) => cur.has(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.date.localeCompare(a.p.date))
  .slice(0, 3)
  .map((x) => x.p);

// Article structured data
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  author: { "@type": "Organization", name: "Ollastack", url: SITE },
  publisher: {
    "@type": "Organization",
    name: "Ollastack",
    logo: { "@type": "ImageObject", url: `${SITE}/ollastack-logo-mark.png` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE}/blog/${slug}/` },
  image: `${SITE}/og.png`,
};
---

<Base title={title} description={description} current="blog">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />}

  <!-- RED ACCENT STRIP BELOW HEADER -->
  <div class="article-top-accent-bar"></div>

  <!-- 3-COLUMN EDITORIAL ARTICLE CONTAINER (EXACT MATCH TO REFERENCE) -->
  <div class="article-magazine-shell">
    <div class="article-layout-grid">

      <!-- ================= LEFT COLUMN: FOUNDER SPECIAL ================= -->
      <aside class="col-left">
        <div class="pill-badge pill-orange">
          <span>FOUNDER SPECIAL</span>
        </div>

        <ul class="clean-link-list">
          {founderSpecialPosts.map((item) => (
            <li>
              <a
                href={`/blog/${item.slug}/`}
                class:list={["side-link", item.slug === slug && "active-orange"]}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>

        <div class="side-view-all">
          <a href="/blog#all-articles" class="view-all-orange">View All →</a>
        </div>
      </aside>

      <!-- ================= CENTER COLUMN: MAIN ARTICLE ================= -->
      <main class="col-center">
        
        <!-- LEAD CALLOUT HERO BOX WITH BLACK LEFT ACCENT -->
        <header class="lead-hero-box">
          <div class="lead-quote-content">
            <h1 class="lead-quote-text">{description}</h1>
            <p class="lead-quote-subtitle">{title}</p>
          </div>
        </header>

        <!-- METADATA ROW WITH ICONS -->
        <div class="article-meta-row">
          <a href={category.href} class="meta-item-tag">
            <svg class="meta-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>{category.label}</span>
          </a>

          <div class="meta-item">
            <svg class="meta-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{readingTime}</span>
          </div>

          <div class="meta-item">
            <svg class="meta-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Updated {fmtMonthYear(updatedAt)}</span>
          </div>
        </div>

        <!-- ABOUT THE OLLASTACK ENGINEERING TEAM CARD -->
        <div class="about-team-card">
          <div class="team-card-header">
            <div class="team-avatar-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div class="team-info">
              <h2 class="team-card-title">About the Ollastack Engineering Team</h2>
              <p class="team-card-bio">
                Our content is written by industry practitioners with hands-on experience in enterprise and agentic environments. We don't write theory — we share what actually works in production.
              </p>
            </div>
          </div>

          <div class="team-badges-row">
            <div class="team-badge-item">
              <span class="badge-icon">🏢</span>
              <span>Production Labs</span>
            </div>
            <div class="team-badge-item">
              <span class="badge-icon">🛡️</span>
              <span>SOC2 Type II Certified</span>
            </div>
            <div class="team-badge-item">
              <span class="badge-icon">📖</span>
              <span>Career-First Content</span>
            </div>
            <div class="team-badge-item">
              <span class="badge-icon">👥</span>
              <span>10M+ Form Submissions</span>
            </div>
          </div>
        </div>

        <!-- ARTICLE EDITORIAL BODY CONTENT -->
        <article class="article-body-content">
          <slot />

          <!-- FAQ ACCORDION -->
          {faq && faq.length > 0 && (
            <section class="post-faq-section">
              <div class="faq-header-bar">
                <span class="faq-pill-label">FAQ</span>
                <h2 id="faq">Frequently Asked Questions</h2>
              </div>
              <div class="faq-accordion-list">
                {faq.map((f) => (
                  <details class="faq-accordion-item">
                    <summary class="faq-accordion-summary">
                      <span>{f.q}</span>
                      <svg class="faq-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </summary>
                    <div class="faq-accordion-body">
                      <p>{f.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}
        </article>

        <!-- BOTTOM RELATED ARTICLES STRIP -->
        {related.length > 0 && (
          <section class="bottom-related-section" aria-label="Related articles">
            <div class="related-head-bar">
              <span class="related-badge">EXPLORE MORE</span>
              <h3>Recommended Next Reads</h3>
            </div>
            <div class="related-cards-grid">
              {related.map((p) => (
                <a href={`/blog/${p.slug}/`} class="related-article-card">
                  <div class="rel-meta-row">
                    <span class="rel-cat">{getPostCategory(p.slug).label}</span>
                    <span class="rel-time">{p.readingTime}</span>
                  </div>
                  <h4 class="rel-title">{p.title}</h4>
                  <div class="rel-read-link">
                    <span>Read guide</span>
                    <span class="rel-arr">→</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </main>

      <!-- ================= RIGHT COLUMN: AI SPECIAL ================= -->
      <aside class="col-right">
        <div class="pill-badge pill-purple">
          <span>AI SPECIAL</span>
        </div>

        <ul class="clean-link-list">
          {aiSpecialPosts.map((item, idx) => (
            <li>
              <a
                href={`/blog/${item.slug}/`}
                class:list={[
                  "side-link",
                  idx === 3 && item.slug !== slug && "side-highlight-purple",
                  item.slug === slug && "active-purple",
                ]}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>

        <div class="side-view-all">
          <a href="/blog#all-articles" class="view-all-purple">View All →</a>
        </div>

        <!-- RIGHT RAIL CTA BUTTON (EXACT RED PILL AS REFERENCE) -->
        <div class="right-cta-btn-wrap">
          <a href={`${APP}/register`} class="btn-sidebar-counsel">
            <span class="btn-spark">✦</span>
            <span>Get Free API Key</span>
          </a>
        </div>
      </aside>

    </div>
  </div>

  <!-- FLOATING RED CTA BUTTON AT BOTTOM RIGHT -->
  <a href={`${APP}/register`} class="floating-article-cta" id="article-cta-btn">
    <span class="spark">✦</span>
    <span>Start Building Free</span>
  </a>
</Base>

<style is:global>
  /* Base reset & typography adjustments */
  .article-top-accent-bar {
    width: 100%;
    height: 4px;
    background: #DC2626;
    margin-bottom: 0;
  }

  .article-magazine-shell {
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px 24px 72px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #1a1a1a;
  }

  .article-layout-grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 36px;
    align-items: start;
  }

  /* ---------------- SIDEBARS (LEFT & RIGHT) ---------------- */
  .col-left, .col-right {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 24px;
  }
  .col-left::-webkit-scrollbar, .col-right::-webkit-scrollbar {
    display: none;
  }

  /* Pill Badges */
  .pill-badge {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: 9999px;
    margin-bottom: 18px;
    text-transform: uppercase;
  }
  .pill-orange {
    background: #fff7ed;
    color: #ea580c;
    border: 1px solid #fed7aa;
  }
  .pill-purple {
    background: #faf5ff;
    color: #9333ea;
    border: 1px solid #e9d5ff;
  }

  /* Clean list of text links */
  .clean-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .side-link {
    display: block;
    font-size: 12.5px;
    line-height: 1.45;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .side-link:hover {
    color: #0f172a;
    transform: translateX(2px);
  }
  .side-link.active-orange {
    color: #ea580c;
    font-weight: 700;
  }
  .side-link.active-purple {
    background: #f3e8ff;
    color: #7e22ce;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 6px;
  }
  .side-highlight-purple {
    background: #faf5ff;
    color: #7e22ce !important;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid #f3e8ff;
  }

  .side-view-all {
    margin-top: 16px;
  }
  .view-all-orange {
    font-size: 12px;
    font-weight: 700;
    color: #ea580c;
    text-decoration: none;
  }
  .view-all-orange:hover { text-decoration: underline; }
  .view-all-purple {
    font-size: 12px;
    font-weight: 700;
    color: #9333ea;
    text-decoration: none;
  }
  .view-all-purple:hover { text-decoration: underline; }

  /* Right Sidebar Button */
  .right-cta-btn-wrap {
    margin-top: 24px;
  }
  .btn-sidebar-counsel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #DC2626;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 16px;
    border-radius: 9999px;
    text-decoration: none !important;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
    transition: all 0.18s ease;
  }
  .btn-sidebar-counsel:hover {
    background: #B91C1C;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(220, 38, 38, 0.45);
  }
  .btn-spark {
    font-size: 12px;
  }

  /* ---------------- CENTER MAIN COLUMN ---------------- */
  .col-center {
    min-width: 0;
  }

  /* Lead Quote Hero Box */
  .lead-hero-box {
    margin-bottom: 20px;
  }
  .lead-quote-content {
    border-left: 4.5px solid #09090b;
    padding: 4px 0 4px 22px;
  }
  .lead-quote-text {
    font-size: 23px;
    font-weight: 800;
    line-height: 1.38;
    color: #09090b;
    letter-spacing: -0.025em;
    margin: 0 0 10px;
  }
  .lead-quote-subtitle {
    font-size: 15px;
    font-weight: 500;
    color: #64748b;
    margin: 0;
  }

  /* Hide duplicate lede inside slot */
  .article-body-content > p.lede:first-child {
    display: none;
  }

  /* Metadata Row */
  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    font-size: 13.5px;
    font-weight: 600;
    color: #475569;
    margin: 22px 0 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid #f1f5f9;
  }
  .meta-item, .meta-item-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #334155;
    text-decoration: none;
  }
  .meta-item-tag {
    color: #0f172a;
    font-weight: 700;
  }
  .meta-item-tag:hover {
    color: #DC2626;
  }
  .meta-svg {
    stroke: #64748b;
  }

  /* About the Team Card */
  .about-team-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 22px 24px;
    margin-bottom: 36px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
  }
  .team-card-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
  }
  .team-avatar-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .team-info {
    flex: 1;
  }
  .team-card-title {
    font-size: 15.5px;
    font-weight: 800;
    color: #09090b;
    margin: 0 0 4px;
    border: none !important;
    padding: 0 !important;
  }
  .team-card-bio {
    font-size: 13.5px;
    line-height: 1.55;
    color: #475569;
    margin: 0;
  }

  /* Team Badges Row */
  .team-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
  }
  .team-badge-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: #334155;
  }
  .badge-icon {
    font-size: 14px;
  }

  /* ---------------- ARTICLE EDITORIAL CONTENT ---------------- */
  .article-body-content {
    font-size: 16px;
    line-height: 1.8;
    color: #27272a;
  }

  /* H2 Headings with Solid Black Left Accent Bar */
  .article-body-content h2 {
    font-size: 22px;
    font-weight: 800;
    color: #09090b;
    letter-spacing: -0.025em;
    border-left: 4px solid #000000;
    padding-left: 14px;
    margin: 44px 0 18px;
    line-height: 1.35;
  }

  .article-body-content h3 {
    font-size: 18px;
    font-weight: 800;
    color: #18181b;
    letter-spacing: -0.015em;
    margin: 32px 0 14px;
    line-height: 1.4;
  }

  .article-body-content h4 {
    font-size: 15.5px;
    font-weight: 700;
    color: #27272a;
    margin: 24px 0 10px;
  }

  .article-body-content p {
    margin-bottom: 20px;
  }

  .article-body-content a {
    color: #DC2626;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  .article-body-content a:hover {
