---
import Base from "../../layouts/Base.astro";
// Full, code-true API reference. Rendered by Scalar directly from the live
// OpenAPI spec at login.ollastack.com/api/openapi.json (CORS-open), so it never
// drifts from the code and every endpoint carries a copy-paste curl
// (x-codeSamples, auto-generated in apps/web/src/lib/openapi-spec.ts).
---

<Base
  current="docs"
  title="API reference — Ollastack"
  docsName="API reference"
  docsSlug="api"
  description="Every Ollastack API endpoint with a copy-paste curl example — forms, submissions, agent mail, SMS testing, rules, webhooks, uploads, orgs, billing and more. Rendered live from the OpenAPI 3.1 spec."
>
  <section style="max-width: 1180px; margin: 0 auto; padding: 56px 24px 8px;">
    <span class="ref-chip mono"><span class="dot"></span>api reference</span>
    <h1 class="ref-h1">Every endpoint, with curl.</h1>
    <p class="ref-lede">
      Rendered live from our OpenAPI 3.1 spec at
      <code>https://login.ollastack.com/api/openapi.json</code> — so it always matches the
      code. Every operation has a copy-paste <code>curl</code>. Authenticate with
      <code>Authorization: Bearer &lt;token&gt;</code> (mint one in <a href="https://login.ollastack.com/dashboard/api-keys">Dashboard → API keys</a>),
      or a session cookie for dashboard-only routes. Agents can fetch the raw spec
      from that same URL.
    </p>

    <!-- Fallback: the reference is rendered client-side by Scalar from a CDN.
         If JavaScript is off (or a bot/no-JS client), the interactive view can't
         load — show a direct link to the raw spec instead of a blank page. -->
    <noscript>
      <p class="ref-fallback">
        The interactive API reference needs JavaScript. View the raw OpenAPI 3.1 spec at
        <a href="https://login.ollastack.com/api/openapi.json">login.ollastack.com/api/openapi.json</a>.
      </p>
    </noscript>
  </section>

  <!-- Scalar renders the whole reference from the spec URL. `layout: modern`
       gives the responsive single-column-on-mobile layout. is:inline keeps
       Astro from bundling the CDN script. -->
  <script
    id="api-reference"
    is:inline
    data-url="https://login.ollastack.com/api/openapi.json"
    data-configuration='{"layout":"modern"}'
  ></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
</Base>

<style>
  .ref-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 11px; color: var(--muted); margin-bottom: 16px; }
  .ref-chip .dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
  .ref-h1 { font-size: 40px; margin: 0 0 12px; letter-spacing: -0.02em; line-height: 1.05; }
  .ref-lede { font-size: 17px; color: var(--muted); line-height: 1.6; max-width: 760px; }
  .ref-lede code { background: var(--bg-sunken); border: 1px solid var(--line); padding: 0 5px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.88em; }
  .ref-fallback { margin-top: 16px; font-size: 15px; color: var(--muted); }
  /* Keep the Scalar reference from overflowing the viewport on small screens. */
  :global(.scalar-app), :global(.scalar-api-reference) { max-width: 100%; }
  @media (max-width: 720px) {
    section { padding: 32px 16px 8px !important; }
    .ref-h1 { font-size: 30px; }
    .ref-lede { font-size: 15px; }
  }
</style>
