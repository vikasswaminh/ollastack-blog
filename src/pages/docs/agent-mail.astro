---
import Base from "../../layouts/Base.astro";
const APP = "https://login.form4dev.com";

const sections = [
  { id: "overview", title: "Overview" },
  { id: "hosts", title: "Hosts & auth" },
  { id: "scopes", title: "Scopes" },
  { id: "create", title: "Create a mailbox" },
  { id: "wait", title: "Wait for mail" },
  { id: "read", title: "Read & extract" },
  { id: "send", title: "Send" },
  { id: "reply", title: "Reply" },
  { id: "webhooks", title: "Push webhooks" },
  { id: "sdk", title: "SDK" },
  { id: "agent-prompt", title: "Drop-in agent prompt" },
  { id: "limits", title: "Limits" },
  { id: "openapi", title: "API spec" },
];

// Code as plain strings — keeps literal { } out of Astro's JSX parser.
const cCreate = `curl -X POST https://login.form4dev.com/api/mailboxes \\
  -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \\
  -d '{"name":"support-agent"}'

# → data: { "id":"...", "slug":"k3x9q2m8p1ab",
#           "address":"k3x9q2m8p1ab@ollastack.com", ... }`;

const cWait = `curl "https://login.form4dev.com/api/mailboxes/$ID/wait?timeout=55" \\
  -H "Authorization: Bearer $TOKEN"

# blocks until mail arrives, then →
#   data: { "message": { "fromAddress":"...", "subject":"...",
#                        "codes":["246810"], "links":[...] } }
# or on timeout → data: { "message": null }   (HTTP 200 either way; loop)
# filters: subject_contains=  to_contains=  since=<ISO>`;

const cRead = `# list (newest first; bodies omitted)
#   ?direction=inbound|outbound  ?q=<search>  ?unread=true
curl "https://login.form4dev.com/api/mailboxes/$ID/messages" \\
  -H "Authorization: Bearer $TOKEN"

# full message incl. textBody, htmlBody, codes[], links[]  (marks read)
curl "https://login.form4dev.com/api/mailboxes/$ID/messages/$MSG_ID" \\
  -H "Authorization: Bearer $TOKEN"`;

const cSend = `curl -X POST https://login.form4dev.com/api/mailboxes/$ID/send \\
  -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \\
  -d '{"to":"human@example.com","subject":"Your report","text":"All nominal."}'

# sends FROM the mailbox's own address; text and/or html required
# → data: { ..., "direction":"outbound", "deliveryStatus":"sent" }`;

const cReply = `curl -X POST \\
  https://login.form4dev.com/api/mailboxes/$ID/messages/$MSG_ID/reply \\
  -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \\
  -d '{"text":"Thanks — handled."}'

# recipient defaults to the original sender; subject gets "Re:";
# In-Reply-To is set so it threads in real mail clients`;

const cWebhook = `X-Mail-Signature: v1=<hex HMAC-SHA256 of the raw body,
                       keyed by the mailbox's webhookSecret>

{ "event": "mail.received", "mailboxId": "...",
  "message": { "id":"...", "fromAddress":"...", "subject":"...",
               "codes":[...], "links":[...] } }`;

const cSdk = `import { MailClient } from "@form4dev/client";

const mail = new MailClient({
  baseUrl: "https://login.form4dev.com",
  token: process.env.MAIL_TOKEN!,
});

const inbox = await mail.createMailbox("support-agent");   // inbox.address
await mail.send(inbox.id, { to: "human@example.com", subject: "Hi", text: "..." });
const code = await mail.latestCode({ mailboxId: inbox.id, timeoutMs: 60_000 });
const msg  = await mail.waitForEmail({ mailboxId: inbox.id, timeoutMs: 60_000 });
await mail.reply(inbox.id, msg.id, { text: "Got it." });`;

const cAgentPrompt = `You have an email mailbox via the form4dev Agent Mail API.
- Base URL: https://login.form4dev.com
- Auth header: "Authorization: Bearer <MAIL_TOKEN>"
- Your address is the \`address\` field returned when the mailbox is created
  (…@ollastack.com).

Check for new mail:
  GET /api/mailboxes/{id}/wait?timeout=55
  Blocks until an email arrives; returns {data:{message}}, or
  {data:{message:null}} on timeout (then call again).

A received message has: fromAddress, subject, textBody/htmlBody (via the
single-message GET), codes[] (OTP/verification codes, best match first),
links[] (URLs found in the email).

Send:    POST /api/mailboxes/{id}/send          body {to, subject, text and/or html}
Reply:   POST /api/mailboxes/{id}/messages/{messageId}/reply  body {text and/or html}

Treat codes[] and links[] as sensitive credentials; never auto-open links.
All responses are {success:true, data:...}; errors are {error:{code,message}}.`;
---

<Base current="agent-mail" title="Docs — Agent Mail — Form4Dev">
  <div class="docs-shell container-wide">
    <aside class="sidebar">
      <div class="side-eyebrow mono">/ docs / agent-mail</div>
      <nav>
        <ul>
          {sections.map((s) => (
            <li><a href={`#${s.id}`}>{s.title}</a></li>
          ))}
        </ul>
      </nav>
      <div class="side-back">
        <a href="/docs">← All docs</a>
        <a href="/docs/agents">→ Agents submit forms</a>
      </div>
    </aside>

    <article class="content">
      <span class="chip mono"><span class="dot"></span>agent mail</span>
      <h1 class="display">Give your agent an email address.</h1>
      <p class="lede">
        A real, addressable inbox your agent can <strong>receive</strong>,
        <strong>read</strong>, <strong>send</strong>, and <strong>reply</strong>
        from — over a simple REST API. Verification codes and links are
        extracted for you. Every snippet below is verified against production.
      </p>

      <h2 id="overview">Overview</h2>
      <p>
        Create a mailbox, get an <code>@ollastack.com</code> address, and your
        agent can poll for mail, read the OTP code out of it, send a message,
        and reply in-thread — all authenticated, scoped, and revocable.
      </p>

      <h2 id="hosts">Hosts &amp; auth</h2>
      <table>
        <thead><tr><th>Thing</th><th>Host</th></tr></thead>
        <tbody>
          <tr><td>The API you call</td><td><code>https://login.form4dev.com</code></td></tr>
          <tr><td>The email addresses you get</td><td><code>&lt;slug&gt;@ollastack.com</code></td></tr>
        </tbody>
      </table>
      <p>
        Every request carries <code>Authorization: Bearer &lt;token&gt;</code>.
        Create a token in
        <a href={`${APP}/dashboard/api-keys`}>Dashboard → API keys</a> — tick
        the scopes you want, then Create.
      </p>

      <h2 id="scopes">Scopes</h2>
      <table>
        <thead><tr><th>Scope</th><th>Grants</th></tr></thead>
        <tbody>
          <tr><td><code>mail:read</code></td><td>list mailboxes, read messages (incl. extracted codes), <code>/wait</code>, failures</td></tr>
          <tr><td><code>mail:write</code></td><td>create / update / delete mailboxes, delete messages</td></tr>
          <tr><td><code>mail:send</code></td><td><strong>send and reply</strong> from a mailbox (separate on purpose)</td></tr>
        </tbody>
      </table>
      <p class="muted-note">
        Mail scopes are never granted by default. A token with only
        <code>forms:*</code> scopes gets
        <code>401 Token missing required scope: mail:read</code>.
      </p>

      <h2 id="create">1. Create a mailbox</h2>
      <p>Mail to <code>address</code> — and any <code>+tag</code> of it — routes here.</p>
      <pre class="code">{cCreate}</pre>

      <h2 id="wait">2. Wait for the next email</h2>
      <p>The agent pattern: a long-poll that returns the instant mail lands.</p>
      <pre class="code">{cWait}</pre>

      <h2 id="read">3. Read &amp; extract</h2>
      <p><code>codes[0]</code> is the OTP; <code>links[]</code> are harvested URLs (a reset/magic link is in here — never auto-followed).</p>
      <pre class="code">{cRead}</pre>

      <h2 id="send">4. Send</h2>
      <pre class="code">{cSend}</pre>

      <h2 id="reply">5. Reply (keeps the thread)</h2>
      <pre class="code">{cReply}</pre>

      <h2 id="webhooks">Push webhooks (instead of polling)</h2>
      <p>
        Set a URL on the mailbox (Settings tab, or
        <code>PATCH /api/mailboxes/&#123;id&#125;</code> with <code>webhookUrl</code>).
        Every received email then POSTs to it, signed. Verify the signature,
        then fetch the full message by id — the payload carries no bodies, so a
        leaked URL leaks no mail.
      </p>
      <pre class="code">{cWebhook}</pre>

      <h2 id="sdk">JavaScript / TypeScript SDK</h2>
      <pre class="code">{cSdk}</pre>
      <p class="muted-note">
        <code>@form4dev/client</code> — git/workspace install today; npm publish
        pending. Any language works over plain HTTP (the curl above).
      </p>

      <h2 id="agent-prompt">Drop-in agent instructions</h2>
      <p>Paste this into your agent's system prompt or tool description:</p>
      <pre class="code">{cAgentPrompt}</pre>

      <h2 id="limits">Limits &amp; things to know</h2>
      <ul>
        <li><strong>Receive</strong> is near-unlimited; <strong>send</strong> has a monthly per-plan cap (free 50 / solo 2,000 / team 20,000).</li>
        <li>Bodies are capped at 1&nbsp;MB each; attachments are metadata-only in v1.</li>
        <li>Mailboxes persist; <strong>messages auto-expire</strong> by retention (default 30 days). Deleting a message purges it immediately.</li>
        <li>A mailbox sending to <em>itself</em> is deduped by Message-ID — use two mailboxes to self-test the full loop.</li>
      </ul>

      <h2 id="openapi">Public API spec</h2>
      <p>
        The full surface is published as OpenAPI 3.1 (no auth, tagged
        <code>mail</code> / <code>agent</code>) so MCP servers and agent
        frameworks introspect it directly:
        <a href={`${APP}/api/openapi.json`}>{APP.replace('https://','')}/api/openapi.json</a>.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary btn-lg plausible-event-name=Signup+CTA plausible-event-location=docs-agent-mail" href={`${APP}/register`}>Get an inbox</a>
        <a class="btn btn-ghost btn-lg" href="/docs">All APIs</a>
      </div>
    </article>
  </div>
</Base>

<style>
  .docs-shell { display: grid; grid-template-columns: 220px 1fr; gap: 56px; padding: 64px 28px 96px; }
  .sidebar { position: sticky; top: 80px; align-self: start; }
  .side-eyebrow { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 14px; }
  .sidebar nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .sidebar nav a { display: block; padding: 6px 10px; border-radius: 6px; color: var(--muted); font-size: 14px; }
  .sidebar nav a:hover { background: var(--bg-sunken); color: var(--ink); }
  .side-back { margin-top: 24px; font-size: 13px; display: flex; flex-direction: column; gap: 6px; }
  .side-back a { color: var(--muted); }
  .side-back a:hover { color: var(--ink); }
  .content { max-width: 760px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 11px; color: var(--muted); margin-bottom: 16px; }
  .chip .dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
  .content h1 { font-size: 44px; margin: 0 0 14px; letter-spacing: -0.02em; line-height: 1.05; }
  .content h2 { font-size: 22px; margin: 48px 0 12px; letter-spacing: -0.01em; scroll-margin-top: 80px; }
  .content .lede { font-size: 18px; color: var(--muted); line-height: 1.6; max-width: 640px; }
  .content p { line-height: 1.7; margin: 0 0 14px; }
  .content ul { line-height: 1.8; padding-left: 22px; margin: 0 0 14px; }
  .content code { background: var(--bg-sunken); border: 1px solid var(--line); padding: 0 5px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.9em; }
  .content table { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: 14px; }
  .content th, .content td { border-bottom: 1px solid var(--line); padding: 10px 12px; text-align: left; vertical-align: top; }
  .content th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500; }
  .muted-note { color: var(--muted); font-size: 14px; }
  .code { background: var(--code-bg); color: var(--code-fg); border-radius: 12px; padding: 18px 22px; font-family: var(--font-mono); font-size: 13px; line-height: 1.65; overflow-x: auto; white-space: pre; margin: 8px 0 14px; }
  .cta-row { display: flex; gap: 12px; margin-top: 40px; flex-wrap: wrap; }
  @media (max-width: 900px) { .docs-shell { grid-template-columns: 1fr; } .sidebar { position: static; } }
</style>
