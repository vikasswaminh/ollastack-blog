---
import Base from "../layouts/Base.astro";

const APP = "https://login.form4dev.com";

const channels = [
  {
    label: "Sales & general enquiries",
    value: "hello@form4dev.com",
    href: "mailto:hello@form4dev.com",
    note: "Pricing, plans, partnerships, anything pre-sale.",
  },
  {
    label: "Product support",
    value: "support@form4dev.com",
    href: "mailto:support@form4dev.com",
    note: "Account, billing, or a form that isn't behaving.",
  },
];
---

<Base
  current="contact"
  title="Contact — Form4Dev"
  description="Talk to the Form4Dev team. Email, phone, and our Bengaluru office — sales, support, and partnership enquiries."
>
  <section class="head">
    <div class="container-wide">
      <span class="eyebrow mono">/ contact</span>
      <h1 class="display title">Talk to a human.</h1>
      <p class="sub">
        Questions about plans, a tricky integration, or a partnership idea —
        reach us on whichever channel suits you. We read everything.
      </p>
    </div>
  </section>

  <section class="body">
    <div class="container-wide grid">
      <!-- Left: written channels -->
      <div class="col">
        <h2 class="col-title">By email</h2>
        <ul class="channels">
          {channels.map((c) => (
            <li class="channel card">
              <div class="channel-label mono">{c.label}</div>
              <a class="channel-value" href={c.href}>{c.value}</a>
              <p class="channel-note">{c.note}</p>
            </li>
          ))}
        </ul>

        <div class="cta-row">
          <a
            class="btn btn-primary btn-lg plausible-event-name=Signup+CTA plausible-event-location=contact plausible-event-plan=free"
            href={`${APP}/register`}
          >
            Start free — no call needed
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: direct lines + office -->
      <aside class="col">
        <h2 class="col-title">Direct lines</h2>

        <div class="card info-card">
          <div class="info-row">
            <span class="info-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11 11 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </span>
            <div>
              <div class="info-label mono">Phone</div>
              <a class="info-value" href="tel:+919611027980">+91-9611027980</a>
            </div>
          </div>

          <div class="info-row">
            <span class="info-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <div class="info-label mono">Hours</div>
              <div class="info-value">Mon–Sat, 10:00 AM – 6:00 PM IST</div>
            </div>
          </div>

          <div class="info-row">
            <span class="info-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 21s-7-5.686-7-11a7 7 0 1114 0c0 5.314-7 11-7 11z"/>
                <circle cx="12" cy="10" r="2.5"/>
              </svg>
            </span>
            <div>
              <div class="info-label mono">Campus</div>
              <address class="info-value">
                L-149, Sector 6, HSR Layout,<br/>
                Bengaluru 560102, India
              </address>
            </div>
          </div>
        </div>

        <p class="response-note">
          Email is the fastest way to reach us — we typically reply within
          one business day.
        </p>
      </aside>
    </div>
  </section>

  <section class="hiring-banner">
    <div class="container-wide hiring-inner">
      <div>
        <h2 class="hiring-title">We&rsquo;re hiring in Bengaluru.</h2>
        <p class="hiring-sub">
          Sales, network support, and HR roles — full-time, on-site at our
          HSR Layout campus.
        </p>
      </div>
      <a class="btn btn-ghost btn-lg" href="/careers">See open roles →</a>
    </div>
  </section>
</Base>

<style>
  .head { padding: 80px 0 36px; }
  .title { font-size: 56px; margin: 18px 0 12px; letter-spacing: -0.03em; line-height: 1; }
  .sub { font-size: 18px; color: var(--muted); max-width: 600px; margin: 0; }
  .eyebrow {
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .body { padding: 24px 0 72px; }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .col-title {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 16px;
    font-weight: 600;
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .channel { padding: 20px 22px; }
  .channel-label {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-2);
    margin-bottom: 6px;
  }
  .channel-value {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--brand-red);
    padding-bottom: 1px;
  }
  .channel-value:hover { color: var(--brand-red); }
  .channel-note {
    font-size: 14px;
    color: var(--muted);
    margin: 8px 0 0;
  }

  .cta-row { margin-top: 24px; }

  .info-card { padding: 8px 22px; }
  .info-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .info-row:last-child { border-bottom: none; }
  .info-icon {
    color: var(--brand-red);
    flex-shrink: 0;
    margin-top: 1px;
  }
  .info-label {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-2);
    margin-bottom: 3px;
  }
  .info-value {
    font-size: 15px;
    color: var(--ink);
    font-style: normal;
    line-height: 1.5;
  }
  a.info-value:hover { color: var(--brand-red); }
  .response-note {
    font-size: 13.5px;
    color: var(--muted);
    margin: 16px 2px 0;
  }

  .hiring-banner {
    border-top: 1px solid var(--line);
    background: var(--bg-elev);
  }
  .hiring-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 40px 0;
  }
  .hiring-title {
    font-size: 24px;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .hiring-sub { font-size: 15px; color: var(--muted); margin: 0; max-width: 460px; }

  @media (max-width: 820px) {
    .title { font-size: 40px; }
    .grid { grid-template-columns: 1fr; gap: 36px; }
    .hiring-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
