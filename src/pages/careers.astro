---
import Base from "../layouts/Base.astro";

const APPLY_EMAIL = "careers@form4dev.com";

const roles = [
  {
    title: "Sales Executive",
    openings: 10,
    team: "Sales",
    blurb:
      "Own the full cycle for inbound and outbound prospects — qualify, demo, and close developers and small teams onto paid plans. You'll talk to people who already understand the product; your job is to match them to the right plan and remove friction.",
    youll: [
      "Run discovery calls and product demos for inbound leads.",
      "Build and work an outbound pipeline of dev-tool buyers.",
      "Hit a monthly closed-revenue target with a clear commission structure.",
      "Feed real objections and pricing signals back to the product team.",
    ],
    looking: [
      "1–3 years in B2B or SaaS sales (freshers with strong communication considered).",
      "Comfortable explaining a technical product in plain language.",
      "Fluent English; Hindi or Kannada a plus for the local market.",
    ],
  },
  {
    title: "Network Support Engineer",
    openings: 20,
    team: "Support",
    blurb:
      "Be the technical front line for customers running Form4Dev in production. You'll diagnose integration issues, webhook failures, deliverability questions, and connectivity problems — and turn each ticket into a clear, correct answer.",
    youll: [
      "Resolve customer tickets on integration, webhooks, DNS, and email deliverability.",
      "Reproduce reported issues and escalate genuine bugs with clean repro steps.",
      "Write and improve help-centre articles from the questions you answer.",
      "Work shift coverage so support is responsive across business hours.",
    ],
    looking: [
      "Solid grounding in networking fundamentals — HTTP, DNS, TLS, webhooks.",
      "Diploma or degree in IT/CS, or equivalent hands-on experience.",
      "Calm, precise written communication — most support is in writing.",
      "Freshers welcome; we train on the product.",
    ],
  },
  {
    title: "HR Executive",
    openings: 3,
    team: "People",
    blurb:
      "Help us hire and keep great people as the team scales. You'll run recruitment end-to-end for the sales and support roles above, and own onboarding, records, and day-to-day people operations from the HSR Layout campus.",
    youll: [
      "Source, screen, and coordinate interviews across active roles.",
      "Run smooth onboarding for new joiners and keep people records accurate.",
      "Support payroll inputs, attendance, and basic compliance.",
      "Help shape a healthy, on-site team culture as we grow.",
    ],
    looking: [
      "1–3 years in HR or recruitment, ideally in a fast-growing company.",
      "Strong organisation and follow-through — you close loops.",
      "Degree in HR, business, or a related field.",
    ],
  },
];

const totalOpenings = roles.reduce((s, r) => s + r.openings, 0);

const facts = [
  { label: "Location", value: "HSR Layout, Bengaluru" },
  { label: "Type", value: "Full-time, on-site" },
  { label: "Remote", value: "No — in-office only" },
  { label: "Open roles", value: `${totalOpenings} positions` },
];
---

<Base
  current="careers"
  title="Careers — Form4Dev"
  description="Form4Dev is hiring in Bengaluru — Sales Executives, Network Support Engineers, and HR Executives. Full-time, on-site at our HSR Layout campus."
>
  <section class="head">
    <div class="container-wide">
      <span class="eyebrow mono">/ careers</span>
      <h1 class="display title">Build the team, in Bengaluru.</h1>
      <p class="sub">
        We&rsquo;re growing the people who sell, support, and run Form4Dev.
        Every role here is full-time and on-site at our HSR Layout campus —
        we work together, in one room.
      </p>
    </div>
  </section>

  <section class="facts-strip">
    <div class="container-wide facts-grid">
      {facts.map((f) => (
        <div class="fact">
          <div class="fact-label mono">{f.label}</div>
          <div class="fact-value">{f.value}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="roles">
    <div class="container-wide">
      <span class="eyebrow mono">/ open roles</span>
      <h2 class="display section-title">{totalOpenings} positions open</h2>

      <div class="role-list">
        {roles.map((r) => {
          const slug = r.title.toLowerCase().replace(/[^a-z]+/g, "-");
          const subject = encodeURIComponent(`Application: ${r.title}`);
          return (
            <article class="role card" id={slug}>
              <div class="role-head">
                <div>
                  <span class="role-team mono">{r.team}</span>
                  <h3 class="role-title">{r.title}</h3>
                </div>
                <span class="role-count">
                  <strong>{r.openings}</strong>
                  <span class="role-count-label">openings</span>
                </span>
              </div>

              <p class="role-blurb">{r.blurb}</p>

              <div class="role-cols">
                <div>
                  <h4 class="role-subhead">What you&rsquo;ll do</h4>
                  <ul class="role-ul">
                    {r.youll.map((i) => (
                      <li>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                        <span>{i}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="role-subhead">What we&rsquo;re looking for</h4>
                  <ul class="role-ul">
                    {r.looking.map((i) => (
                      <li>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                        <span>{i}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="role-meta">
                <span class="role-tag">Bengaluru</span>
                <span class="role-tag">Full-time</span>
                <span class="role-tag">On-site</span>
              </div>

              <a class="btn btn-primary apply-btn" href={`mailto:${APPLY_EMAIL}?subject=${subject}`}>
                Apply for {r.title}
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="how">
    <div class="container how-inner">
      <span class="eyebrow mono">/ how to apply</span>
      <h2 class="display section-title">A short, honest process</h2>
      <ol class="how-steps">
        <li>
          <span class="how-num mono">1</span>
          <div>
            <strong>Send your CV.</strong> Email it to
            <a href={`mailto:${APPLY_EMAIL}`}>{APPLY_EMAIL}</a> with the role
            in the subject line. A few lines on why you&rsquo;re a fit help.
          </div>
        </li>
        <li>
          <span class="how-num mono">2</span>
          <div>
            <strong>A conversation.</strong> A call or in-person chat with the
            hiring team — about your experience and the role, both ways.
          </div>
        </li>
        <li>
          <span class="how-num mono">3</span>
          <div>
            <strong>A practical round.</strong> Role-relevant — a mock demo
            for sales, a troubleshooting scenario for support, a
            people-ops case for HR.
          </div>
        </li>
        <li>
          <span class="how-num mono">4</span>
          <div>
            <strong>Offer.</strong> If it&rsquo;s a match on both sides, we
            move quickly.
          </div>
        </li>
      </ol>
      <p class="how-note">
        Don&rsquo;t see your exact role but think you belong here? Email us
        anyway at <a href={`mailto:${APPLY_EMAIL}`}>{APPLY_EMAIL}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .head { padding: 80px 0 32px; }
  .title { font-size: 56px; margin: 18px 0 12px; letter-spacing: -0.03em; line-height: 1.02; }
  .sub { font-size: 18px; color: var(--muted); max-width: 620px; margin: 0; }
  .eyebrow {
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .section-title { font-size: 32px; margin: 14px 0 0; letter-spacing: -0.02em; }

  /* Facts strip */
  .facts-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-elev);
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
  }
  .fact { padding: 22px 4px; }
  .fact-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted-2);
    margin-bottom: 5px;
  }
  .fact-value { font-size: 15.5px; font-weight: 600; color: var(--ink); }

  /* Roles */
  .roles { padding: 56px 0 24px; }
  .role-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 28px;
  }
  .role { padding: 28px 30px; scroll-margin-top: 80px; }
  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }
  .role-team {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--brand-red);
    font-weight: 600;
  }
  .role-title { font-size: 22px; margin: 5px 0 0; letter-spacing: -0.01em; }
  .role-count {
    text-align: center;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: 8px 14px;
    background: var(--bg);
  }
  .role-count strong { display: block; font-size: 22px; line-height: 1; color: var(--brand-red); }
  .role-count-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-2);
  }
  .role-blurb {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.65;
    margin: 16px 0 20px;
    max-width: 720px;
  }
  .role-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .role-subhead {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 10px;
    font-weight: 600;
  }
  .role-ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .role-ul li {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--ink);
    line-height: 1.5;
  }
  .role-ul svg { color: var(--brand-red); flex-shrink: 0; margin-top: 3px; }
  .role-meta {
    display: flex;
    gap: 8px;
    margin: 22px 0 18px;
    flex-wrap: wrap;
  }
  .role-tag {
    font-size: 11.5px;
    color: var(--muted);
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .apply-btn { display: inline-flex; }

  /* How to apply */
  .how {
    padding: 56px 0 88px;
    border-top: 1px solid var(--line);
    margin-top: 40px;
  }
  .how-inner { max-width: 680px; }
  .how-steps {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .how-steps li { display: flex; gap: 16px; align-items: flex-start; }
  .how-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--brand-red);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 600;
  }
  .how-steps li div { font-size: 15px; color: var(--muted); line-height: 1.6; padding-top: 3px; }
  .how-steps strong { color: var(--ink); }
  .how-note {
    font-size: 14px;
    color: var(--muted);
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 820px) {
    .title { font-size: 38px; }
    .facts-grid { grid-template-columns: repeat(2, 1fr); }
    .role-cols { grid-template-columns: 1fr; gap: 20px; }
    .role { padding: 24px 22px; }
  }
</style>
