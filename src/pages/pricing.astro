---
import Base from "../layouts/Base.astro";
const APP = "https://login.ollastack.com";

const tiers = [
  {
    name: "Free",
    price: "$0",
    period: "/ month",
    blurb: "For trying it out and side projects.",
    submissions: "100",
    cta: "Start free",
    href: `${APP}/register`,
    emphasis: false,
    planKey: "free",
  },
  {
    name: "Solo",
    price: "$9",
    period: "/ month",
    blurb: "For developers shipping their first agent-backed form.",
    submissions: "1,000",
    cta: "Get Solo",
    href: `${APP}/upgrade?plan=solo`,
    emphasis: true,
    planKey: "solo",
  },
  {
    name: "Team",
    price: "$29",
    period: "/ month",
    blurb: "For teams running multiple agent integrations at volume.",
    submissions: "10,000",
    cta: "Get Team",
    href: `${APP}/upgrade?plan=team`,
    emphasis: false,
    planKey: "team",
  },
];

// Core features on every tier (incl. Free). Paid-only extras are listed
// separately below — see `paidOnly`. Shown once below the price grid.
const allFeatures = [
  "Unlimited forms",
  "Spam filtering — honeypot, per-IP rate limit, CAPTCHA (Turnstile / hCaptcha / reCAPTCHA)",
  "Email notifications — our SMTP, or bring your own SMTP server (BYO SMTP)",
  "Webhooks — HMAC-signed, auto-retried, one-click replay, full delivery history + agent-published events",
  "Multi-step forms + conditional show-if logic",
  "Per-form autoresponder + magic fields",
  "Per-form analytics — geo, spam rate, submissions over time",
  "Ollastack-hosted form page with custom CSS",
  "Submission tags, archive, status workflow",
  "Inbox export — CSV, JSON, Excel — by date range",
  "Slack, Discord, Telegram, Google Sheets, Mailchimp integrations — native, no Zapier",
  "Never lose a lead — every blocked submission is logged, and mis-flagged leads recover in one click",
  "Workflow rules — auto-tag, set status, notify by email/Slack, fire webhooks on a match",
  "Agent mailboxes — send, receive, and reply from a real email identity",
  "Disposable test inboxes — assert on OTP codes + links in CI",
  "Mailbox rules — auto-reply, AI-enrich, or mark read on inbound mail",
  "AI enrichment — category, sentiment, summary + suggested reply on leads and mail",
  "Projects — group forms + mailboxes per workspace",
  "Team roles — owner, admin, member, and read-only viewer",
  "File uploads — presigned, stored on object storage, auto-linked to submissions",
  "AI-agent Bearer tokens with audit log + 🤖 inbox stamp",
  "Custom SMTP — encrypted at rest, transparent fallback",
  "Org members + cross-form inbox",
  "Personal API tokens — every call recorded, 300/min per-token rate limit",
  "Account activity log — every action across forms, mailboxes, and team, auditable",
  "Deliverability self-test — send a test email and inspect every send in the email log",
  "Clone a form + rotate its public endpoint URL",
  "Public OpenAPI 3.1 spec at /api/openapi.json",
];

// Paid-plan only — the few things Free does NOT get. Sending from your own
// verified domain mutates the shared email account / mailbox routing, so it's
// gated to paid plans (Solo / Team). Keep this honest — Free really can't.
const paidOnly = [
  "Send from your own verified domain (custom sender domain)",
  "Bring your own agent-mailbox domain (custom mailbox domain)",
];

const faqs = [
  {
    q: "What counts as a submission?",
    a: "Any successful POST to your form endpoint. Spam-flagged submissions count toward the quota only after they pass through filters; honeypot-rejected ones don't. Per-IP rate-limit rejections don't count either.",
  },
  {
    q: "What happens when I hit my monthly quota?",
    a: "The submit endpoint returns 429 with code RATE_LIMIT_EXCEEDED. Existing submissions stay accessible. You can upgrade mid-period and the new quota applies immediately. We don't auto-bill overages.",
  },
  {
    q: "Do you store the form payload?",
    a: "Yes — until you delete it or until your form's retention policy expires. Retention is configurable per-form on every paid tier.",
  },
  {
    q: "Can AI agents submit to my forms?",
    a: "Yes. Authorize an agent in Dashboard → Settings → API tokens, give it a label, and your agent can submit cleanly while bots stay blocked. Submissions are tagged in the inbox with the agent's label, and your per-form and monthly limits still apply. See /docs/agents.",
  },
  {
    q: "Can I bring my own SMTP?",
    a: "Yes, on every paid tier (and Free too). Configure your SMTP server per organization; credentials are encrypted at rest. If your SMTP server fails, we transparently fall back to the platform sender so notifications never silently drop. See /docs/smtp.",
  },
  {
    q: "Is the API stable? Can I script against it?",
    a: "Yes. The full OpenAPI 3.1 spec is published at /api/openapi.json — agent frameworks can consume it directly. Every endpoint documents its error shape and required scopes.",
  },
  {
    q: "Where do my submissions live?",
    a: "On a hosted database under our control. We're transparent about not yet offering multi-region or guaranteed data residency — talk to us if that's a blocker.",
  },
  {
    q: "How do refunds work?",
    a: "Cancel any time from the billing page; the next billing cycle is skipped and your org drops back to the free tier's quota. No prorated refunds on the current cycle.",
  },
  {
    q: "What payment methods do you accept?",
    a: "Subscriptions are billed through DODO Payments (cards). Stripe and PayPal are on the roadmap; if either is a hard requirement, email us.",
  },
];
---

<Base current="pricing" title="Pricing — Ollastack">
  <section class="head">
    <div class="container-wide">
      <span class="eyebrow mono">/ pricing</span>
      <h1 class="display title">Honest pricing. USD.</h1>
      <p class="sub">
        Pay for the volume you actually receive — no per-seat tax, no support tax,
        no overage surprises.
      </p>
    </div>
  </section>

  <section class="tiers">
    <div class="container-wide tier-grid">
      {tiers.map((t) => (
        <article class={`tier card ${t.emphasis ? "emph" : ""}`}>
          {t.emphasis && <span class="badge">Most popular</span>}
          <h3 class="tier-name">{t.name}</h3>
          <div class="tier-price">
            <strong>{t.price}</strong>
            <span class="period mono">{t.period}</span>
          </div>
          <p class="tier-blurb">{t.blurb}</p>
          <a
            href={t.href}
            class={`btn btn-lg ${t.emphasis ? "btn-primary" : "btn-ghost"}`}
          >{t.cta}</a>
          <hr class="hr" />
          <ul class="tier-headline">
            <li class="tier-quota">
              <strong>{t.submissions}</strong> submissions / month
            </li>
            <li>Unlimited forms</li>
            <li>All core features (listed below)</li>
          </ul>
        </article>
      ))}
    </div>

    <div class="all-features">
      <h2 class="all-features-title">Every tier includes the same core features.</h2>
      <p class="all-features-sub">
        Almost nothing is gated by plan — the monthly submission cap is the main
        difference. The only paid-plan extras are listed at the bottom.
      </p>
      <ul class="all-features-list">
        {allFeatures.map((f) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12l5 5L20 7"/></svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <p class="paid-only-label">Paid plans (Solo / Team) also add:</p>
      <ul class="all-features-list paid-only-list">
        {paidOnly.map((f) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 2v20M2 12h20"/></svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="enterprise-note">
      Need more than 10,000 submissions / month or a custom arrangement?
      <a href="mailto:hello@ollastack.com">Talk to us</a>.
    </p>
  </section>

  <section class="faq">
    <div class="container">
      <span class="eyebrow mono">/ faq</span>
      <h2 class="display section-title">Frequently asked questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding: 80px 0 40px; }
  .title { font-size: 56px; margin: 18px 0 12px; letter-spacing: -0.03em; line-height: 1; }
  .sub { font-size: 18px; color: var(--muted); max-width: 580px; margin: 0; }
  .eyebrow {
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tiers { padding: 24px 0 24px; }
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .tier {
    padding: 28px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .tier.emph {
    border-color: var(--ink);
    box-shadow: 0 24px 48px -16px rgba(10, 10, 10, 0.18);
  }
  .badge {
    position: absolute;
    top: -10px;
    left: 28px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 999px;
    font-weight: 500;
  }
  .tier-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }
  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 12px;
  }
  .tier-price strong {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .tier-price .period { color: var(--muted); font-size: 13px; }
  .tier-blurb { color: var(--muted); font-size: 14px; min-height: 42px; margin: 0 0 20px; }
  .tier .hr { margin: 24px 0 18px; }
  .tier ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tier li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .tier li svg {
    color: var(--accent);
    margin-top: 4px;
    flex-shrink: 0;
  }

  .tier-headline .tier-quota strong { color: var(--ink); font-weight: 600; font-size: 15px; }

  .all-features {
    margin: 56px auto 32px;
    max-width: 800px;
    padding: 36px 32px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--r-4);
  }
  .all-features-title {
    font-size: 22px;
    letter-spacing: -0.015em;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .all-features-sub {
    color: var(--muted);
    font-size: 14.5px;
    margin: 0 0 24px;
    line-height: 1.6;
  }
  .all-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
  }
  .all-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .all-features-list li svg {
    color: var(--accent);
    margin-top: 4px;
    flex-shrink: 0;
  }
  .paid-only-label {
    margin: 28px 0 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .paid-only-list li svg { color: var(--muted); }

  .enterprise-note {
    text-align: center;
    margin: 32px 0 80px;
    font-size: 14px;
    color: var(--muted);
  }
  .enterprise-note a { color: var(--accent); }

  .faq { padding: 56px 0 80px; }
  .section-title { font-size: 36px; margin: 14px 0 32px; letter-spacing: -0.02em; }
  .faq-list { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--line); }
  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq-item summary {
    font-weight: 500;
    font-size: 16px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-item summary::after {
    content: "+";
    color: var(--muted);
    font-size: 20px;
    font-weight: 400;
  }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item p { margin: 12px 0 0; color: var(--muted); font-size: 15px; line-height: 1.6; }

  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: 1fr; }
    .title { font-size: 40px; }
    .all-features-list { grid-template-columns: 1fr; }
  }
</style>
