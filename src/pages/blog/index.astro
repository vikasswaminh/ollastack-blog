---
import { getCollection } from "astro:content";
import { posts as legacyPosts } from "../../data/posts";
import Logo from "../../components/Logo.astro";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

function getPostCategory(slug: string, title = ""): { category: string; categorySlug: string; icon: string; theme: string } {
  const s = slug.toLowerCase();
  if (s.includes("ai-agent") || s.includes("agent") || s.includes("read-otp")) {
    return { category: "AI Agents", categorySlug: "ai-agents", icon: "🤖", theme: "cat-rose" };
  }
  if (s.includes("test") || s.includes("playwright") || s.includes("cypress") || s.includes("otp")) {
    return { category: "Email Testing", categorySlug: "email-testing", icon: "✉️", theme: "cat-blue" };
  }
  if (s.includes("-vs-") || s.includes("alternative")) {
    return { category: "Comparisons", categorySlug: "comparisons", icon: "⚖️", theme: "cat-purple" };
  }
  if (s.includes("migrate") || s.includes("migration")) {
    return { category: "Migrations", categorySlug: "migrations", icon: "🚀", theme: "cat-orange" };
  }
  if (s.includes("quickstart") || s.includes("webhooks") || s.includes("form-") || s.includes("react-") || s.includes("vue") || s.includes("svelte") || s.includes("remix")) {
    return { category: "Integrations", categorySlug: "integrations", icon: "🔌", theme: "cat-amber" };
  }
  if (s.includes("smtp") || s.includes("dkim") || s.includes("deliverability")) {
    return { category: "Deliverability", categorySlug: "deliverability", icon: "🛡️", theme: "cat-teal" };
  }
  if (s.includes("security") || s.includes("quarantine") || s.includes("honeypot") || s.includes("captcha")) {
    return { category: "Security", categorySlug: "security", icon: "🔒", theme: "cat-slate" };
  }
  if (s.includes("email-api") || s.includes("inbound")) {
    return { category: "Email API", categorySlug: "email-api", icon: "📬", theme: "cat-sky" };
  }
  return { category: "Forms", categorySlug: "forms", icon: "📋", theme: "cat-emerald" };
}

// Markdown collection posts
const rawCollection = await getCollection("blog", ({ data }) => data.draft !== true);
const collectionPosts = rawCollection
  .filter(
    (p) =>
      p.slug !== "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" &&
      p.slug !== "how-to-build-a-form-backend-for-a-static-site"
  )
  .map((p) => {
    const cat = getPostCategory(p.slug, p.data.title || "");
    return {
      slug: p.slug,
      title: p.data.title,
      description: p.data.description,
      date: p.data.date.toISOString().slice(0, 10),
      readingTime: `${p.data.readingTime} min read`,
      category: cat.category,
      categorySlug: cat.categorySlug,
      icon: cat.icon,
      theme: cat.theme,
      tags: p.data.tags || [],
    };
  });

const postMap = new Map();
collectionPosts.forEach((p) => postMap.set(p.slug, p));
legacyPosts.forEach((p) => {
  const cat = getPostCategory(p.slug, p.title || "");
  postMap.set(p.slug, {
    ...p,
    category: cat.category,
    categorySlug: cat.categorySlug,
    icon: cat.icon,
    theme: cat.theme,
  });
});

const allPosts = Array.from(postMap.values()).sort((a, b) =>
  b.date.localeCompare(a.date)
);

// PURE OLLASTACK: Left Column (FOUNDER SPECIAL)
const founderSpecialPosts = [
  { title: "Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing?", slug: "mailosaur-vs-mailinator-vs-disposable-inboxes" },
  { title: "How to Connect a Contact Form to Email Without Backend Code", slug: "how-to-connect-a-contact-form-to-email-without-backend-code" },
  { title: "Form Backend vs Form Builder: What Developers Should Choose in 2026", slug: "form-backend-for-ai-agents" },
  { title: "How to Automate OTP Email Testing in CI/CD Pipelines", slug: "how-to-automate-otp-email-testing-in-ci-cd-pipelines" },
  { title: "How to Build a Form Backend for a Static Site Without Writing a Server", slug: "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" },
  { title: "Self-Host vs Hosted Form Backend: Complete Decision Framework", slug: "self-host-vs-hosted-form-backend" },
  { title: "Per-Tenant SMTP: Send Notifications from Each Client's Domain", slug: "per-tenant-smtp-guide" },
  { title: "Form Webhooks Done Right: Cryptographic Signatures & Replay", slug: "form-webhooks-guide" },
  { title: "Zero Trust Inbound Endpoints: Securing Forms Against Automated Spam", slug: "secure-forms-honeypot-captcha" },
  { title: "ML Spam Quarantine: Why Your Form Backend Must Fail Open", slug: "ml-quarantine-explained" },
];

// PURE OLLASTACK: Lead Hero Featured Article (NEWEST ARTICLES SECTION)
const heroArticle = {
  category: "Comparisons / QA",
  title: "Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing in 2026",
  excerpt: "A real-world comparison of Mailosaur, Mailinator and disposable inbox tools for QA testing. Learn which one fits OTP testing, CI pipelines, Playwright, Cypress and automated email verification.",
  time: "22 min read",
  slug: "mailosaur-vs-mailinator-vs-disposable-inboxes",
  isNew: true
};

// PURE OLLASTACK: 3 Guide Cards below Hero
const guideCards = [
  {
    category: "AI Agents",
    title: "What Is an Agent Email API?",
    desc: "Why normal transactional email can't serve autonomous AI agents and how to wire programmatic agent inboxes.",
    time: "21 min read",
    slug: "what-is-an-agent-email-api",
    badgeClass: "badge-amber"
  },
  {
    category: "Email Testing",
    title: "Assert on Email in Playwright & Cypress",
    desc: "End-to-end testing of magic links, OTP codes, and welcome emails in CI/CD test suites with instant inboxes.",
    time: "15 min read",
    slug: "assert-on-email-in-playwright-cypress",
    badgeClass: "badge-orange"
  },
  {
    category: "Integrations",
    title: "Connect a Contact Form Without Backend Code",
    desc: "Complete 2026 guide covering endpoints, serverless options, spam protection, file uploads, and AI agent readiness.",
    time: "22 min read",
    slug: "how-to-connect-a-contact-form-to-email-without-backend-code",
    badgeClass: "badge-yellow"
  }
];

// PURE OLLASTACK: Right Column (AI SPECIAL)
const aiSpecialPosts = [
  { title: "Build an AI Agent That Sends and Receives Email (with MCP)", slug: "build-ai-agent-that-sends-and-receives-email" },
  { title: "Give Your AI Agent an Email Identity (Full Duplex Comms)", slug: "agent-email-identity" },
