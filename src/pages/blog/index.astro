---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

import { posts as legacyPosts } from "../../data/posts";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// Markdown collection posts, mapped to the same shape and merged with the
// legacy .astro posts, newest first.
const collectionPosts = (
  await getCollection("blog", ({ data }) => data.draft !== true)
).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString().slice(0, 10),
  readingTime: `${p.data.readingTime} min read`,
}));

const posts = [...legacyPosts, ...collectionPosts].sort((a, b) =>
  b.date.localeCompare(a.date)
);
---

<Base
  title="Blog — Ollastack"
  description="Notes from building a form backend in 2026. Practical, honest, dev-first."
  current="blog"
>
  <div class="container-wide blog-shell">
    <header class="blog-head">
      <div class="eyebrow mono">/ blog</div>
      <h1 class="display">Notes from building a form backend.</h1>
      <p class="lede">
        Practical pieces on shipping forms, handling submissions, and the
        details behind a "simple" endpoint that an AI agent actually wants
        to talk to.
      </p>
    </header>

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`} class="post-card">
            <div class="post-meta mono">
              <time datetime={post.date}>{fmtDate(post.date)}</time>
              <span class="dot">·</span>
              <span>{post.readingTime}</span>
            </div>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <span class="read-more mono">Read →</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="more-soon mono">More soon.</p>
  </div>
</Base>

<style>
  .blog-shell {
    padding: 72px 28px 96px;
    max-width: 760px;
  }
  .blog-head { margin-bottom: 56px; }
  .eyebrow {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }
  .blog-head h1 {
    font-size: 44px;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post-card {
    display: block;
    padding: 28px 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    transition: border-color 0.15s ease, transform 0.15s ease;
    color: var(--ink);
  }
  .post-card:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }
  .post-meta {
    font-size: 12px;
    color: var(--muted-2);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .dot { opacity: 0.5; }
  .post-card h2 {
    font-size: 22px;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .post-card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 14px;
    font-size: 15px;
  }
  .read-more {
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .more-soon {
    color: var(--muted-2);
    font-size: 13px;
    margin-top: 48px;
    text-align: center;
  }
</style>
