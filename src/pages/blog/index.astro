  { title: "Test Email in Docker & CI with Ephemeral Disposable Inboxes", slug: "test-inbox-docker" },
  { title: "AgentMail Alternative: Agent Inboxes + Forms + CI Testing", slug: "agentmail-alternative" },
  { title: "Email for AI Agents: Dedicated Inboxes vs Send-Only APIs", slug: "email-for-ai-agents" },
