---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

import { posts as legacyPosts } from "../../data/posts";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// Markdown collection posts, mapped to the same shape and merged with the
// legacy .astro posts, newest first.
const collectionPosts = (
  await getCollection("blog", ({ data }) => data.draft !== true)
).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString().slice(0, 10),
  readingTime: `${p.data.readingTime} min read`,
}));

const posts = [...legacyPosts, ...collectionPosts].sort((a, b) =>
  b.date.localeCompare(a.date)
);
---

<Base
  title="Blog — Ollastack"
  description="Notes from building a form backend in 2026. Practical, honest, dev-first."
  current="blog"
>
  <div class="container-wide blog-shell">
    <header class="blog-head">
      <div class="eyebrow mono">/ blog</div>
      <h1 class="display">Notes from building a form backend.</h1>
      <p class="lede">
        Practical pieces on shipping forms, handling submissions, and the
        details behind a "simple" endpoint that an AI agent actually wants
        to talk to.
      </p>
    </header>

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`} class="post-card">
            <div class="post-card-top">
              <div class="post-meta mono">
                <span class="meta-tag">ARTICLE</span>
                <time datetime={post.date}>{fmtDate(post.date)}</time>
                <span class="dot">·</span>
                <span>{post.readingTime}</span>
              </div>
              <span class="post-arrow" aria-hidden="true">→</span>
            </div>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <div class="post-card-bottom">
              <span class="read-more mono">Read Article <span class="arrow-anim">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="more-soon mono">More articles coming soon.</p>
  </div>
</Base>

<style>
  .blog-shell {
    padding: 72px 28px 96px;
    max-width: 860px;
    margin: 0 auto;
  }
  .blog-head {
    margin-bottom: 56px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #ea580c;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    padding: 5px 14px;
    border-radius: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 22px;
    box-shadow: 0 1px 3px rgba(234, 88, 12, 0.06);
  }
  .blog-head h1 {
    font-size: 48px;
    margin: 0 0 18px;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--ink);
  }
  .lede {
    font-size: 19px;
    color: var(--muted);
    line-height: 1.65;
    max-width: 680px;
    margin: 0;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .post-card {
    display: block;
    padding: 34px 32px;
    border: 1.5px solid #e2e8f0;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--ink);
    position: relative;
    overflow: hidden;
    text-decoration: none !important;
  }
  .post-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 100%;
    background: #ea580c;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .post-card:hover {
    border-color: #ea580c;
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(234, 88, 12, 0.09);
  }
  .post-card:hover::before {
    opacity: 1;
  }
  .post-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .post-meta {
    font-size: 12.5px;
    color: var(--muted-2);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .meta-tag {
    background: #fff7ed;
    color: #ea580c;
    border: 1px solid #ffedd5;
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .post-arrow {
    font-size: 18px;
    color: var(--muted-3);
    transition: all 0.2s ease;
  }
  .post-card:hover .post-arrow {
    color: #ea580c;
    transform: translateX(4px);
  }
  .dot { opacity: 0.4; }
  .post-card h2 {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: -0.015em;
    line-height: 1.32;
    color: #0f172a;
    transition: color 0.15s ease;
  }
  .post-card:hover h2 {
    color: #ea580c;
  }
  .post-card p {
    color: #475569;
    line-height: 1.65;
    margin: 0 0 20px;
    font-size: 15.5px;
  }
  .post-card-bottom {
    display: flex;
    align-items: center;
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: #ea580c;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .arrow-anim {
    transition: transform 0.2s ease;
  }
  .post-card:hover .arrow-anim {
    transform: translateX(4px);
  }
  .more-soon {
    color: var(--muted-2);
    font-size: 13px;
    margin-top: 56px;
    text-align: center;
  }
</style>
