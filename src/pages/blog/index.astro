---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { posts as legacyPosts } from "../../data/posts";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

function getPostCategory(slug: string, title = ""): { category: string; categorySlug: string; icon: string } {
  const s = slug.toLowerCase();
  const t = title.toLowerCase();

  // 1. AI Agents
  if (
    s === "read-otp-verification-code-in-ai-agent" ||
    s === "build-ai-agent-that-sends-and-receives-email" ||
    s === "email-for-ai-agents" ||
    s === "agent-email-identity" ||
    s === "form-backend-for-ai-agents" ||
    s === "can-ai-agents-submit-forms-safely" ||
    s.includes("ai-agent") ||
    s.includes("agent")
  ) {
    return { category: "AI Agents", categorySlug: "ai-agents", icon: "🤖" };
  }

  // 4. Email Testing
  if (
    s === "how-to-automate-otp-email-testing-in-ci-cd-pipelines" ||
    s === "test-inbox-docker" ||
    s === "assert-on-email-in-playwright-cypress" ||
    s === "email-testing-api-for-ci" ||
    s === "test-otp-email-in-ci" ||
    s.includes("test-otp") ||
    s.includes("email-ci-benchmarks") ||
    (s.includes("test") && (s.includes("email") || s.includes("inbox") || s.includes("otp")))
  ) {
    return { category: "Email Testing", categorySlug: "email-testing", icon: "✉️" };
  }

  // 8. Comparisons
  if (
    s === "agentmail-alternative" ||
    s === "mailosaur-alternative" ||
    s === "formspree-alternative" ||
    s === "resend-free-tier-alternative" ||
    s === "sendgrid-free-alternative" ||
    s === "formspree-vs-netlify-forms" ||
    s === "basin-vs-web3forms" ||
    s === "forminit-alternatives" ||
    s.includes("-vs-") ||
    (s.includes("alternative") && !s.includes("migrate"))
  ) {
    return { category: "Comparisons", categorySlug: "comparisons", icon: "⚖️" };
  }

  // 9. Migrations
  if (
    s === "migrate-from-getform" ||
    s === "migrate-from-basin" ||
    s === "migrate-from-netlify-forms" ||
    s === "migrate-from-formspree" ||
    s === "netlify-forms-alternatives" ||
    s === "formspree-migration-pitfalls" ||
    s === "formspree-webhook-migration-node" ||
    s.includes("migrate") ||
    s.includes("migration")
  ) {
    return { category: "Migrations", categorySlug: "migrations", icon: "🚀" };
  }

  // 10. Integrations
  if (
    s === "form-webhooks-guide" ||
    s === "remix-form-quickstart" ||
    s === "vue-nuxt-form-quickstart" ||
    s === "react-hook-form-backend" ||
    s === "sveltekit-form-quickstart" ||
    s === "astro-form-quickstart" ||
    s === "nextjs-quickstart-hosted-form" ||
    s.includes("quickstart") ||
    s.includes("hook-form") ||
    s.includes("webhooks") ||
    s.includes("nextjs-serverless") ||
    s.includes("resend-integration") ||
    s.includes("dodopayments")
  ) {
    return { category: "Integrations", categorySlug: "integrations", icon: "🔌" };
  }

  // 6. Deliverability
  if (
    s === "per-tenant-smtp-guide" ||
    s === "dkim-spf-dmarc-custom-sender" ||
    s.includes("deliverability") ||
    s.includes("smtp") ||
    s.includes("dkim") ||
    s.includes("bounce") ||
    s.includes("sender-domain")
  ) {
    return { category: "Deliverability", categorySlug: "deliverability", icon: "🛡️" };
  }

  // 7. Security
  if (
    s === "secure-forms-honeypot-captcha" ||
    s === "ml-quarantine-explained" ||
    s.includes("security") ||
    s.includes("quarantine") ||
    s.includes("ddos") ||
    s.includes("privacy")
  ) {
    return { category: "Security", categorySlug: "security", icon: "🔒" };
  }

  // 5. Developers
  if (
    s === "nodejs-email-api" ||
    s === "python-email-api" ||
    s.startsWith("send-email-") ||
    s.includes("send-email") ||
    s.includes("python-send") ||
    s.includes("curl")
  ) {
    return { category: "Developers", categorySlug: "developers", icon: "💻" };
  }

  // 2. Email API
  if (
    s === "best-email-api" ||
    s === "inbound-email-api" ||
    s === "email-inbox-api" ||
    s.includes("free-email-api") ||
    s.includes("email-api") ||
    s.includes("free-otp-email") ||
    s.includes("email-scaling")
  ) {
    return { category: "Email API", categorySlug: "email-api", icon: "⚡" };
  }

  // 3. Forms
  return { category: "Forms", categorySlug: "forms", icon: "📋" };
}

// Markdown collection posts
const rawCollection = await getCollection("blog", ({ data }) => data.draft !== true);
const collectionPosts = rawCollection
  .filter(
    (p) =>
      p.slug !== "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" &&
      p.slug !== "how-to-build-a-form-backend-for-a-static-site"
  )
  .map((p) => {
    const cat = getPostCategory(p.slug, p.data.title || "");
    return {
      slug: p.slug,
      title: p.data.title,
      description: p.data.description,
      date: p.data.date.toISOString().slice(0, 10),
      readingTime: `${p.data.readingTime} min read`,
      category: cat.category,
      categorySlug: cat.categorySlug,
      icon: cat.icon,
      tags: p.data.tags || [],
    };
  });

const postMap = new Map();
collectionPosts.forEach((p) => postMap.set(p.slug, p));
legacyPosts.forEach((p) => {
  const cat = getPostCategory(p.slug, p.title || "");
  postMap.set(p.slug, {
    ...p,
    category: cat.category,
    categorySlug: cat.categorySlug,
    icon: cat.icon,
  });
});

const posts = Array.from(postMap.values()).sort((a, b) =>
  b.date.localeCompare(a.date)
);

const CATEGORY_LIST = [
  { slug: "all", name: "All Articles", icon: "⚡" },
  { slug: "ai-agents", name: "AI Agents", icon: "🤖" },
  { slug: "email-api", name: "Email API", icon: "⚡" },
  { slug: "forms", name: "Forms", icon: "📋" },
  { slug: "email-testing", name: "Email Testing", icon: "✉️" },
  { slug: "developers", name: "Developers", icon: "💻" },
  { slug: "deliverability", name: "Deliverability", icon: "🛡️" },
  { slug: "security", name: "Security", icon: "🔒" },
  { slug: "comparisons", name: "Comparisons", icon: "⚖️" },
  { slug: "migrations", name: "Migrations", icon: "🚀" },
  { slug: "integrations", name: "Integrations", icon: "🔌" },
];

const categoriesWithCounts = CATEGORY_LIST.map((c) => ({
  ...c,
  count: c.slug === "all" ? posts.length : posts.filter((p) => p.categorySlug === c.slug).length,
}));

const popularTopics = [
  "Playwright", "Cypress", "OTP", "AI Agents", "Security", "Static Sites", "Webhooks", "FastAPI", "React", "Next.js"
];
---

<Base
  title="Engineering Blog & Guides — Ollastack"
  description="Deep-dives, architecture guides, and production playbooks for AI agents, email verification, and form backends."
  current="blog"
>
  <div class="blog-page-container">
    
    <!-- Hero Atmospheric Header -->
    <header class="blog-header-banner">
      <div class="banner-ambient-glow" aria-hidden="true"></div>
      <div class="container-wide header-content-wrapper">
        <div class="header-inner">
          <div class="blog-pill-badge mono">
            <span class="pulse-dot"></span>
            <span>ENGINEERING BLOG &amp; PLAYBOOKS</span>
          </div>
          <h1 class="page-title">Notes from building the message layer for AI agents.</h1>
          <p class="page-description">
            Practical pieces on shipping forms, automated email verification in CI, and handling traffic an AI agent actually wants to talk to.
          </p>
        </div>
      </div>
    </header>

    <!-- Two-Column Layout Container -->
    <div class="container-wide blog-main-layout">
      
      <!-- ============ LEFT SIDEBAR: 10 CATEGORIES & SEARCH ============ -->
      <aside class="blog-sidebar-left">
        <div class="sidebar-sticky-inner">
          
          <!-- Search Card -->
          <div class="sidebar-search-card">
            <div class="search-input-wrapper">
              <svg class="search-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="blog-search"
                placeholder="Search articles by keyword..."
                aria-label="Search articles"
                class="sidebar-search-input"
              />
              <button type="button" id="sidebar-clear-search" class="clear-search-x" aria-label="Clear search" style="display: none;">✕</button>
            </div>
          </div>

          <!-- Category Navigation Card -->
          <div class="sidebar-card">
            <div class="sidebar-card-header">
              <span class="sidebar-eyebrow mono">EXPLORE TRACKS</span>
              <span class="sidebar-tracks-count mono">{categoriesWithCounts.length - 1} tracks</span>
            </div>

            <nav class="sidebar-cat-nav" role="tablist" aria-label="Blog categories">
              {categoriesWithCounts.map((cat, idx) => (
                <button
                  type="button"
                  role="tab"
                  class={`sidebar-cat-btn ${idx === 0 ? "active" : ""}`}
                  data-category={cat.slug}
                  data-name={cat.name}
                  aria-selected={idx === 0 ? "true" : "false"}
                >
                  <div class="cat-left">
                    <span class={`cat-icon-box box-${cat.slug}`}>{cat.icon}</span>
                    <span class="cat-title-text">{cat.name}</span>
                  </div>
                  <span class="cat-badge-count mono">{cat.count}</span>
                </button>
              ))}
            </nav>
          </div>

          <!-- Popular Topics / Tags Card -->
          <div class="sidebar-card">
            <div class="sidebar-card-header">
              <span class="sidebar-eyebrow mono">POPULAR TOPICS</span>
            </div>
            <div class="topics-tags-cloud">
              {popularTopics.map((topic) => (
                <button type="button" class="topic-tag-btn mono" data-topic={topic.toLowerCase()}>
                  #{topic}
                </button>
              ))}
            </div>
          </div>

        </div>
      </aside>

      <!-- ============ RIGHT CONTENT: BLOG POSTS LIST ============ -->
      <main class="blog-content-right">
        
        <!-- Section Title & Meta Header -->
        <div class="feed-header-bar">
          <div class="feed-title-wrap">
            <div class="feed-title-with-pill">
              <h2 class="feed-current-title" id="current-category-name">All Articles</h2>
              <span class="feed-count-tag mono" id="feed-articles-count">{posts.length} articles</span>
            </div>
          </div>
          
          <div class="feed-active-filter" id="active-filter-indicator" style="display: none;">
            <span class="filter-msg mono">Filtered: <strong id="filter-term-display"></strong></span>
            <button type="button" id="clear-all-filter-btn" class="clear-filter-link mono">Reset ✕</button>
          </div>
        </div>

        <!-- Blog Cards 2-Column Grid -->
        <div class="blog-cards-grid" id="blog-posts-list">
          {posts.map((post, idx) => {
            const isLatest = idx === 0;
            return (
              <article
                class="blog-card-item"
                data-category={post.categorySlug}
                data-title={post.title.toLowerCase()}
                data-desc={post.description.toLowerCase()}
              >
                <a href={`/blog/${post.slug}`} class={`blog-article-card ${isLatest ? "latest-card" : ""}`}>
                  
                  <div class="card-inner-top">
                    <div class="card-head-row">
                      <span class={`cat-pill pill-${post.categorySlug}`}>
                        <span class="cat-pill-icon">{post.icon}</span>
                        <span>{post.category}</span>
                      </span>
                      <span class="reading-time mono">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="clock-icon" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        {post.readingTime}
                      </span>
                    </div>

                    <h3 class="card-article-title">{post.title}</h3>
                    <p class="card-article-description">{post.description}</p>
                  </div>

                  <div class="card-footer-row">
                    <span class="post-date-text mono">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="date-cal-icon" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      {fmtDate(post.date)}
                    </span>

                    <span class="read-btn mono">
                      <span>READ GUIDE</span>
                      <span class="arrow-glyph">→</span>
                    </span>
                  </div>

                </a>
              </article>
            );
          })}
        </div>

        <!-- No Matching Results Message -->
        <div id="no-posts-found" class="no-posts-box" style="display: none;">
          <div class="no-posts-icon">🔍</div>
          <h3>No articles found</h3>
          <p>No articles matched your search or category filter. Try clearing the search keyword or selecting a different category.</p>
          <button type="button" id="reset-feed-btn" class="btn btn-primary btn-sm">Show all articles</button>
        </div>

      </main>

    </div>
  </div>
</Base>

<style>
  /* ==========================================================================
     Ultra-Attractive Two-Column Blog Layout (Categories Left, Posts Right)
     ========================================================================== */
  .blog-page-container {
    background: #f8fafc;
    min-height: 100vh;
    padding-bottom: 120px;
  }

  /* Header Banner with Ambient Mesh Glow */
  .blog-header-banner {
    position: relative;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 68px 0 54px;
    overflow: hidden;
  }

  .banner-ambient-glow {
    position: absolute;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    width: 780px;
    height: 360px;
    background: radial-gradient(circle, rgba(218, 41, 28, 0.08) 0%, rgba(218, 41, 28, 0) 70%);
    filter: blur(50px);
    pointer-events: none;
  }

  .header-content-wrapper {
    position: relative;
    z-index: 2;
  }

  .header-inner {
    max-width: 860px;
  }

  .blog-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #DA291C;
    background: #fff1f0;
    border: 1.5px solid #ffccc7;
    padding: 6px 15px;
    border-radius: 9999px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(218, 41, 28, 0.06);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #DA291C;
    box-shadow: 0 0 0 3px rgba(218, 41, 28, 0.25);
  }

  .page-title {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: #0f172a;
    margin: 0 0 16px;
  }

  .page-description {
    font-size: 18px;
    line-height: 1.62;
    color: #475569;
    margin: 0;
    max-width: 720px;
  }

  /* Main Layout Grid */
  .blog-main-layout {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    gap: 44px;
    margin-top: 40px;
    align-items: start;
  }

  /* ==========================================================================
     Left Sidebar: Polished Cards & Navigation
     ========================================================================== */
  .blog-sidebar-left {
    position: sticky;
    top: 84px;
  }

  .sidebar-sticky-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-search-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    padding: 6px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
  }

  /* Search Input */
  .search-input-wrapper {
    position: relative;
    width: 100%;
  }

  .search-svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
  }

  .sidebar-search-input {
    width: 100%;
    padding: 10px 34px 10px 38px;
    font-size: 13.5px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: #f8fafc;
    color: #0f172a;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .sidebar-search-input:focus {
    outline: none;
    background: #ffffff;
    border-color: #DA291C;
    box-shadow: 0 0 0 3px rgba(218, 41, 28, 0.1);
  }

  .clear-search-x {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: #e2e8f0;
    border: none;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    font-size: 11px;
    color: #475569;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .clear-search-x:hover {
    background: #cbd5e1;
    color: #0f172a;
  }

  /* Sidebar Card Container */
  .sidebar-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 18px;
    padding: 18px 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
  }

  .sidebar-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .sidebar-eyebrow {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .sidebar-tracks-count {
    font-size: 11px;
    color: #94a3b8;
  }

  /* Category Navigation Buttons */
  .sidebar-cat-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-cat-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 11px;
    background: transparent;
    border: 1px solid transparent;
    font-size: 13.5px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    text-align: left;
    width: 100%;
  }

  .sidebar-cat-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
    transform: translateX(3px);
  }

  .sidebar-cat-btn.active {
    background: #DA291C;
    border-color: #DA291C;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(218, 41, 28, 0.28);
    transform: translateX(3px);
  }

  .cat-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .cat-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    font-size: 13px;
    background: #f1f5f9;
    flex-shrink: 0;
    transition: background 0.15s ease;
  }

  .sidebar-cat-btn:hover .cat-icon-box {
    background: #e2e8f0;
  }

  .sidebar-cat-btn.active .cat-icon-box {
    background: rgba(255, 255, 255, 0.2);
  }

  .cat-title-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-badge-count {
    font-size: 11px;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #64748b;
    flex-shrink: 0;
  }

  .sidebar-cat-btn:hover .cat-badge-count {
    background: #e2e8f0;
    color: #0f172a;
  }

  .sidebar-cat-btn.active .cat-badge-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Topics Cloud */
  .topics-tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .topic-tag-btn {
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #64748b;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .topic-tag-btn:hover {
    border-color: #DA291C;
    color: #DA291C;
    background: #fff1f0;
    transform: translateY(-1px);
  }

  /* ==========================================================================
     Right Content: Articles Feed & Modern Cards
     ========================================================================== */
  .blog-content-right {
    min-width: 0;
  }

  .feed-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
    gap: 12px;
  }

  .feed-title-with-pill {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .feed-current-title {
    font-size: 24px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .feed-count-tag {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .feed-active-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #64748b;
    background: #ffffff;
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  .clear-filter-link {
    background: #fff1f0;
    border: 1px solid #ffccc7;
    color: #DA291C;
    font-weight: 700;
    cursor: pointer;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    transition: all 0.15s ease;
  }

  .clear-filter-link:hover {
    background: #DA291C;
    color: #ffffff;
  }

  /* Cards Grid */
  .blog-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .blog-card-item {
    display: flex;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .blog-article-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 28px 26px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    text-decoration: none !important;
    color: inherit;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    position: relative;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-article-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #DA291C;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .latest-card {
    border-color: #ffccc7;
    background: linear-gradient(180deg, #ffffff 0%, #fffcfc 100%);
    box-shadow: 0 6px 20px rgba(218, 41, 28, 0.05);
  }

  .latest-card::before {
    opacity: 1;
  }

  .blog-article-card:hover {
    transform: translateY(-4px);
    border-color: #DA291C;
    box-shadow: 0 18px 40px rgba(218, 41, 28, 0.1);
  }

  .blog-article-card:hover::before {
    opacity: 1;
  }

  .card-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* 10 Category Pill Color Codes */
  .pill-ai-agents { background: #fff1f0; color: #DA291C; border: 1px solid #ffccc7; }
  .pill-email-api { background: #fff7ed; color: #ea580c; border: 1px solid #ffedd5; }
  .pill-forms { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
  .pill-email-testing { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
  .pill-developers { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
  .pill-deliverability { background: #fefce8; color: #ca8a04; border: 1px solid #fef08a; }
  .pill-security { background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; }
  .pill-comparisons { background: #f5f3ff; color: #7c3aed; border: 1px solid #ddd6fe; }
  .pill-migrations { background: #eef2ff; color: #4f46e5; border: 1px solid #c7d2fe; }
  .pill-integrations { background: #fdf2f8; color: #db2777; border: 1px solid #fbcfe8; }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #94a3b8;
  }

  .clock-icon {
    color: #cbd5e1;
  }

  .card-article-title {
    font-size: 19.5px;
    font-weight: 750;
    line-height: 1.34;
    color: #0f172a;
    letter-spacing: -0.018em;
    margin: 0 0 12px;
    transition: color 0.15s ease;
  }

  .blog-article-card:hover .card-article-title {
    color: #DA291C;
  }

  .card-article-description {
    font-size: 14px;
    line-height: 1.62;
    color: #475569;
    margin: 0 0 24px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
  }

  .post-date-text {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
  }

  .date-cal-icon {
    color: #94a3b8;
  }

  .read-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 800;
    color: #DA291C;
    letter-spacing: 0.05em;
  }

  .arrow-glyph {
    transition: transform 0.2s ease;
  }

  .blog-article-card:hover .arrow-glyph {
    transform: translateX(4px);
  }

  /* Empty State */
  .no-posts-box {
    text-align: center;
    padding: 60px 24px;
    background: #ffffff;
    border: 1.5px dashed #cbd5e1;
    border-radius: 20px;
    margin-top: 20px;
  }

  .no-posts-icon {
    font-size: 36px;
    margin-bottom: 10px;
  }

  .no-posts-box h3 {
    font-size: 19px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px;
  }

  .no-posts-box p {
    color: #64748b;
    font-size: 14.5px;
    max-width: 440px;
    margin: 0 auto 18px;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .blog-main-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .blog-sidebar-left {
      position: static;
    }
    .sidebar-cat-nav {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .sidebar-cat-btn {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 640px) {
    .blog-cards-grid {
      grid-template-columns: 1fr;
    }
    .blog-header-banner {
      padding: 44px 0 36px;
    }
    .blog-article-card {
      padding: 22px 20px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const catButtons = document.querySelectorAll<HTMLButtonElement>(".sidebar-cat-btn");
    const topicButtons = document.querySelectorAll<HTMLButtonElement>(".topic-tag-btn");
    const cardItems = document.querySelectorAll<HTMLElement>(".blog-card-item");
    const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById("sidebar-clear-search") as HTMLButtonElement | null;
    const currentCatNameEl = document.getElementById("current-category-name");
    const articlesCountEl = document.getElementById("feed-articles-count");
    const filterIndicator = document.getElementById("active-filter-indicator");
    const filterTermDisplay = document.getElementById("filter-term-display");
    const clearAllFilterBtn = document.getElementById("clear-all-filter-btn");
    const noPostsFoundBox = document.getElementById("no-posts-found");
    const resetFeedBtn = document.getElementById("reset-feed-btn");

    let currentCategory = "all";
    let searchQuery = "";
    let currentCategoryLabel = "All Articles";

    function updateView() {
      let visibleCount = 0;

      cardItems.forEach((item) => {
        const itemCat = item.getAttribute("data-category") || "";
        const itemTitle = item.getAttribute("data-title") || "";
        const itemDesc = item.getAttribute("data-desc") || "";

        const matchesCat = currentCategory === "all" || itemCat === currentCategory;
        const matchesSearch =
          !searchQuery ||
          itemTitle.includes(searchQuery) ||
          itemDesc.includes(searchQuery) ||
          itemCat.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          item.style.display = "flex";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      // Update Category Title & Count
      if (currentCatNameEl) currentCatNameEl.textContent = currentCategoryLabel;
      if (articlesCountEl) articlesCountEl.textContent = `${visibleCount} articles`;

      // Active filter banner
      const isFiltered = currentCategory !== "all" || searchQuery.length > 0;
      if (filterIndicator) {
        filterIndicator.style.display = isFiltered ? "flex" : "none";
        if (filterTermDisplay) {
          filterTermDisplay.textContent = searchQuery ? `"${searchQuery}"` : currentCategoryLabel;
        }
      }

      // Empty state
      if (noPostsFoundBox) {
        noPostsFoundBox.style.display = visibleCount === 0 ? "block" : "none";
      }
    }

    // Category click
    catButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        catButtons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");
        currentCategory = btn.getAttribute("data-category") || "all";
        currentCategoryLabel = btn.getAttribute("data-name") || "All Articles";
        updateView();
      });
    });

    // Topic Tags click
    topicButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const topic = btn.getAttribute("data-topic") || "";
        if (searchInput) {
          searchInput.value = topic;
          searchQuery = topic;
          if (clearSearchBtn) clearSearchBtn.style.display = "flex";
          updateView();
        }
      });
    });

    // Search input
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        if (clearSearchBtn) {
          clearSearchBtn.style.display = searchQuery.length > 0 ? "flex" : "none";
        }
        updateView();
      });
    }

    // Clear search
    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener("click", () => {
        searchInput.value = "";
        searchQuery = "";
        clearSearchBtn.style.display = "none";
        searchInput.focus();
        updateView();
      });
    }

    // Reset All
    function resetAll() {
      currentCategory = "all";
      currentCategoryLabel = "All Articles";
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.style.display = "none";
      catButtons.forEach((b, i) => {
        if (i === 0) {
          b.classList.add("active");
          b.setAttribute("aria-selected", "true");
        } else {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        }
      });
      updateView();
    }

    if (clearAllFilterBtn) clearAllFilterBtn.addEventListener("click", resetAll);
    if (resetFeedBtn) resetFeedBtn.addEventListener("click", resetAll);
  });
</script>
