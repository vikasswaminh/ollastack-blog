    color: var(--ink);
  }
  .body p {
    line-height: 1.75;
    margin: 0 0 14px;
    font-size: 16px;
    color: var(--ink);
  }
  .body ul {
    line-height: 1.8;
    padding-left: 22px;
    margin: 0 0 16px;
  }
