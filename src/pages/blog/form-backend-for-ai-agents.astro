    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .body a {
    color: var(--ink);
    border-bottom: 1px solid var(--muted-3);
    transition: border-color 0.12s ease, color 0.12s ease;
  }
  .body a:hover { color: var(--accent); border-color: var(--accent); }
