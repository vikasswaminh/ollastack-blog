    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 24px;
  }
  .back:hover { color: var(--ink); }
  .post-meta {
    font-size: 12px;
    color: var(--muted-2);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .dot { opacity: 0.5; }
  .post-head h1 {
    font-size: 38px;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
  .body h2 {
    font-size: 24px;
    margin: 48px 0 14px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .body h3 {
