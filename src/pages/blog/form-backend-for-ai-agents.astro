    padding: 18px 22px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.7;
    overflow-x: auto;
    white-space: pre;
    margin: 8px 0 18px;
  }
  .code .k { color: var(--code-key); }
  .code .s { color: var(--code-str); }
</style>
