  .back:hover { color: var(--ink); }
  .post-meta { font-size: 12px; color: var(--muted-2); display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
  .dot { opacity: 0.5; }
  .post-head h1 { font-size: 38px; margin: 0 0 16px; letter-spacing: -0.02em; line-height: 1.15; }
  .lede { font-size: 18px; color: var(--muted); line-height: 1.6; margin: 0; }
  .body h2 { font-size: 24px; margin: 48px 0 14px; letter-spacing: -0.01em; line-height: 1.3; }
  .body h3 { font-size: 18px; margin: 32px 0 10px; letter-spacing: -0.005em; color: var(--ink); }
  .body p { line-height: 1.75; margin: 0 0 14px; font-size: 16px; color: var(--ink); }
  .body ul, .body ol { line-height: 1.8; padding-left: 22px; margin: 0 0 16px; }
  .body li { margin-bottom: 6px; }
  .body code { background: var(--bg-sunken); border: 1px solid var(--line); padding: 0 5px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.88em; }
  .body a { color: var(--ink); border-bottom: 1px solid var(--muted-3); transition: border-color 0.12s ease, color 0.12s ease; }
  .body a:hover { color: var(--accent); border-color: var(--accent); }
  .body table { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: 14px; }
  .body th, .body td { border-bottom: 1px solid var(--line); padding: 10px 12px; text-align: left; vertical-align: top; }
  .body th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500; }
  .muted-note { color: var(--muted); font-size: 14px; }
