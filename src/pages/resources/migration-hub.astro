---
import ResourceHub from "../../layouts/ResourceHub.astro";
import type { HubSection, HubLink } from "../../layouts/ResourceHub.astro";

const APP = "https://login.ollastack.com";

const sections: HubSection[] = [
  {
    heading: "Step-by-step migration guides",
    blurb:
      "Move your forms off your current backend without rewriting your site. Each guide has the actual code diff and a copy-paste checklist.",
    links: [
      {
        href: "/blog/migrate-from-formspree",
        title: "Migrate from Formspree to Ollastack",
        desc: "Repoint your form action, keep your markup, and bring scoped tokens + agent submissions that Formspree doesn't offer.",
      },
      {
        href: "/blog/migrate-from-netlify-forms",
        title: "Migrate from Netlify Forms",
        desc: "Netlify moved to credit-based billing. Move your forms off without leaving your static host — with the exact diff.",
      },
      {
        href: "/blog/migrate-from-basin",
        title: "Migrate from Basin",
        desc: "Keep the things Basin got right, gain a real API, signed webhooks, and an agent path. Step by step.",
      },
      {
        href: "/blog/migrate-from-getform",
        title: "Migrate from Getform / Forminit",
        desc: "Getform rebranded to Forminit in 2026. Here's how to move your endpoints and what changes (and what doesn't).",
      },
      {
        href: "/blog/mailosaur-alternative",
        title: "Replace Mailosaur for email testing in CI",
        desc: "If you used Mailosaur to assert on OTP/verification emails, here's the disposable-inbox equivalent on Ollastack.",
      },
    ],
  },
  {
    heading: "Compare the alternatives first",
    blurb:
      "Not sure which backend to move to? These honest comparisons lay out the tradeoffs — including the cases where staying put is the right call.",
    links: [
      {
        href: "/blog/formspree-alternative",
        title: "Ollastack vs Formspree",
        desc: "A head-to-head on pricing, agent support, webhooks, and the spam pipeline.",
      },
      {
        href: "/blog/formspree-alternative/",
        title: "Formspree alternatives in 2026",
        desc: "The full landscape — Basin, Formcarry, Forminit, Web3Forms, Netlify, Formspark, Ollastack — with each one's tradeoffs.",
      },
      {
        href: "/blog/netlify-forms-alternatives",
        title: "Netlify Forms alternatives",
        desc: "Where to move after the billing change, with the migration diff for each option.",
      },
      {
        href: "/blog/forminit-alternatives",
        title: "Forminit (Getform) alternatives",
        desc: "A straight comparison of the backends worth considering after the rebrand.",
      },
      {
        href: "/blog/basin-vs-web3forms",
        title: "Basin vs Web3Forms",
        desc: "Dashboard polish vs unlimited free submissions — and when neither is the right answer.",
      },
      {
        href: "/blog/formspree-vs-netlify-forms",
        title: "Formspree vs Netlify Forms",
        desc: "Two backends, different assumptions. When each fits and when each breaks.",
      },
    ],
  },
  {
    heading: "Decide: hosted or self-host?",
    blurb:
      "Before you migrate, get the build-vs-buy call right — and pick a backend that keeps the decision reversible.",
    links: [
      {
        href: "/blog/self-host-vs-hosted-form-backend",
        title: "Self-host vs hosted form backend",
        desc: "A clear decision framework — control, compliance, and cost vs operational burden — and why you don't always have to choose.",
      },
      {
        href: "/blog/form-backend-for-ai-agents",
        title: "Why HTML form endpoints break for AI agents",
        desc: "If agents will submit your forms, the backend you migrate to matters. Here's the design that treats agents as first-class.",
      },
    ],
  },
];

const related: HubLink[] = [
  {
    href: "/resources/developer-hub",
    title: "Developer hub",
    desc: "Framework quickstarts, webhooks, file uploads, agent mail, and the API.",
  },
  {
    href: "/resources/deliverability-hub",
    title: "Deliverability hub",
    desc: "SPF/DKIM/DMARC, custom sender domains, spam handling, per-tenant SMTP.",
  },
];
---

<ResourceHub
  title="Migrate your forms to Ollastack — migration guides & comparisons"
  description="Everything you need to move your form backend to Ollastack: step-by-step migration guides from Formspree, Netlify Forms, Basin, and Getform, honest alternative comparisons, and the hosted-vs-self-host decision."
  eyebrow="/ migration hub"
  h1="Move your forms, keep your site."
  lede="A complete map for migrating off your current form backend — migration guides with real code diffs, honest comparisons of the alternatives, and the hosted-vs-self-host decision. Most migrations are a one-line action change."
  ctaHref={`${APP}/register`}
  ctaLabel="Start your migration"
  sections={sections}
  related={related}
/>
