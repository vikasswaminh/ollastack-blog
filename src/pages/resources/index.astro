---
import Base from "../../layouts/Base.astro";

const hubs = [
  {
    href: "/resources/migration-hub",
    eyebrow: "migration",
    title: "Migration hub",
    desc: "Move your forms off Formspree, Netlify Forms, Basin, or Getform — step-by-step guides with real code diffs, honest comparisons, and the hosted-vs-self-host call.",
  },
  {
    href: "/resources/developer-hub",
    eyebrow: "developers",
    title: "Developer hub",
    desc: "Framework quickstarts (Next.js, Astro, SvelteKit, Vue/Nuxt, Remix, React Hook Form), signed webhooks, file uploads, the agent path, and the OpenAPI spec.",
  },
  {
    href: "/resources/deliverability-hub",
    eyebrow: "deliverability",
    title: "Deliverability hub",
    desc: "SPF/DKIM/DMARC, custom sender domains, per-tenant SMTP, the fail-open spam model, and testing the email path in CI.",
  },
];
---

<Base
  title="Resources — Ollastack guides, quickstarts & comparisons"
  description="Curated hubs of Ollastack guides: migrating your form backend, building forms in your framework, and getting notifications into the inbox."
>
  <div class="container res-shell">
    <header class="res-head">
      <div class="eyebrow mono">/ resources</div>
      <h1 class="display">Guides, organized by what you're doing.</h1>
      <p class="lede">
        Every Ollastack article, grouped into three hubs — moving an existing
        form backend over, building forms in your stack, and keeping
        notifications out of the spam folder.
      </p>
    </header>

    <ul class="hub-grid">
      {hubs.map((h) => (
        <li>
          <a href={h.href} class="hub-tile">
            <span class="hub-eyebrow mono">{h.eyebrow}</span>
            <h2>{h.title}</h2>
            <p>{h.desc}</p>
            <span class="hub-go mono">Browse →</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="res-foot mono">
      Looking for a single article? <a href="/blog">See all posts →</a>
    </p>
  </div>
</Base>

<style>
  .res-shell { padding: 64px 0 88px; max-width: 880px; }
  .res-head { margin-bottom: 44px; max-width: 640px; }
  .eyebrow {
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .res-head h1 {
    font-size: 42px;
    margin: 0 0 14px;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
  .hub-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hub-tile {
    display: block;
    padding: 28px 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-4);
    background: var(--bg);
    color: var(--ink);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hub-tile:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 18px 36px -18px rgba(10, 10, 10, 0.12);
  }
  .hub-eyebrow {
    font-size: 11px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .hub-tile h2 {
    font-size: 24px;
    margin: 10px 0 8px;
    letter-spacing: -0.015em;
  }
  .hub-tile p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 16px;
    max-width: 64ch;
  }
  .hub-go {
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .res-foot { margin-top: 36px; color: var(--muted-2); font-size: 13px; }
  .res-foot a { color: var(--ink); border-bottom: 1px dashed var(--muted-3); }

  @media (max-width: 760px) {
    .res-head h1 { font-size: 32px; }
  }
</style>
