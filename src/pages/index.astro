---
import Base from "../layouts/Base.astro";
import { softwareApplicationLd, faqPageLd, type Faq } from "../lib/schema";
const APP = "https://login.ollastack.com";

const SITE = "https://ollastack.com";
const HOME_TITLE = "Agent Email API, Forms & Email Testing — Ollastack";
const HOME_DESC =
  "Platform for agent email, forms, and email testing — send and receive email as an AI agent, collect form submissions, and read OTP codes and links in CI.";

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Ollastack",
  url: `${SITE}/`,
  logo: `${SITE}/og.png`,
  description: HOME_DESC,
  parentOrganization: {
    "@type": "Organization",
    name: "Ollasoftware Solutions",
    url: "https://ollasoftware.com",
    location: [
      { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: "Montreal", addressRegion: "QC", addressCountry: "CA" } },
      { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: "Bangalore", addressRegion: "KA", addressCountry: "IN" } },
    ],
  },
  sameAs: ["https://ollasoftware.com"],
};
const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Ollastack",
  url: `${SITE}/`,
  description: HOME_DESC,
};

const homeFaqs: Faq[] = [
  {
    q: "What is an agent email API?",
    a: "An agent email API lets an AI agent send, receive, and read email over HTTP instead of SMTP. Ollastack gives each agent a real mailbox (handle@agent.ollastack.com) it controls with a scoped Bearer token — sending, threaded replies, inbound polling, and OTP and link extraction, all as REST calls documented in one OpenAPI spec.",
  },
  {
    q: "How do I test OTP and verification emails in CI?",
    a: "Create a disposable inbox, trigger the email, then poll the mailbox's /wait endpoint until it arrives — codes[0] is the extracted OTP. Test inboxes on test.ollastack.com are never spam-filtered, so a CI job sees every message it triggers. It's a drop-in replacement for Mailosaur or Mailinator.",
  },
  {
    q: "Is Ollastack free?",
    a: "Yes — the Free plan includes 50 submissions per month and every core feature, with no credit card. Paid plans are $9/month (Solo, 500 submissions) and $29/month (Team, 5,000 submissions); the only paid-only extra is sending from your own verified domain.",
  },
  {
    q: "How is Ollastack different from Formspree?",
    a: "Ollastack is a form backend and an agent-email platform in one. Beyond Formspree-style form endpoints, it gives your AI agents real mailboxes and disposable test inboxes, Bearer tokens that skip the bot defenses, and a spam pipeline that quarantines a suspicious lead rather than silently dropping it.",
  },
  {
    q: "Can an AI agent submit forms and send email autonomously?",
    a: "Yes. A Bearer token owned by the form owner submits as a trusted agent — skipping honeypot, CAPTCHA, and per-IP rate limits — and is stamped in the inbox with the agent's label. The same token system sends and reads agent mail, and every call is written to an audit log.",
  },
  {
    q: "Are agent inboxes spam-filtered?",
    a: "Yes — persistent agent mailboxes run inbound mail through the same layered spam pipeline as forms (honeypot, blocklist, keyword and regex rules, Akismet, and an ML classifier), and it fails open so a classifier error never drops real mail. That spam-filtering is the main differentiator from AgentMail; disposable test inboxes are deliberately left unfiltered.",
  },
];
---

<Base current="home" title={HOME_TITLE} description={HOME_DESC}>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(siteLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqPageLd(homeFaqs))} is:inline />

  <!-- ============================================================
       HERO — left: copy + CTAs, right: architecture node diagram
       ============================================================ -->
  <section class="hero dot-grid">
    <div class="container hero-grid">

      <!-- LEFT: copy -->
      <div class="hero-copy">
        <span class="chip mono">
          <span class="dot"></span>
          API-FIRST · AGENT FORMS · MAILBOXES · EMAIL TESTING
        </span>

        <h1 class="display headline">
          Forms, mailboxes &amp; email testing,<br/>
          built for your <span class="brand-red-text">AI agents</span>.
        </h1>

        <p class="subhead">
          Three things your agents need, one backend: <strong>form endpoints</strong>
          they POST to and sail past the bot defenses, <strong>real mailboxes</strong>
          they send, receive, reply, and read OTP codes from, and
          <strong>disposable inboxes</strong> for testing email in CI. One token
          system, one OpenAPI spec they read themselves.
        </p>

        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href={`${APP}/register`}>
            Start free
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="/docs">Read the docs</a>
        </div>

        <div class="hero-geo-card">
          <span class="geo-pin" aria-hidden="true">📍</span>
          <span>
            <strong>GEO-smart leads</strong> — every form submission auto-stamped
            with country, city, region, and timezone.
          </span>
        </div>
      </div>

      <!-- RIGHT: architecture node diagram -->
      <div class="hero-diagram" aria-label="Ollastack platform architecture diagram">
        <!-- SVG connector lines & orbital ring -->
        <svg class="diag-connectors" viewBox="0 0 580 500" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
          <!-- Background faint orbital ellipse -->
          <ellipse cx="290" cy="262" rx="225" ry="180" stroke="#e5e7eb" stroke-width="1.5" stroke-dasharray="4 4" fill="none"/>

          <!-- Top card to Center Hub -->
          <line x1="290" y1="108" x2="290" y2="195" stroke="#e5e7eb" stroke-width="2" stroke-dasharray="4 4"/>
          <circle cx="290" cy="108" r="3.5" fill="#e11d48"/>
          <circle cx="290" cy="195" r="3.5" fill="#e11d48"/>

          <!-- Left card to Center Hub -->
          <line x1="185" y1="262" x2="210" y2="262" stroke="#e5e7eb" stroke-width="2" stroke-dasharray="4 4"/>
          <circle cx="185" cy="262" r="3.5" fill="#e11d48"/>
          <circle cx="210" cy="262" r="3.5" fill="#e11d48"/>

          <!-- Right card to Center Hub -->
          <line x1="370" y1="262" x2="395" y2="262" stroke="#e5e7eb" stroke-width="2" stroke-dasharray="4 4"/>
          <circle cx="370" cy="262" r="3.5" fill="#e11d48"/>
          <circle cx="395" cy="262" r="3.5" fill="#e11d48"/>

          <!-- Top-Left Aux to Center Hub -->
          <path d="M 125 125 Q 170 175 220 215" stroke="#e5e7eb" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="125" cy="125" r="3" fill="#9ca3af"/>

          <!-- Top-Right Aux to Center Hub -->
          <path d="M 455 125 Q 410 175 360 215" stroke="#e5e7eb" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="455" cy="125" r="3" fill="#9ca3af"/>

          <!-- Center Hub to Bottom Tag -->
          <line x1="290" y1="330" x2="290" y2="425" stroke="#e5e7eb" stroke-width="2" stroke-dasharray="4 4"/>
          <circle cx="290" cy="330" r="3.5" fill="#e11d48"/>
          <circle cx="290" cy="425" r="3.5" fill="#9ca3af"/>
        </svg>

        <!-- Top chip: BOT DEFENSES READY -->
        <div class="diag-aux diag-aux-top-left">
          <div class="diag-aux-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="diag-aux-text">BOT DEFENSES<br/>READY</span>
        </div>

        <!-- Top chip: OPENAPI FRIENDLY -->
        <div class="diag-aux diag-aux-top-right">
          <div class="diag-aux-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <span class="diag-aux-text">OPENAPI<br/>FRIENDLY</span>
        </div>

        <!-- Card 01: Headless Forms -->
        <div class="diag-card diag-card-top">
          <div class="diag-card-icon diag-card-icon-form">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="1.8">
              <rect x="3" y="3" width="18" height="18" rx="3"/>
              <line x1="7" y1="8" x2="17" y2="8"/>
              <line x1="7" y1="12" x2="17" y2="12"/>
              <line x1="7" y1="16" x2="13" y2="16"/>
            </svg>
          </div>
          <div class="diag-card-content">
            <div class="diag-card-header">
              <span class="diag-card-title">HEADLESS FORMS</span>
              <span class="diag-card-badge mono">01</span>
            </div>
            <p class="diag-card-desc">One endpoint. Every submission GEO-stamped, spam-filtered, and agent-aware.</p>
          </div>
        </div>

        <!-- CENTER: main Ollastack hub -->
        <div class="diag-hub">
          <div class="diag-hub-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="5" fill="#e11d48"/>
              <rect x="6" y="7" width="12" height="2" rx="1" fill="#fff"/>
              <rect x="6" y="11" width="12" height="2" rx="1" fill="#fff"/>
              <rect x="6" y="15" width="12" height="2" rx="1" fill="#fff"/>
            </svg>
          </div>
          <div class="diag-hub-name">OLLASTACK</div>
          <div class="diag-hub-sub">
            <span>ONE PLATFORM</span>
            <span>ONE BACKEND · ONE TOKEN</span>
            <span>ONE CONSOLE</span>
          </div>
        </div>

        <!-- Card 02: Agent Mail -->
        <div class="diag-card diag-card-left">
          <div class="diag-card-icon diag-card-icon-mail">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="1.8">
              <rect x="2" y="4" width="20" height="16" rx="3"/>
              <path d="M22 6L12 13L2 6"/>
            </svg>
          </div>
          <div class="diag-card-content">
            <div class="diag-card-header">
              <span class="diag-card-title">AGENT MAIL</span>
              <span class="diag-card-badge mono">02</span>
            </div>
            <p class="diag-card-desc">Real email inboxes your agents own. Send, receive, and reply over the API.</p>
          </div>
        </div>

        <!-- Card 03: Test Inboxes -->
        <div class="diag-card diag-card-right">
          <div class="diag-card-icon diag-card-icon-test">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
          </div>
          <div class="diag-card-content">
            <div class="diag-card-header">
              <span class="diag-card-title">TEST INBOXES</span>
              <span class="diag-card-badge mono">03</span>
            </div>
            <p class="diag-card-desc">Disposable inboxes for CI. Read OTPs, assert, and test every email with ease.</p>
          </div>
        </div>

        <!-- Bottom chip: TOKEN AUTH -->
        <div class="diag-aux diag-aux-bottom">
          <div class="diag-aux-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
            </svg>
          </div>
          <span class="diag-aux-text">SECURE BY DESIGN<br/>TOKEN AUTH</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       LIVE DEMO — form + captured submission card side by side
       ============================================================ -->
  <section class="live-demo">
    <div class="container">
      <div class="demo-card-container">
        <div class="demo-header">
          <span class="eyebrow-red mono">/ LIVE DEMO</span>
          <h2 class="display demo-title">See Ollastack in action.</h2>
          <p class="demo-subtitle">Submit a form and watch what happens.</p>
        </div>

        <div class="demo-flow-grid">
          <!-- Left: Interactive Form -->
          <div class="demo-form-panel">
            <form class="demo-form" id="geo-demo-form">
              <label class="demo-field">
                <span class="demo-field-label">Name</span>
                <input name="name" type="text" value="Ada Lovelace" required autocomplete="name" placeholder="Ada Lovelace" />
              </label>
              <label class="demo-field">
                <span class="demo-field-label">Email</span>
                <input name="email" type="email" value="ada@example.com" required autocomplete="email" placeholder="ada@example.com" />
              </label>
              <label class="demo-field">
                <span class="demo-field-label">Message</span>
                <textarea name="message" required rows="2" placeholder="Hello from my AI agent!">Hello from my AI agent!</textarea>
              </label>

              <button type="submit" class="btn btn-primary demo-submit-btn">
                Submit demo
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div class="demo-error" id="demo-error" hidden role="alert"></div>
            </form>
          </div>

          <!-- Red dashed connector arrow -->
          <div class="demo-arrow-wrap" aria-hidden="true">
            <div class="demo-dashed-arrow">
              <span class="dashed-line"></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <!-- Middle-Right: Result Card -->
          <div class="demo-result-panel">
            <div class="demo-result-card" id="demo-result-card">
              <div class="result-badge-banner">
                <span class="result-check-icon">✓</span>
                <span class="result-banner-text">Submission captured!</span>
              </div>
              <div class="result-rows" id="success-table">
                <div class="result-row">
                  <span class="result-row-label">📍 Location</span>
                  <span class="result-pill" id="res-location">Bengaluru, India 🇮🇳</span>
                </div>
                <div class="result-row">
                  <span class="result-row-label">🕒 Time</span>
                  <span class="result-row-val" id="res-time">May 18, 2025, 12:41 PM IST</span>
                </div>
                <div class="result-row">
                  <span class="result-row-label">🔘 Status</span>
                  <span class="result-status-green"><span class="status-dot-green"></span> Received</span>
                </div>
                <div class="result-row">
                  <span class="result-row-label">🪪 Lead ID</span>
                  <span class="result-row-mono" id="res-id">lead_01JXBZQ1KSK6Y2M7T9R1</span>
                </div>
              </div>
              <a href="#api-console" class="result-view-link">View full submission →</a>
            </div>
          </div>

          <!-- Far Right: Globe Graphic -->
          <div class="demo-globe-wrap" aria-hidden="true">
            <svg class="globe-svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="100" cy="100" r="75" stroke="#bfdbfe" stroke-width="1" stroke-dasharray="3 3"/>
              <ellipse cx="100" cy="100" rx="75" ry="30" stroke="#bfdbfe" stroke-width="1"/>
              <ellipse cx="100" cy="100" rx="30" ry="75" stroke="#bfdbfe" stroke-width="1"/>
              <ellipse cx="100" cy="100" rx="65" ry="65" stroke="#93c5fd" stroke-width="1" stroke-dasharray="2 4"/>
              <!-- Orbit nodes -->
              <circle cx="45" cy="60" r="3" fill="#ef4444"/>
              <circle cx="155" cy="65" r="3" fill="#ef4444"/>
              <circle cx="140" cy="145" r="3" fill="#ef4444"/>
              <circle cx="55" cy="140" r="3" fill="#ef4444"/>
              <!-- Orbital curved paths -->
              <path d="M 45 60 Q 100 20 155 65" stroke="#ef4444" stroke-width="1" stroke-dasharray="3 3" opacity="0.6"/>
              <path d="M 55 140 Q 100 180 140 145" stroke="#ef4444" stroke-width="1" stroke-dasharray="3 3" opacity="0.6"/>
            </svg>
            <div class="globe-center-emblem">
              <div class="globe-glow"></div>
              <div class="globe-badge">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" fill="#e11d48"/>
                  <rect x="6" y="7" width="12" height="2" rx="1" fill="#fff"/>
                  <rect x="6" y="11" width="12" height="2" rx="1" fill="#fff"/>
                  <rect x="6" y="15" width="12" height="2" rx="1" fill="#fff"/>
                </svg>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       ONE PLATFORM — three feature preview cards
       ============================================================ -->
  <section class="platform">
    <div class="container">
      <div class="platform-head">
        <div>
          <span class="eyebrow-red mono">/ ONE PLATFORM</span>
          <h2 class="display platform-title">Everything your agents can do.</h2>
          <p class="platform-sub">
            Forms in, mail out — one backend, one token system, one console.<br/>
            Each surface is in the OpenAPI spec your agent reads itself.
          </p>
        </div>
        <a class="btn btn-ghost btn-docs-pill" href="/docs">Explore all docs →</a>
      </div>

      <div class="platform-grid">
        <!-- Card 01: Headless Forms -->
        <article class="platform-card">
          <div class="platform-card-eyebrow">
            <span class="platform-pill-badge platform-pill-blue mono">01 FORMS</span>
          </div>
          <h3 class="platform-card-name">Headless forms</h3>
          <p class="platform-card-body">
            One endpoint. Every submission GEO-stamped, spam-filtered, and agent-aware.
          </p>
          <div class="platform-card-preview platform-card-preview-split">
            <div class="mini-form-mock">
              <div class="mini-form-bar"></div>
              <div class="mini-form-input"></div>
              <div class="mini-form-input"></div>
              <div class="mini-form-textarea"></div>
              <div class="mini-form-btn"></div>
            </div>
            <div class="mini-code-pane">
<pre class="code-preview"><span class="cp-method">POST</span> <span class="cp-url">/v1/forms/&#123;id&#125;/submit</span>
<span class="cp-key">Authorization:</span> <span class="cp-val">Bearer &#123;token&#125;</span>
<span class="cp-key">Content-Type:</span> <span class="cp-val">application/json</span>

<span class="cp-brace">&#123;</span>
  <span class="cp-field">"name"</span>: <span class="cp-str">"Ada"</span>,
  <span class="cp-field">"email"</span>: <span class="cp-str">"ada@example.com"</span>
<span class="cp-brace">&#125;</span></pre>
            </div>
          </div>
          <a class="platform-card-link mono" href="#api-console">→ Call it live</a>
        </article>

        <!-- Card 02: Agent Mail -->
        <article class="platform-card">
          <div class="platform-card-eyebrow">
            <span class="platform-pill-badge platform-pill-red mono">02 AGENT MAIL</span>
          </div>
          <h3 class="platform-card-name">Agent Mail</h3>
          <p class="platform-card-body">
            Real email inboxes your agents own.
          </p>
          <div class="platform-card-preview platform-card-preview-inbox">
            <div class="inbox-row inbox-row-header">
              <div class="inbox-addr-lockup">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M22 6L12 13L2 6"/></svg>
                <span class="inbox-addr">support@agent.ollastack.com</span>
              </div>
              <span class="inbox-count">3</span>
            </div>
            <div class="inbox-row">
              <div class="inbox-subject-lockup">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6L12 13L2 6"/></svg>
                <span class="inbox-subject">New message from user</span>
              </div>
              <div class="inbox-meta">2m ago</div>
            </div>
            <div class="inbox-row">
              <div class="inbox-subject-lockup">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 12h10M12 7v10"/></svg>
                <span class="inbox-subject">OTP is 364921</span>
              </div>
              <div class="inbox-meta">5m ago</div>
            </div>
            <div class="inbox-row">
              <div class="inbox-subject-lockup">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6L12 13L2 6"/></svg>
                <span class="inbox-subject">Welcome to Ollastack</span>
              </div>
              <div class="inbox-meta">12m ago</div>
            </div>
          </div>
          <a class="platform-card-link mono" href="/docs/agent-mail">→ View docs</a>
        </article>

        <!-- Card 03: Mail Testing for CI -->
        <article class="platform-card">
          <div class="platform-card-eyebrow">
            <span class="platform-pill-badge platform-pill-green mono">03 TEST INBOXES</span>
          </div>
          <h3 class="platform-card-name">Mail testing for CI</h3>
          <p class="platform-card-body">
            Disposable inboxes on @test.ollastack.com: read OTPs, assert, and test every email.
          </p>
          <div class="platform-card-preview platform-card-preview-ci">
            <div class="ci-row ci-row-head">
              <span class="ci-label">Inbox: test_01HXY2</span>
              <button class="ci-copy" type="button" aria-label="Copy">Copy</button>
            </div>
            <div class="ci-row ci-row-result">
              <span class="ci-check">OTP detected: 364921</span>
              <span class="ci-badge ci-badge-ok">Success</span>
            </div>
            <div class="ci-row ci-row-result">
              <span class="ci-check">Code extracted</span>
              <span class="ci-badge ci-badge-ok">Success</span>
            </div>
            <div class="ci-row ci-row-result">
              <span class="ci-check">Assertion passed</span>
              <span class="ci-badge ci-badge-ok">Success</span>
            </div>
          </div>
          <a class="platform-card-link mono" href="/docs/agent-mail#modes">→ View docs</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TRUSTED BY BUILDERS — logo row
       ============================================================ -->
  <section class="trusted">
    <div class="container">
      <p class="trusted-label mono">TRUSTED BY BUILDERS</p>
