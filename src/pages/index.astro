<script>
  // ---- Tab switching for code sample ----
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tabs-bar .tab");
  const panes = document.querySelectorAll<HTMLPreElement>(".code-pane");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const lang = tab.dataset.lang;
      tabs.forEach((t) => t.classList.toggle("active", t === tab));
      panes.forEach((p) => p.classList.toggle("hidden", p.dataset.lang !== lang));
    });
  });

  // ---- API console: capability tabs + LIVE Forms run + copy-curl ----
  const ctabs = document.querySelectorAll<HTMLButtonElement>(".console-tabs .ctab");
  const cpanels = document.querySelectorAll<HTMLElement>(".console-panel");
  ctabs.forEach((t) => {
    t.addEventListener("click", () => {
      const cap = t.dataset.cap;
      ctabs.forEach((x) => {
        const on = x === t;
        x.classList.toggle("active", on);
        x.setAttribute("aria-selected", on ? "true" : "false");
      });
      cpanels.forEach((p) => p.classList.toggle("hidden", p.dataset.cap !== cap));
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".console-copy").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.closest(".console-panel");
      const code = panel?.querySelector(".console-curl")?.textContent ?? "";
      navigator.clipboard
        .writeText(code.trim())
        .then(() => {
          const o = btn.textContent;
          btn.textContent = "Copied ✓";
          setTimeout(() => { btn.textContent = o; }, 1200);
        })
        .catch(() => {});
    });
  });

  const consoleRun = document.querySelector<HTMLButtonElement>('.console-run[data-run="forms"]');
  const consoleRes = document.querySelector<HTMLElement>('.console-res[data-res="forms"]');
  const CONSOLE_SANDBOX = "https://login.ollastack.com/api/submit/uiwaivrpteebnhtt";
  consoleRun?.addEventListener("click", async () => {
    if (!consoleRes) return;
    const original = consoleRun.innerHTML;
    consoleRun.disabled = true;
    consoleRun.innerHTML = "Running…";
    consoleRes.innerHTML = '<span class="muted"># POST /api/submit/contact …</span>';
    try {
      const res = await fetch(CONSOLE_SANDBOX, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: "Ada", email: "ada@example.com", message: "Tell me more" }),
      });
      const data = (await res.json().catch(() => ({}))) as { success?: boolean; id?: string };
      const g = detectedGeo ?? {};
      const shaped = {
        success: data?.success ?? res.ok,
        id: data?.id ?? "sub_…",
        country: g.country_code ?? g.country_name ?? "—",
        city: g.city ?? "—",
      };
      consoleRes.innerHTML =
        `<span class="muted"># HTTP ${res.status} · real response</span>\n` +
        '<span class="ok">' + escapeHtml(JSON.stringify(shaped, null, 2)) + "</span>";
    } catch (err) {
      consoleRes.innerHTML = '<span class="muted"># network error — please try again</span>';
    } finally {
      consoleRun.disabled = false;
      consoleRun.innerHTML = original;
    }
  });

  const testRun = document.querySelector<HTMLButtonElement>('.console-run[data-run="test"]');
  const testRes = document.querySelector<HTMLElement>('.console-res[data-res="test"]');
  const DEMO_MAIL = "https://login.ollastack.com/api/demo/mail";
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  testRun?.addEventListener("click", async () => {
    if (!testRes) return;
    const original = testRun.innerHTML;
    testRun.disabled = true;
    testRun.innerHTML = "Running…";
    testRes.innerHTML = '<span class="muted"># 📤 a verification email is on its way…</span>';
    try {
      const [res] = await Promise.all([
        fetch(DEMO_MAIL, { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }),
        sleep(900),
      ]);
      const body = (await res.json().catch(() => ({}))) as {
        data?: { to?: string; subject?: string; fromAddress?: string; codes?: string[]; links?: string[]; otp?: string | null };
        error?: { message?: string };
      };
      const d = body?.data;
      if (!res.ok || !d) {
        testRes.innerHTML = '<span class="muted"># ' + escapeHtml(body?.error?.message ?? "please try again") + "</span>";
