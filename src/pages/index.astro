      const shaped = { to: d.to, subject: d.subject, from: d.fromAddress, codes: d.codes, links: d.links };
      testRes.innerHTML =
        '<span class="ok"># ✓ arrived — parsed by the live engine</span>\n' +
        '<span class="ok">' + escapeHtml(JSON.stringify(shaped, null, 2)) + "</span>\n" +
        '<span class="muted"># codes[0] = </span><span class="ok">' + escapeHtml(d.otp ?? "—") + '</span><span class="muted"> ← your OTP</span>';
    } catch (err) {
      testRes.innerHTML = '<span class="muted"># network error — please try again</span>';
    } finally {
      testRun.disabled = false;
      testRun.innerHTML = original;
    }
