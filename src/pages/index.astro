---
import Base from "../layouts/Base.astro";
const APP = "https://login.form4dev.com";
---

<Base current="home">
  <!-- Hero ----------------------------------------------------------- -->
  <section class="hero">
    <div class="container-wide hero-inner">
      <span class="chip mono">
        <span class="dot"></span>
        Forms as endpoints — built for developers
      </span>
      <h1 class="display headline">
        Forms<br />
        for developers.<br />
        <span class="accent-mark">Without the BS.</span>
      </h1>
      <p class="subhead">
        Point your HTML <code class="inline-code">action=</code> at a Form4Dev endpoint and you're done. Submissions land in a real inbox, fire webhooks, run through spam + captcha, and export anywhere — without you running a backend.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href={`${APP}/register`}>
          Start free
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="/docs">Read the docs</a>
        <span class="kbd-hint">
          <span class="kbd">⌘</span><span class="kbd">K</span> to search docs
        </span>
      </div>

      <!-- Terminal demo -->
      <div class="terminal" aria-label="Quickstart terminal">
        <div class="term-chrome">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="term-title mono">~ ship a form in 30 seconds</span>
        </div>
        <pre class="term-body"><span class="prompt">$</span> <span class="cmd">curl</span> -X POST https://login.form4dev.com/api/submit/<span class="hl">contact</span> \
    -H <span class="str">"Content-Type: application/json"</span> \
    -d <span class="str">'{`{`}"name":"Ada","message":"hi"{`}`}'</span>
<span class="ok">{`{`} "success": true, "id": "sub_8f2…" {`}`}</span>

<span class="prompt">$</span> <span class="cmd">tail</span> /forms/contact          <span class="comment"># real-time inbox</span>
<span class="cur">▍</span></pre>
      </div>
    </div>
  </section>

  <!-- Trusted by ---------------------------------------------------- -->
  <section class="trust">
    <div class="container-wide trust-inner">
      <span class="trust-label mono">Trusted by indie devs and startups shipping fast</span>
      <div class="trust-stats">
        <div><strong>50ms</strong><span>p99 submit latency</span></div>
        <div><strong>99.998%</strong><span>uptime (30d)</span></div>
        <div><strong>13</strong><span>field types out of the box</span></div>
        <div><strong>0</strong><span>servers you have to run</span></div>
      </div>
    </div>
  </section>

  <!-- Features ------------------------------------------------------ -->
  <section class="features">
    <div class="container-wide">
      <div class="section-head">
        <span class="eyebrow mono">/ features</span>
        <h2 class="display section-title">Everything you'd build yourself.<br />Without doing any of it.</h2>
      </div>

      <div class="feature-grid">
        <article class="card feature">
          <div class="ico ico-shield"></div>
          <h3>Spam, locked down by default</h3>
          <p>Honeypot, regex blocklist, IP blocking, Akismet — and one-click <strong>Cloudflare Turnstile</strong>, <strong>reCAPTCHA</strong>, or <strong>hCaptcha</strong>.</p>
        </article>

        <article class="card feature">
          <div class="ico ico-bolt"></div>
          <h3>Webhooks with retry + replay</h3>
          <p>HMAC-signed POSTs, exponential backoff, full delivery history. No more "did it fire?" debugging at 2am.</p>
        </article>

        <article class="card feature">
          <div class="ico ico-form"></div>
          <h3>13 field types, server-validated</h3>
          <p>email · url · phone · date · select · radio · file · hidden · multi-step + <code>showIf</code>. The server enforces the schema, not the browser.</p>
        </article>

        <article class="card feature">
          <div class="ico ico-card"></div>
          <h3>Razorpay payments</h3>
          <p>Turn any form into a paid form. Order created server-side, signature-verified callback, post-actions only fire on paid.</p>
        </article>

        <article class="card feature">
          <div class="ico ico-plug"></div>
          <h3>Slack, Discord, Telegram, Sheets</h3>
          <p>One-click integrations + generic webhooks for everything else. Send a submission anywhere your team already lives.</p>
        </article>

        <article class="card feature">
          <div class="ico ico-key"></div>
          <h3>Personal API tokens</h3>
          <p>Bearer-auth all the way through. Scope by capability, rotate from the dashboard, revoke instantly.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Code split ----------------------------------------------------- -->
  <section class="code-split">
    <div class="container-wide split-inner">
      <div>
        <span class="eyebrow mono">/ react sdk</span>
        <h2 class="display section-title">One hook.<br />Type-safe.</h2>
        <p class="subhead-sm">
          <code class="inline-code">@form4dev/react</code> exposes <code class="inline-code">useForm</code> with a discriminated-union response so you handle success and per-field errors without guessing. Zero deps beyond React.
        </p>
        <div class="code-meta mono">
          <span>react ≥ 16.8</span>
          <span>·</span>
          <span>~2.1KB gzipped</span>
        </div>
      </div>
      <pre class="code-panel mono"><span class="ln k">import</span> <span class="ln pn">{`{`} useForm, ValidationError {`}`}</span> <span class="ln k">from</span> <span class="ln s">"@form4dev/react"</span><span class="ln p">;</span>

<span class="ln k">export function</span> <span class="ln pn">Contact</span><span class="ln p">() {`{`}</span>
  <span class="ln k">const</span> <span class="ln p">[</span>state, handleSubmit<span class="ln p">]</span> <span class="ln p">=</span> <span class="ln pn">useForm</span><span class="ln p">(</span><span class="ln s">"contact"</span><span class="ln p">);</span>
  <span class="ln k">if</span> <span class="ln p">(</span>state.succeeded<span class="ln p">)</span> <span class="ln k">return</span> <span class="ln s">&lt;p&gt;Thanks — we'll be in touch.&lt;/p&gt;</span><span class="ln p">;</span>

  <span class="ln k">return</span> <span class="ln p">(</span>
    <span class="ln s">&lt;form onSubmit={`{`}handleSubmit{`}`}&gt;</span>
      <span class="ln s">&lt;input name=<span class="ln st">"email"</span> type=<span class="ln st">"email"</span> required/&gt;</span>
      <span class="ln s">&lt;ValidationError errors={`{`}state.errors{`}`} field=<span class="ln st">"email"</span>/&gt;</span>
      <span class="ln s">&lt;textarea name=<span class="ln st">"message"</span> required/&gt;</span>
      <span class="ln s">&lt;button disabled={`{`}state.submitting{`}`}&gt;Send&lt;/button&gt;</span>
    <span class="ln s">&lt;/form&gt;</span>
  <span class="ln p">);</span>
<span class="ln p">{`}`}</span></pre>
    </div>
  </section>

  <!-- Big CTA -------------------------------------------------------- -->
  <section class="cta">
    <div class="container">
      <div class="cta-card">
        <h2 class="display cta-title">Ship the form. Skip the backend.</h2>
        <p class="cta-sub">Free forever for hobby projects. No credit card. Inbox + webhooks + integrations on every plan.</p>
        <div class="cta-actions">
          <a class="btn btn-accent btn-lg" href={`${APP}/register`}>
            Create your first form
          </a>
          <a class="btn btn-ghost btn-lg" href="/pricing">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding: 88px 0 56px; }
  .hero-inner { display: flex; flex-direction: column; align-items: flex-start; }
  .headline {
    font-size: 88px;
    margin: 22px 0 24px;
    letter-spacing: -0.04em;
    line-height: 0.96;
    max-width: 12ch;
  }
  .accent-mark {
    background: var(--accent);
    padding: 0 12px;
    border-radius: 6px;
    color: var(--accent-ink);
  }
  .subhead {
    font-size: 19px;
    color: var(--muted);
    line-height: 1.55;
    max-width: 620px;
    margin: 0 0 32px;
  }
  .inline-code {
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    padding: 0 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }
  .kbd-hint {
    color: var(--muted);
    font-size: 12px;
    margin-left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .chip .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(196, 252, 92, 0.18);
  }

  /* Terminal */
  .terminal {
    width: 100%;
    max-width: 920px;
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 24px 48px -16px rgba(10, 10, 10, 0.18);
    font-family: var(--font-mono);
  }
  .term-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid #1f1f1f;
    background: #0e0e0e;
  }
  .term-chrome .dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
  }
  .term-chrome .red { background: #ff5f56; }
  .term-chrome .yellow { background: #ffbd2e; }
  .term-chrome .green { background: #27c93f; }
  .term-title { color: #777; font-size: 12px; margin-left: auto; }
  .term-body {
    padding: 22px 26px;
    font-size: 13.5px;
    line-height: 1.7;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .term-body .prompt { color: var(--accent); margin-right: 8px; }
  .term-body .cmd { color: #fff; font-weight: 600; }
  .term-body .str { color: var(--code-str); }
  .term-body .hl { color: var(--accent); font-weight: 500; }
  .term-body .ok { color: var(--accent); display: inline-block; margin-top: 6px; }
  .term-body .comment { color: var(--code-com); }
  .term-body .cur {
    color: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Trust strip */
  .trust { padding: 48px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg-elev); }
  .trust-inner { display: flex; flex-direction: column; gap: 24px; }
  .trust-label {
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .trust-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line-2);
  }
  .trust-stats > div {
    padding: 24px 0;
    border-right: 1px solid var(--line-2);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .trust-stats > div:last-child { border-right: 0; }
  .trust-stats strong {
    font-family: var(--font-sans);
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .trust-stats span {
    font-size: 12px;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  /* Sections */
  .section-head { margin-bottom: 40px; max-width: 720px; }
  .eyebrow {
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-block;
    margin-bottom: 14px;
  }
  .section-title {
    font-size: 42px;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .features { padding: 88px 0; }

  /* Feature grid */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .feature {
    padding: 24px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .feature:hover {
    transform: translateY(-2px);
    border-color: #d6d6d2;
  }
  .feature h3 {
    font-size: 16px;
    margin: 18px 0 8px;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .feature p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .feature p strong { color: var(--ink); font-weight: 500; }

  .ico {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--ink);
    position: relative;
  }
  .ico::after {
    content: "";
    position: absolute;
    inset: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: 18px;
  }
  .ico-shield::after { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4fc5c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z'/><path d='M9 12l2 2 4-4'/></svg>"); }
  .ico-bolt::after   { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4fc5c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M13 2L3 14h7l-1 8 11-13h-7l1-7z'/></svg>"); }
  .ico-form::after   { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4fc5c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='4' rx='1'/><rect x='3' y='12' width='18' height='4' rx='1'/><circle cx='7' cy='14' r='1.2' fill='%23c4fc5c'/></svg>"); }
  .ico-card::after   { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4fc5c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3 10h18'/><path d='M7 15h4'/></svg>"); }
  .ico-plug::after   { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4fc5c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 2v4M15 2v4'/><rect x='6' y='6' width='12' height='8' rx='2'/><path d='M12 14v4M9 22h6'/></svg>"); }
  .ico-key::after    { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4fc5c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='8' cy='12' r='4'/><path d='M12 12h10M19 12v4M16 12v3'/></svg>"); }

  /* Code split */
  .code-split { padding: 56px 0 88px; background: var(--bg-sunken); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .split-inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  .subhead-sm {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 420px;
    margin: 0 0 18px;
  }
  .code-meta {
    color: var(--muted);
    font-size: 12px;
    display: inline-flex;
    gap: 8px;
  }
  .code-panel {
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: 14px;
    padding: 22px 26px;
    font-size: 13.5px;
    line-height: 1.7;
    overflow-x: auto;
    box-shadow: 0 24px 48px -16px rgba(10, 10, 10, 0.18);
    margin: 0;
    white-space: pre;
  }
  .code-panel .k { color: var(--code-key); font-weight: 500; }
  .code-panel .s { color: var(--code-str); }
  .code-panel .st { color: var(--code-num); }
  .code-panel .p { color: var(--code-pun); }
  .code-panel .pn { color: #fff; }

  /* CTA */
  .cta { padding: 80px 0; }
  .cta-card {
    background: var(--ink);
    color: #fff;
    border-radius: 20px;
    padding: 64px 56px;
    text-align: center;
    box-shadow: 0 24px 48px -16px rgba(10, 10, 10, 0.18);
  }
  .cta-title {
    font-size: 56px;
    color: #fff;
    margin: 0 0 16px;
    letter-spacing: -0.03em;
  }
  .cta-sub {
    color: #b3b3b3;
    font-size: 17px;
    max-width: 520px;
    margin: 0 auto 32px;
  }
  .cta-actions {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .cta .btn-ghost { color: #fff; border-color: #2a2a2a; }
  .cta .btn-ghost:hover { background: #1a1a1a; }

  @media (max-width: 960px) {
    .headline { font-size: 60px; }
    .feature-grid { grid-template-columns: 1fr 1fr; }
    .split-inner { grid-template-columns: 1fr; }
    .trust-stats { grid-template-columns: 1fr 1fr; }
    .trust-stats > div:nth-child(2) { border-right: 0; }
    .trust-stats > div:nth-child(1),
    .trust-stats > div:nth-child(2) { border-bottom: 1px solid var(--line-2); }
    .cta-title { font-size: 38px; }
    .cta-card { padding: 40px 24px; }
  }
  @media (max-width: 600px) {
    .headline { font-size: 44px; }
    .feature-grid { grid-template-columns: 1fr; }
    .section-title { font-size: 30px; }
  }
</style>
</Base>
