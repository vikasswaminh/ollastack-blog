<script>
  // ---- Tab switching for the relocated code sample ----
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tabs-bar .tab");
  const panes = document.querySelectorAll<HTMLPreElement>(".code-pane");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const lang = tab.dataset.lang;
      tabs.forEach((t) => t.classList.toggle("active", t === tab));
      panes.forEach((p) => p.classList.toggle("hidden", p.dataset.lang !== lang));
    });
  });

  // ---- API console: capability tabs + LIVE Forms run + copy-curl ----
  const ctabs = document.querySelectorAll<HTMLButtonElement>(".console-tabs .ctab");
  const cpanels = document.querySelectorAll<HTMLElement>(".console-panel");
  ctabs.forEach((t) => {
    t.addEventListener("click", () => {
      const cap = t.dataset.cap;
      ctabs.forEach((x) => {
        const on = x === t;
        x.classList.toggle("active", on);
        x.setAttribute("aria-selected", on ? "true" : "false");
      });
      cpanels.forEach((p) => p.classList.toggle("hidden", p.dataset.cap !== cap));
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".console-copy").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.closest(".console-panel");
      const code = panel?.querySelector(".console-curl")?.textContent ?? "";
      navigator.clipboard
        .writeText(code.trim())
        .then(() => {
          const o = btn.textContent;
          btn.textContent = "Copied ✓";
          setTimeout(() => { btn.textContent = o; }, 1200);
        })
        .catch(() => {});
    });
  });

  // The Forms tab runs a REAL anonymous submission against a CORS-open
  // sandbox form (captcha off) and renders the live response shape.
  const consoleRun = document.querySelector<HTMLButtonElement>('.console-run[data-run="forms"]');
  const consoleRes = document.querySelector<HTMLElement>('.console-res[data-res="forms"]');
  const CONSOLE_SANDBOX = "https://login.form4dev.com/api/submit/uiwaivrpteebnhtt";
  consoleRun?.addEventListener("click", async () => {
    if (!consoleRes) return;
    const original = consoleRun.innerHTML;
    consoleRun.disabled = true;
    consoleRun.innerHTML = "Running…";
    consoleRes.innerHTML = '<span class="muted"># POST /api/submit/contact …</span>';
    try {
      const res = await fetch(CONSOLE_SANDBOX, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: "Ada", email: "ada@example.com", message: "Tell me more" }),
      });
      const data = (await res.json().catch(() => ({}))) as { success?: boolean; id?: string };
      const g = detectedGeo ?? {};
      const shaped = {
        success: data?.success ?? res.ok,
        id: data?.id ?? "sub_…",
        country: g.country_code ?? g.country_name ?? "—",
        city: g.city ?? "—",
      };
      consoleRes.innerHTML =
        `<span class="muted"># HTTP ${res.status} · real response</span>\n` +
        '<span class="ok">' + escapeHtml(JSON.stringify(shaped, null, 2)) + "</span>";
    } catch (err) {
      consoleRes.innerHTML = '<span class="muted"># network error — please try again</span>';
    } finally {
      consoleRun.disabled = false;
      consoleRun.innerHTML = original;
    }
  });

  // The Test-inboxes tab runs the REAL parse/extract engine via a public,
  // no-auth, rate-limited demo endpoint (no token in the browser). Staged
  // reveal so the OTP feels like it's arriving live.
  const testRun = document.querySelector<HTMLButtonElement>('.console-run[data-run="test"]');
  const testRes = document.querySelector<HTMLElement>('.console-res[data-res="test"]');
  const DEMO_MAIL = "https://login.form4dev.com/api/demo/mail";
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  testRun?.addEventListener("click", async () => {
    if (!testRes) return;
    const original = testRun.innerHTML;
    testRun.disabled = true;
    testRun.innerHTML = "Running…";
    testRes.innerHTML = '<span class="muted"># 📤 a verification email is on its way…</span>';
    try {
      const [res] = await Promise.all([
        fetch(DEMO_MAIL, { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }),
        sleep(900),
      ]);
      const body = (await res.json().catch(() => ({}))) as {
        data?: { to?: string; subject?: string; fromAddress?: string; codes?: string[]; links?: string[]; otp?: string | null };
        error?: { message?: string };
      };
      const d = body?.data;
      if (!res.ok || !d) {
        testRes.innerHTML = '<span class="muted"># ' + escapeHtml(body?.error?.message ?? "please try again") + "</span>";
        return;
      }
      testRes.innerHTML = '<span class="muted"># 📨 delivering to ' + escapeHtml(d.to ?? "") + "…</span>";
      await sleep(650);
      const shaped = { to: d.to, subject: d.subject, from: d.fromAddress, codes: d.codes, links: d.links };
      testRes.innerHTML =
        '<span class="ok"># ✓ arrived — parsed by the live engine</span>\n' +
        '<span class="ok">' + escapeHtml(JSON.stringify(shaped, null, 2)) + "</span>\n" +
        '<span class="muted"># codes[0] = </span><span class="ok">' + escapeHtml(d.otp ?? "—") + '</span><span class="muted"> ← your OTP</span>';
    } catch (err) {
      testRes.innerHTML = '<span class="muted"># network error — please try again</span>';
    } finally {
      testRun.disabled = false;
      testRun.innerHTML = original;
    }
  });

  // ---- Geo demo: detect visitor location via ipapi.co, then on
  //      form submit show a success card with the captured geo.
  //      ipapi.co is free for low volume and CORS-open; same shape
  //      of data form4dev attaches from Cloudflare visitor-location
  //      headers on the server side. ----
  type GeoData = {
    city?: string;
    region?: string;
    country_name?: string;
    country_code?: string;
    postal?: string;
    latitude?: number;
    longitude?: number;
    timezone?: string;
  };

  let detectedGeo: GeoData | null = null;
  const previewEl = document.getElementById("geo-preview");
  const previewText = previewEl?.querySelector<HTMLElement>(".geo-preview-text");
  const previewSpinner = previewEl?.querySelector<HTMLElement>(".geo-spinner");
  const form = document.getElementById("geo-demo-form") as HTMLFormElement | null;
  const successEl = document.getElementById("demo-success");
  const successTable = document.getElementById("success-table");
  const resetBtn = document.getElementById("demo-reset");

  async function detectGeo() {
    try {
      const res = await fetch("https://ipapi.co/json/");
      if (!res.ok) throw new Error("geo http " + res.status);
      const data = (await res.json()) as GeoData;
      detectedGeo = data;
      if (previewText && data.city) {
        previewText.innerHTML = `Your location: <strong>${escapeHtml(data.city)}${
          data.region ? ", " + escapeHtml(data.region) : ""
        }, ${escapeHtml(data.country_name ?? data.country_code ?? "—")}</strong> — this is what your inbox will see.`;
      } else if (previewText) {
        previewText.textContent = "Your location will be captured on submit.";
      }
      if (previewSpinner) previewSpinner.classList.add("ready");
    } catch (err) {
      if (previewText) previewText.textContent = "Geo detection unavailable — form4dev still captures it server-side via Cloudflare headers.";
      if (previewSpinner) previewSpinner.classList.add("ready");
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
  }

  function row(label: string, value: string | undefined | null): string {
    if (!value) return "";
    return `<dt>${escapeHtml(label)}</dt><dd>${escapeHtml(String(value))}</dd>`;
  }

  function showSuccess(payload: Record<string, string>, submissionId: string) {
    if (!successTable) return;
    const g = detectedGeo ?? {};
    successTable.innerHTML = [
      row("submission id", submissionId),
      row("name", payload.name),
      row("email", payload.email),
      row("message", payload.message),
      row("country", g.country_name ?? g.country_code),
      row("city", g.city),
      row("region", g.region),
      row("postal", g.postal),
      row("lat / long", g.latitude && g.longitude ? `${g.latitude}, ${g.longitude}` : null),
      row("timezone", g.timezone),
    ].join("");
    form?.setAttribute("hidden", "");
    previewEl?.setAttribute("hidden", "");
    errorEl?.setAttribute("hidden", "");
    successEl?.removeAttribute("hidden");
  }

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.removeAttribute("hidden");
  }

  function reset() {
    successEl?.setAttribute("hidden", "");
    errorEl?.setAttribute("hidden", "");
    form?.removeAttribute("hidden");
    previewEl?.removeAttribute("hidden");
    form?.reset();
  }

  const errorEl = document.getElementById("demo-error");
  // The real form4dev endpoint this page POSTs to. Form id
  // msJu9W4AcmTop0H34mlt1, locked to https://form4dev.com origin,
  // notify_email vikas@networkershome.com. captchaRequired=false
  // so the demo isn't blocked by a security check; per-IP rate
  // limit + ML quarantine still apply.
  const SUBMIT_ENDPOINT = "https://login.form4dev.com/api/submit/uiwaivrpteebnhtt";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload: Record<string, string> = {};
    fd.forEach((v, k) => (payload[k] = String(v)));

    errorEl?.setAttribute("hidden", "");
    const btn = form.querySelector<HTMLButtonElement>(".demo-submit");
    const originalHtml = btn?.innerHTML;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = "Submitting…";
    }

    try {
      const res = await fetch(SUBMIT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({} as { id?: string; error?: { message?: string } }));
      if (!res.ok) {
        const msg = data?.error?.message ?? `Submit failed (HTTP ${res.status}). Please try again.`;
        showError(msg);
        return;
      }
      showSuccess(payload, data?.id ?? "sub_demo");
    } catch (err) {
      showError("Network error — please try again.");
    } finally {
      if (btn && originalHtml) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }
  });

  resetBtn?.addEventListener("click", reset);

  detectGeo();
</script>

