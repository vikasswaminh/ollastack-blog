  // ---- Geo demo ----
  type GeoData = {
    city?: string;
    region?: string;
    country_name?: string;
    country_code?: string;
    postal?: string;
    latitude?: number;
    longitude?: number;
    timezone?: string;
  };

  let detectedGeo: GeoData | null = null;
  const previewEl = document.getElementById("geo-preview");
  const previewText = previewEl?.querySelector<HTMLElement>(".geo-preview-text");
  const previewSpinner = previewEl?.querySelector<HTMLElement>(".geo-spinner");
  const form = document.getElementById("geo-demo-form") as HTMLFormElement | null;
  const successEl = document.getElementById("demo-success");
  const placeholderEl = document.getElementById("demo-placeholder");
  const successTable = document.getElementById("success-table");
  const errorEl = document.getElementById("demo-error");

  async function detectGeo() {
    try {
      const res = await fetch("https://ipapi.co/json/");
      if (!res.ok) throw new Error("geo http " + res.status);
      const data = (await res.json()) as GeoData;
      detectedGeo = data;
      const locEl = document.getElementById("res-location");
      if (locEl && data.city) {
        locEl.textContent = `${data.city}, ${data.country_name ?? data.country_code ?? ""}`;
      }
    } catch (err) {
      // Fallback is already Bengaluru, India
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
  }

  function showSuccess(payload: Record<string, string>, submissionId: string) {
    const idEl = document.getElementById("res-id");
    const timeEl = document.getElementById("res-time");
    const cardEl = document.getElementById("demo-result-card");
    if (idEl) idEl.textContent = submissionId;
    if (timeEl) {
      const now = new Date();
      timeEl.textContent = now.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) +
        ", " + now.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    }
    if (cardEl) {
      cardEl.style.transform = "scale(1.02)";
      setTimeout(() => { cardEl.style.transform = "none"; }, 300);
    }
  }

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.removeAttribute("hidden");
  }

  const SUBMIT_ENDPOINT = "https://login.ollastack.com/api/submit/uiwaivrpteebnhtt";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload: Record<string, string> = {};
    fd.forEach((v, k) => { payload[k] = String(v); });
    const submitBtn = form.querySelector<HTMLButtonElement>(".demo-submit-btn");
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Sending…"; }
    try {
      const res = await fetch(SUBMIT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...payload, _geo: detectedGeo }),
      });
      const data = (await res.json().catch(() => ({}))) as { success?: boolean; id?: string; message?: string };
      if (!res.ok) { showError(data?.message ?? "Submission failed. Please try again."); return; }
      showSuccess(payload, data?.id ?? "lead_01JXBZQ1KSK6Y2M7T9R1");
    } catch (err) {
      showError("Network error — please try again.");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Submit demo <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      }
    }
  });

  detectGeo();
</script>

