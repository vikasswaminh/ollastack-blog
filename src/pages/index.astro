---
import Base from "../layouts/Base.astro";
const APP = "https://login.form4dev.com";
---

<Base current="home">
  <!-- =============================================================
       HERO — left-aligned headline + subhead + CTA + tabbed code
       (Announcement banner is rendered site-wide by Base.astro,
       above the nav.)
       ============================================================= -->
  <section class="hero dot-grid">
    <div class="container hero-inner">
      <span class="chip mono">
        <span class="dot"></span>
        forms · for developers · and AI agents
      </span>

      <h1 class="display headline">
        The form backend<br/>
        you'd build yourself.<br/>
        <span class="muted">If you had the time.</span>
      </h1>

      <p class="subhead">
        Point your HTML <code class="inline-code">action=</code> at a Form4Dev endpoint.
        Submissions land in a real inbox, fire signed webhooks, run through spam +
        captcha, and export anywhere — without you running a backend.
      </p>

      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg plausible-event-name=Signup+CTA plausible-event-location=hero" href={`${APP}/register`}>
          Start free
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="/docs">Read the docs</a>
      </div>

      <!-- Tabbed code sample — Daytona pattern -->
      <div class="code-tabs">
        <div class="tabs-bar">
          <button class="tab active" data-lang="curl">cURL</button>
          <button class="tab" data-lang="js">fetch</button>
          <button class="tab" data-lang="html">HTML</button>
          <button class="tab" data-lang="react">React</button>
          <button class="tab" data-lang="bearer">Agent (Bearer) 🤖</button>
          <span class="tabs-spacer"></span>
          <span class="tabs-meta mono">$ ship a form in 30 seconds</span>
        </div>

        <pre class="code-pane" data-lang="curl"><span class="prompt">$</span> <span class="cmd">curl</span> -X POST https://login.form4dev.com/api/submit/<span class="hl">contact</span> \
    -H <span class="str">"Content-Type: application/json"</span> \
    -d <span class="str">{`'{"name":"Ada","message":"hi"}'`}</span>

<span class="ok">{`{"success": true, "id": "sub_8f2…"}`}</span></pre>

        <pre class="code-pane hidden" data-lang="js"><span class="key">await</span> fetch(<span class="str">"https://login.form4dev.com/api/submit/contact"</span>, {`{`}
  method: <span class="str">"POST"</span>,
  headers: {`{`} <span class="str">"Content-Type"</span>: <span class="str">"application/json"</span> {`}`},
  body: JSON.stringify({`{`} name, email, message {`}`}),
{`}`});</pre>

        <pre class="code-pane hidden" data-lang="html"><span class="pun">{`<form action=`}</span><span class="str">"https://login.form4dev.com/api/submit/contact"</span> method=<span class="str">"POST"</span><span class="pun">{`>`}</span>
  <span class="pun">{`<input name=`}</span><span class="str">"email"</span> type=<span class="str">"email"</span> required<span class="pun">{`/>`}</span>
  <span class="pun">{`<textarea name=`}</span><span class="str">"message"</span> required<span class="pun">{`/>`}</span>
  <span class="pun">{`<button>`}</span>Send<span class="pun">{`</button>`}</span>
<span class="pun">{`</form>`}</span></pre>

        <pre class="code-pane hidden" data-lang="react"><span class="key">import</span> {`{`} useForm {`}`} <span class="key">from</span> <span class="str">"@form4dev/react"</span>;

<span class="key">export function</span> <span class="fn">Contact</span>() {`{`}
  <span class="key">const</span> [state, handleSubmit] = <span class="fn">useForm</span>(<span class="str">"contact"</span>);
  <span class="key">if</span> (state.succeeded) <span class="key">return</span> <span class="str">{`<p>Thanks!</p>`}</span>;
  <span class="key">return</span> (
    <span class="str">{`<form onSubmit={handleSubmit}>...</form>`}</span>
  );
{`}`}</pre>

        <pre class="code-pane hidden" data-lang="bearer"><span class="prompt">$</span> <span class="cmd">curl</span> -X POST https://login.form4dev.com/api/submit/<span class="hl">contact</span> \
    -H <span class="str">"Authorization: Bearer fmd_…"</span> \
    -H <span class="str">"Content-Type: application/json"</span> \
    -d <span class="str">{`'{"name":"Ada","message":"hi"}'`}</span>

<span class="ok">{`{"success": true, "id": "sub_8f2…"}`}</span>
<span class="muted"># submission stamped 🤖 agent — skips captcha + spam pipeline
# token must belong to the form's owner (cross-tenant guard)</span></pre>
      </div>

      <p class="hero-note mono">
        Building an agent? See <a href="/docs/agents">/docs/agents</a> — Bearer auth, audit log, cross-tenant guard.
      </p>
    </div>
  </section>

  <!-- =============================================================
       3. PRICING — 3 tier USD plan
       ============================================================= -->
  <section class="pricing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">/ pricing</span>
        <h2 class="display section-title">
          Honest pricing.<br/>
          Pay for submissions, not seats.
        </h2>
        <p class="section-sub">
          Hard limits, no overage charges. If you hit the cap, submissions queue —
          they don't disappear, they don't auto-bill you.
        </p>
      </div>

      <div class="price-grid">
        <article class="price-card">
          <header class="price-head">
            <h3 class="price-name">Free</h3>
            <p class="price-amount"><strong>$0</strong> <span class="muted">/ month</span></p>
            <p class="price-blurb">For hobby projects and side hustles.</p>
          </header>
          <ul class="price-feats">
            <li><strong>100</strong> submissions / month</li>
            <li>Unlimited forms</li>
            <li>Honeypot + per-IP rate limit</li>
            <li>Webhooks (HMAC + 5-retry backoff)</li>
            <li>CSV / JSON / Excel export</li>
            <li>Slack / Discord / Telegram / Mailchimp</li>
            <li>Public OpenAPI 3.1 spec</li>
          </ul>
          <a class="btn btn-ghost btn-lg price-cta plausible-event-name=Signup+CTA plausible-event-location=pricing-free plausible-event-plan=free" href={`${APP}/register`}>Start free</a>
        </article>

        <article class="price-card price-card-pop">
          <span class="price-pop-tag mono">most popular</span>
          <header class="price-head">
            <h3 class="price-name">Starter</h3>
            <p class="price-amount"><strong>$5</strong> <span class="muted">/ month</span></p>
            <p class="price-blurb">For indie devs and shipping freelancers.</p>
          </header>
          <ul class="price-feats">
            <li><strong>250</strong> submissions / month</li>
            <li>Everything in Free</li>
            <li>CAPTCHA (Turnstile / hCaptcha / reCAPTCHA)</li>
            <li>Multi-step + conditional logic</li>
            <li>Per-form autoresponder</li>
            <li>Per-form analytics (geo, spam, trend)</li>
            <li>AI-agent Bearer tokens with audit</li>
            <li>Email support</li>
          </ul>
          <a class="btn btn-primary btn-lg price-cta plausible-event-name=Signup+CTA plausible-event-location=pricing-starter plausible-event-plan=starter" href={`${APP}/register?plan=starter`}>Get Starter</a>
        </article>

        <article class="price-card">
          <header class="price-head">
            <h3 class="price-name">Pro</h3>
            <p class="price-amount"><strong>$10</strong> <span class="muted">/ month</span></p>
            <p class="price-blurb">For production teams shipping at scale.</p>
          </header>
          <ul class="price-feats">
            <li><strong>1,000</strong> submissions / month</li>
            <li>Everything in Starter</li>
            <li>Custom SMTP (encrypted at rest, auto-fallback)</li>
            <li>Submission retention policies</li>
            <li>Razorpay payment-required forms</li>
            <li>Org members + cross-form inbox</li>
            <li>Priority support</li>
          </ul>
          <a class="btn btn-ghost btn-lg price-cta plausible-event-name=Signup+CTA plausible-event-location=pricing-pro plausible-event-plan=pro" href={`${APP}/register?plan=pro`}>Get Pro</a>
        </article>
      </div>

      <p class="price-foot mono">
        Need more than 1,000/month? <a href="mailto:hello@form4dev.com">Talk to us →</a>
      </p>
    </div>
  </section>

  <!-- =============================================================
       4. CUSTOMER REVIEWS — real placeholders, no fake content
       ============================================================= -->
  <section class="reviews">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">/ what people say</span>
        <h2 class="display section-title">
          Reviews from the field.
        </h2>
        <p class="section-sub">
          We're new — these slots fill up as real users ship and write in.
          If you've shipped a form with us, drop us a line at
          <a class="mono" href="mailto:hello@form4dev.com">hello@form4dev.com</a>.
        </p>
      </div>

      <div class="review-grid">
        <article class="review-card review-empty">
          <span class="review-status mono">awaiting first review</span>
          <p class="review-quote-empty">
            "Your quote here."
          </p>
          <div class="review-attr">
            <div class="avatar"></div>
            <div>
              <div class="review-name">— A real user</div>
              <div class="review-role mono">role · company</div>
            </div>
          </div>
        </article>

        <article class="review-card review-empty">
          <span class="review-status mono">awaiting first review</span>
          <p class="review-quote-empty">
            "Your quote here."
          </p>
          <div class="review-attr">
            <div class="avatar"></div>
            <div>
              <div class="review-name">— A real user</div>
              <div class="review-role mono">role · company</div>
            </div>
          </div>
        </article>

        <article class="review-card review-empty">
          <span class="review-status mono">awaiting first review</span>
          <p class="review-quote-empty">
            "Your quote here."
          </p>
          <div class="review-attr">
            <div class="avatar"></div>
            <div>
              <div class="review-name">— A real user</div>
              <div class="review-role mono">role · company</div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Base>

<script>
  // Tab switching for the hero code sample
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tabs-bar .tab");
  const panes = document.querySelectorAll<HTMLPreElement>(".code-pane");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const lang = tab.dataset.lang;
      tabs.forEach((t) => t.classList.toggle("active", t === tab));
      panes.forEach((p) => p.classList.toggle("hidden", p.dataset.lang !== lang));
    });
  });
</script>

<style>
  /* (Announcement banner styles now live in components/AnnouncementBar.astro) */

  /* ---- Hero ---- */
  .hero {
    padding: 88px 0 64px;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner { display: flex; flex-direction: column; align-items: flex-start; }
  .chip .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 102, 255, 0.18);
  }

  .headline {
    font-size: 80px;
    margin: 22px 0 22px;
    letter-spacing: -0.04em;
    line-height: 0.97;
    max-width: 14ch;
    color: var(--ink);
  }
  .headline .muted { color: var(--muted-2); font-weight: 500; }

  .subhead {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.55;
    max-width: 620px;
    margin: 0 0 28px;
  }
  .inline-code {
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: var(--r-1);
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .hero-note {
    margin-top: 20px;
    color: var(--muted-2);
    font-size: 12.5px;
  }
  .hero-note a {
    color: var(--ink);
    border-bottom: 1px dashed var(--muted-3);
  }

  /* ---- Code tabs ---- */
  .code-tabs {
    width: 100%;
    max-width: 920px;
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: var(--r-3);
    overflow: hidden;
    box-shadow: var(--shadow-deep);
    font-family: var(--font-mono);
    border: 1px solid #1f1f22;
  }
  .tabs-bar {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px 6px 0;
    background: var(--code-bg-2);
    border-bottom: 1px solid #1f1f22;
    overflow-x: auto;
  }
  .tab {
    background: transparent;
    color: var(--muted-2);
    padding: 8px 14px;
    border-radius: var(--r-2) var(--r-2) 0 0;
    font-size: 12.5px;
    font-family: var(--font-mono);
    border: 1px solid transparent;
    border-bottom: 0;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.12s ease, background 0.12s ease;
  }
  .tab:hover { color: var(--code-fg); }
  .tab.active {
    color: var(--code-fg);
    background: var(--code-bg);
    border-color: #1f1f22;
  }
  .tabs-spacer { flex: 1; }
  .tabs-meta {
    color: #6b7280;
    font-size: 11.5px;
    padding: 0 10px;
  }
  .code-pane {
    padding: 22px 26px;
    font-size: 13px;
    line-height: 1.7;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .code-pane.hidden { display: none; }
  .code-pane .prompt { color: var(--code-prompt); margin-right: 8px; }
  .code-pane .cmd    { color: var(--code-cmd); font-weight: 600; }
  .code-pane .str    { color: var(--code-str); }
  .code-pane .key    { color: var(--code-key); }
  .code-pane .fn     { color: var(--code-fn); }
  .code-pane .pun    { color: var(--code-pun); }
  .code-pane .hl     { color: var(--accent); }
  .code-pane .ok     { color: var(--code-ok); display: inline-block; margin-top: 8px; }
  .code-pane .muted  { color: var(--code-muted, #6b7280); display: inline-block; margin-top: 8px; }

  /* ---- Section heads ---- */
  .section-head {
    margin-bottom: 40px;
    max-width: 720px;
  }
  .section-head .eyebrow { display: inline-block; margin-bottom: 12px; }
  .section-title {
    font-size: 40px;
    margin: 0 0 16px;
    letter-spacing: -0.025em;
  }
  .section-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }
  .section-sub a {
    color: var(--ink);
    border-bottom: 1px dashed var(--muted-3);
  }

  /* ---- Pricing ---- */
  .pricing { padding: 88px 0; }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .price-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-4);
    padding: 28px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .price-card-pop {
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink) inset;
  }
  .price-pop-tag {
    position: absolute;
    top: -10px;
    left: 24px;
    background: var(--ink);
    color: #fff;
    font-size: 10.5px;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .price-head { margin-bottom: 20px; }
  .price-name {
    font-size: 14px;
    font-weight: 500;
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .price-amount {
    font-size: 14px;
    margin: 0 0 8px;
    color: var(--muted);
  }
  .price-amount strong {
    font-size: 40px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-right: 4px;
  }
  .price-blurb {
    font-size: 13.5px;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }
  .price-feats {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    flex: 1;
  }
  .price-feats li {
    font-size: 13.5px;
    color: var(--ink-2);
    padding: 8px 0 8px 22px;
    position: relative;
    line-height: 1.5;
    border-bottom: 1px solid var(--line-3);
  }
  .price-feats li:last-child { border-bottom: 0; }
  .price-feats li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 13px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--bg-elev);
  }
  .price-feats li::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 16px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .price-feats strong { color: var(--ink); font-weight: 600; }
  .price-cta { width: 100%; justify-content: center; }
  .price-foot {
    text-align: center;
    color: var(--muted-2);
    font-size: 12.5px;
    margin-top: 32px;
  }
  .price-foot a { color: var(--ink); border-bottom: 1px dashed var(--muted-3); }

  /* ---- Reviews ---- */
  .reviews { padding: 88px 0; background: var(--bg-elev); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .review-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-4);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 220px;
  }
  .review-card.review-empty {
    border-style: dashed;
    background: transparent;
  }
  .review-status {
    font-size: 10.5px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .review-quote-empty {
    font-size: 17px;
    color: var(--muted-2);
    line-height: 1.4;
    margin: 0;
    flex: 1;
    font-weight: 500;
    letter-spacing: -0.005em;
    font-style: italic;
  }
  .review-attr {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px dashed var(--line-2);
  }
  .review-name { font-size: 13.5px; font-weight: 500; color: var(--muted); }
  .review-role { font-size: 11.5px; color: var(--muted-2); }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .headline { font-size: 56px; }
    .section-title { font-size: 32px; }
    .price-grid { grid-template-columns: 1fr; }
    .review-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .headline { font-size: 40px; }
  }
</style>
