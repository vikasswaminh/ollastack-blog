---
import Logo from "./Logo.astro";

const APP = "https://login.ollastack.com";

interface FooterLink { label: string; href: string }
const groups: { title: string; items: FooterLink[] }[] = [
  {
    title: "Product",
    items: [
      { label: "Overview", href: "/" },
      { label: "Email API", href: "/email-api" },
      { label: "Pricing", href: "/pricing" },
      { label: "Quickstart", href: "/docs#quickstart" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Resources",
    items: [
      { label: "All guides", href: "/resources" },
      { label: "Migration hub", href: "/resources/migration-hub" },
      { label: "Developer hub", href: "/resources/developer-hub" },
      { label: "Deliverability hub", href: "/resources/deliverability-hub" },
    ],
  },
  {
    title: "Developers",
    items: [
      { label: "Docs", href: "/docs" },
      { label: "For AI agents", href: "/docs/agents" },
      { label: "OpenAPI spec", href: `${APP}/api/openapi.json` },
      { label: "Webhooks", href: "/docs#webhooks" },
    ],
  },
  {
    title: "Company",
    items: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Careers", href: "/careers" },
      { label: "Custom SMTP", href: "/docs/smtp" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Account",
    items: [
      { label: "Sign in", href: `${APP}/login` },
      { label: "Start free", href: `${APP}/register` },
      { label: "Dashboard", href: `${APP}/dashboard` },
      { label: "Contact us", href: "/contact" },
    ],
  },
];
---

<footer>
  <div class="container-wide foot">
    <div class="foot-grid">
      <div>
        <Logo size={22} />
        <p class="tagline">The message layer for AI agents — forms in, email out, tested in CI. One API.</p>
      </div>
      {groups.map((g) => (
        <div>
          <div class="group-title mono">{g.title}</div>
          <ul>
            {g.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <hr class="hr" />
    <div class="foot-bottom mono">
      <span>© 2026 Ollastack</span>
      <span class="foot-meta">
        <a href="mailto:hello@ollastack.com">hello@ollastack.com</a>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 0;
    padding: 56px 0 28px;
    background: var(--bg);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .tagline {
    color: var(--muted);
    font-size: 13px;
    max-width: 280px;
    margin: 14px 0 0;
    line-height: 1.55;
  }
  .group-title {
    font-size: 11px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  li a {
    font-size: 13px;
    color: var(--muted);
    transition: color 0.12s ease;
  }
  li a:hover { color: var(--ink); }
  .hr { margin: 40px 0 18px; }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--muted-2);
  }
  .foot-meta a {
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .foot-meta a:hover { color: var(--ink); border-color: var(--muted-3); }

  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; gap: 10px; }
  }
</style>
