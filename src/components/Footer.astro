---
import Logo from "./Logo.astro";

const APP = "https://login.ollastack.com";

interface FooterLink { label: string; href: string }
const groups: { title: string; items: FooterLink[] }[] = [
  {
    title: "Blog",
    items: [
      { label: "All Posts", href: "/blog" },
      { label: "Tags", href: "/tags" },
      { label: "RSS Feed", href: "/rss.xml" },
    ],
  },
  {
    title: "Categories",
    items: [
      { label: "AI Agents", href: "/blog?cat=ai-agents" },
      { label: "Email Testing", href: "/blog?cat=email-testing" },
      { label: "Comparisons", href: "/blog?cat=comparisons" },
      { label: "Integrations", href: "/blog?cat=integrations" },
    ],
  },
  {
    title: "Account",
    items: [
      { label: "Sign in", href: `${APP}/login` },
      { label: "Start free", href: `${APP}/register` },
      { label: "Dashboard", href: `${APP}/dashboard` },
    ],
  },
];

// Sister brands under the Ollasoftware Solutions group. Followed links (no
// rel=nofollow) so equity passes between the group's sites. ollastack.com is
// this site, so it's not listed here.
const groupBrands: FooterLink[] = [
  { label: "Ollasoftware", href: "https://ollasoftware.com" },
  { label: "OllaBear", href: "https://ollabear.com" },
  { label: "OllaDNS", href: "https://olladns.com" },
  { label: "OllaGraph", href: "https://ollagraph.com" },
  { label: "OllaLink", href: "https://ollalink.com" },
  { label: "OllaNode", href: "https://ollanode.com" },
  { label: "OllaSuper", href: "https://ollasuper.com" },
  { label: "OllaSync", href: "https://ollasync.com" },
  { label: "OllaVPN", href: "https://ollavpn.com" },
  { label: "OllaWrite", href: "https://ollawrite.com" },
];
---

<footer>
  <div class="container-wide foot">
    <div class="foot-grid">
      <div>
        <Logo size={28} />
        <p class="tagline">The message layer for AI agents — forms in, email out, tested in CI. One API.</p>
      </div>
      {groups.map((g) => (
        <div>
          <div class="group-title mono">{g.title}</div>
          <ul>
            {g.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <hr class="hr" />
    <div class="foot-brands">
      <span class="foot-brands-label mono">Part of the Ollasoftware group</span>
      <nav class="foot-brands-links" aria-label="Ollasoftware group brands">
        {groupBrands.map((b) => <a href={b.href}>{b.label}</a>)}
      </nav>
    </div>
    <hr class="hr hr-tight" />
    <div class="foot-bottom mono">
      <span>© 2026 Ollastack — an Ollasoftware Solutions company</span>
      <span class="foot-meta">
        <a href="mailto:hello@ollastack.com">hello@ollastack.com</a>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 0;
    padding: 56px 0 28px;
    background: var(--bg);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .tagline {
    color: var(--muted);
    font-size: 13px;
    max-width: 280px;
    margin: 14px 0 0;
    line-height: 1.55;
  }
  .group-title {
    font-size: 11px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  li a {
    font-size: 13px;
    color: var(--muted);
    transition: color 0.12s ease;
  }
  li a:hover { color: var(--ink); }
  .hr { margin: 40px 0 18px; }
  .hr-tight { margin: 18px 0 18px; }

  /* Sister-brand strip — cross-links the Ollasoftware group for intra-group
     link equity. Wraps to as many rows as needed; muted so it doesn't compete
     with the primary footer nav. */
  .foot-brands {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
  }
  .foot-brands-label {
    font-size: 11px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 4px;
  }
  .foot-brands-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .foot-brands-links a {
    font-size: 13px;
    color: var(--muted);
    transition: color 0.12s ease;
  }
  .foot-brands-links a:hover { color: var(--ink); }

  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--muted-2);
  }
  .foot-meta a {
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .foot-meta a:hover { color: var(--ink); border-color: var(--muted-3); }

  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; gap: 10px; }
  }
</style>
