---
import Logo from "./Logo.astro";

const groups = [
  { title: "Product",    items: ["Overview", "Quickstart", "Integrations", "Changelog"] },
  { title: "Developers", items: ["REST API", "JS SDK", "React SDK", "Webhooks"] },
  { title: "Company",    items: ["Pricing", "Library", "Blog", "Brand"] },
  { title: "Legal",      items: ["Privacy", "Terms", "Security", "Contact"] },
];
---

<footer>
  <div class="container-wide foot">
    <div class="foot-grid">
      <div>
        <Logo size={22} />
        <p class="tagline">The form backend for developers who'd rather ship than configure.</p>
      </div>
      {groups.map((g) => (
        <div>
          <div class="group-title mono">{g.title}</div>
          <ul>
            {g.items.map((item) => <li><a href="#">{item}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <hr class="hr" />
    <div class="foot-bottom mono">
      <span>© 2026 Form4Dev</span>
      <span class="foot-meta">
        <a href="mailto:hello@form4dev.com">hello@form4dev.com</a>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 0;
    padding: 56px 0 28px;
    background: var(--bg);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .tagline {
    color: var(--muted);
    font-size: 13px;
    max-width: 280px;
    margin: 14px 0 0;
    line-height: 1.55;
  }
  .group-title {
    font-size: 11px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  li a {
    font-size: 13px;
    color: var(--muted);
    transition: color 0.12s ease;
  }
  li a:hover { color: var(--ink); }
  .hr { margin: 40px 0 18px; }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--muted-2);
  }
  .foot-meta a {
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .foot-meta a:hover { color: var(--ink); border-color: var(--muted-3); }

  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; gap: 10px; }
  }
</style>
