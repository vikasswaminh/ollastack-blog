---
import Logo from "./Logo.astro";

const groups = [
  { title: "Product", items: ["Overview", "Quickstart", "Integrations", "Changelog"] },
  { title: "Developers", items: ["REST API", "JS SDK", "React SDK", "Webhooks"] },
  { title: "Company", items: ["About", "Blog", "Careers", "Brand"] },
  { title: "Legal", items: ["Privacy", "Terms", "Security", "DPA"] },
];
---

<footer>
  <div class="container-wide foot">
    <div class="foot-grid">
      <div>
        <Logo size={22} />
        <p class="tagline">The form backend for developers who'd rather ship than configure.</p>
        <div class="badges">
          <span class="mono badge">SOC 2</span>
          <span class="mono badge">GDPR</span>
        </div>
      </div>
      {groups.map((g) => (
        <div>
          <div class="group-title">{g.title}</div>
          <ul>
            {g.items.map((item) => <li><a href="#">{item}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <hr class="hr" />
    <div class="foot-bottom mono">
      <span>© 2026 Form4Dev — All bytes reserved.</span>
      <span class="status">
        <span class="dot"></span>
        All systems normal · 99.998% (30d)
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 80px;
    padding: 56px 0 32px;
    background: var(--bg);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .tagline {
    color: var(--muted);
    font-size: 13px;
    max-width: 260px;
    margin: 14px 0 16px;
    line-height: 1.6;
  }
  .badges {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }
  .badge {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .group-title {
    font-size: 12px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  li a {
    font-size: 13px;
    color: var(--ink-2);
  }
  li a:hover {
    color: var(--ink);
  }
  .hr { margin: 48px 0 20px; }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--ok);
  }
  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; gap: 10px; }
  }
</style>
