---
// form4dev mark — a form-card icon in McDonald's red (PMS 485, #DA291C).
// A rounded red square with three white horizontal lines representing
// form fields. Reads as "form" at every size — favicon-tiny up to
// hero-large — without depending on stroke weight at small px.
// The wordmark ("form4dev") sits next to it in ink, matching the
// brand-red treatment used on the marketing site's announce bar.
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 24, withWordmark = true } = Astro.props;
---

<a href="/" aria-label="form4dev" class="logo-lockup">
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="logo-mark"
  >
    <rect x="2" y="2" width="20" height="20" rx="4" fill="#DA291C" />
    <rect x="6" y="8"  width="7"  height="2" rx="1" fill="#ffffff" />
    <rect x="6" y="12" width="12" height="2" rx="1" fill="#ffffff" />
    <rect x="6" y="16" width="9"  height="2" rx="1" fill="#ffffff" />
  </svg>
  {withWordmark && (
    <span class="wordmark">form4dev</span>
  )}
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .logo-mark { display: block; flex-shrink: 0; }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 16px;
    color: var(--ink);
    line-height: 1;
  }
</style>
