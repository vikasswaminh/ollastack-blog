---
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 38, withWordmark = true } = Astro.props;
---

<a href="/blog" aria-label="ollastack" class="logo-lockup">
  <img
    src="/ollastack-logo-mark.png"
    alt="Ollastack"
    width={size}
    height={size}
    class="logo-img"
    loading="eager"
  />
  {withWordmark && (
    <span class="wordmark">
      <span class="brand-olla">olla</span><span class="brand-stack">stack</span>
    </span>
  )}
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }
  .logo-img {
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }
  .wordmark {
    font-family: 'Plus Jakarta Sans', var(--font-sans), sans-serif;
    font-weight: 900;
    letter-spacing: -0.04em;
    font-size: 29px;
    line-height: 1;
    display: inline-flex;
  }
  .brand-olla {
    color: #000000;
    font-weight: 900;
  }
  .brand-stack {
    color: #E11D48;
    font-weight: 900;
  }
</style>
