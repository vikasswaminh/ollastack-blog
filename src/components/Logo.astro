---
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 24, withWordmark = true } = Astro.props;
---

<a href="/" aria-label="form4dev" class="logo-lockup">
  <!-- Mark: tight black tile with mono "f4" inside, on a 1px square. Daytona-vibe. -->
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <rect width="24" height="24" rx="5" fill="#0a0a0a"/>
    <text x="12" y="16.2" text-anchor="middle"
          font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace"
          font-size="11.5" font-weight="700" fill="#ffffff" letter-spacing="-0.5">f4</text>
  </svg>
  {withWordmark && (
    <span class="wordmark">form<span class="dim">4</span>dev</span>
  )}
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 16px;
    color: var(--ink);
  }
  .dim { color: var(--muted-2); font-weight: 500; }
</style>
