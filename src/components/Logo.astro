---
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 28, withWordmark = true } = Astro.props;
---

<a href="/" aria-label="form4dev" class="logo-lockup">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#0a0a0a"/>
    <rect x="14" y="17" width="32" height="3.5" rx="1.75" fill="#c4fc5c"/>
    <rect x="14" y="26" width="32" height="3.5" rx="1.75" fill="#c4fc5c"/>
    <rect x="14" y="35" width="20" height="3.5" rx="1.75" fill="#c4fc5c" opacity="0.7"/>
    <rect x="36" y="39" width="16" height="14" rx="4" fill="#c4fc5c"/>
    <text x="44" y="50.5" text-anchor="middle"
          font-family="ui-monospace, 'SF Mono', Menlo, monospace"
          font-size="11" font-weight="800" fill="#0a0a0a">4</text>
  </svg>
  {withWordmark && (
    <span class="wordmark">form<span class="brand-4">4</span>dev</span>
  )}
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #0a0a0a;
  }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 18px;
    color: #0a0a0a;
  }
  .brand-4 {
    background: #c4fc5c;
    padding: 0 4px;
    border-radius: 3px;
  }
</style>
