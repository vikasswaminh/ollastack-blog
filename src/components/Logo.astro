---
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 48, withWordmark = true } = Astro.props;
---

<a href="/blog" aria-label="ollastack" class="logo-lockup">
  <img
    src="/ollastack-logo-mark.png"
    alt="Ollastack"
    width={size}
    height={size}
    class="logo-img"
    loading="eager"
  />
  {withWordmark && (
    <span class="wordmark">
      <span class="brand-olla">olla</span><span class="brand-stack">stack</span>
    </span>
  )}
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.18s ease;
  }
  .logo-lockup:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }
  .logo-lockup:active {
    transform: scale(0.96);
  }
  .logo-img {
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }
  .wordmark {
    font-family: 'Plus Jakarta Sans', var(--font-sans), sans-serif;
    font-weight: 900;
    letter-spacing: -0.045em;
    font-size: 34px;
    line-height: 1;
    display: inline-flex;
    user-select: none;
  }
  .brand-olla {
    color: #000000;
  }
  .brand-stack {
    color: #DC2626;
  }
</style>
