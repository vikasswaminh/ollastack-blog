---
import Logo from "./Logo.astro";
interface Props {
  current?: string;
}
const { current } = Astro.props;
const links = [
  { href: "/", label: "Product", id: "home" },
  { href: "/docs", label: "Docs", id: "docs" },
  { href: "/pricing", label: "Pricing", id: "pricing" },
  { href: "/changelog", label: "Changelog", id: "changelog" },
];
const APP = "https://login.form4dev.com";
---

<header class="nav">
  <div class="container-wide nav-inner">
    <div class="nav-left">
      <Logo size={26} />
      <nav class="nav-links" aria-label="Primary">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", current === link.id && "active"]}
          >{link.label}</a>
        ))}
      </nav>
    </div>
    <div class="nav-right">
      <a class="github-pill" href="https://github.com/vikasswaminh/form4dev" target="_blank" rel="noreferrer noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17a10.96 10.96 0 015.74 0c2.2-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.36.78 1.06.78 2.13v3.16c0 .31.21.66.8.55C20.22 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
        <span class="sr-only">GitHub</span>
      </a>
      <a class="btn btn-ghost btn-sm" href={`${APP}/login`}>Sign in</a>
      <a class="btn btn-primary btn-sm" href={`${APP}/register`}>
        Start free
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 250, 247, 0.85);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    font-size: 14px;
    color: var(--muted);
    padding: 6px 10px;
    border-radius: 6px;
    transition: color 0.12s ease, background 0.12s ease;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link.active { color: var(--ink); }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .github-pill {
    color: var(--muted);
    padding: 6px;
    display: inline-flex;
    border-radius: 6px;
  }
  .github-pill:hover { color: var(--ink); background: var(--bg-sunken); }
  .btn-sm { height: 32px; padding: 0 12px; font-size: 13px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 720px) {
    .nav-links { display: none; }
  }
</style>
