---
import Logo from "./Logo.astro";
interface Props { current?: string }
const { current = "blog" } = Astro.props;
const APP = "https://login.ollastack.com";

const links = [
  { href: "https://ollastack.com/#product", label: "Product", hasDropdown: true },
  { href: "https://ollastack.com/#use-cases", label: "Use cases" },
  { href: "https://ollastack.com/#email-api", label: "Email API" },
  { href: "https://ollastack.com/#docs", label: "Docs" },
  { href: "https://ollastack.com/#resources", label: "Resources", hasDropdown: true },
  { href: "/blog", label: "Blog", id: "blog" },
  { href: "https://ollastack.com/#pricing", label: "Pricing" },
];
---

<header class="navbar">
  <div class="nav-container">
    <div class="nav-brand">
      <Logo size={46} />
    </div>

    <nav class="nav-pill-wrapper" aria-label="Primary">
      <div class="nav-pill">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={["nav-pill-link", (current === link.id || link.id === "blog") && "active"]}
          >
            <span>{link.label}</span>
            {link.hasDropdown && (
              <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </nav>

    <div class="nav-actions">
      <a class="nav-signin" href={`${APP}/login`}>Sign in</a>
      <a class="btn-start-free" href={`${APP}/register`}>
        <span>Start free</span>
        <span class="arrow">→</span>
      </a>
      <button
        type="button"
        class="nav-burger"
        id="nav-burger"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav-mobile-menu" id="nav-mobile">
    {links.map((link) => (
      <a href={link.href} class="nav-mobile-item">{link.label}</a>
    ))}
    <div class="mobile-cta-wrap">
      <a class="nav-mobile-item" href={`${APP}/login`}>Sign in</a>
      <a class="btn-start-free mobile" href={`${APP}/register`}>Start free →</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-burger");
    var panel = document.getElementById("nav-mobile");
    if (!btn || !panel) return;
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      panel.classList.toggle("open");
    });
  })();
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #f1f5f9;
    padding: 12px 0;
  }
  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
  }

  /* Centered Pill Navigation Bar */
  .nav-pill-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    padding: 4px 6px;
  }
  .nav-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13.5px;
    font-weight: 500;
    color: #52525b;
    padding: 6px 14px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .nav-pill-link:hover {
    color: #09090b;
  }
  .nav-pill-link.active {
    background: #ffffff;
    color: #09090b;
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }
  .chevron {
    opacity: 0.6;
  }

  /* Right Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-signin {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    text-decoration: none;
    padding: 6px 10px;
    transition: color 0.15s ease;
  }
  .nav-signin:hover {
    color: #E11D48;
  }
  .btn-start-free {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #DC2626;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 800;
    padding: 9px 22px;
    border-radius: 9999px;
    text-decoration: none !important;
    box-shadow: 0 4px 16px rgba(220, 38, 38, 0.38);
    transition: all 0.18s ease;
  }
  .btn-start-free:hover {
    background: #B91C1C;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
  }
  .btn-start-free .arrow {
    font-weight: 800;
    transition: transform 0.15s ease;
  }
  .btn-start-free:hover .arrow {
    transform: translateX(2px);
  }

  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
    color: #0f172a;
    cursor: pointer;
  }

  .nav-mobile-menu {
    display: none;
    flex-direction: column;
    padding: 16px;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }
  .nav-mobile-menu.open { display: flex; }
  .nav-mobile-item {
    padding: 10px 12px;
    font-size: 15px;
    color: #334155;
    font-weight: 500;
    text-decoration: none;
  }
  .mobile-cta-wrap {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .btn-start-free.mobile {
    justify-content: center;
  }

  @media (max-width: 960px) {
    .nav-pill-wrapper { display: none; }
    .nav-burger { display: flex; }
  }
</style>
