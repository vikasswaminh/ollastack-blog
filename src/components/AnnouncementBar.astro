---
// Site-wide announcement strip rendered above the Nav. Pure-presentational —
// content lives here, dismissable behavior could be added later via a
// localStorage flag if needed.
---

<div class="announce">
  <div class="container-wide announce-inner">
    <span class="announce-chip mono">NEW</span>
    <span class="announce-text">
      AI agents now first-class:
      <span class="mono announce-highlight">Bearer tokens · audit log · cross-tenant guard</span>
      — submissions stamped 🤖, skip captcha + spam pipeline.
    </span>
    <a href="/docs/agents" class="announce-cta">Read agent docs →</a>
  </div>
</div>

<style>
  .announce {
    background: var(--brand-red);
    color: #fff;
    border-bottom: 1px solid var(--brand-red-2);
  }
  .announce-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    font-size: 13px;
    color: #ffe4e1;
  }
  .announce-chip {
    background: #fff;
    color: var(--brand-red);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .announce-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .announce-highlight { color: #fff; }
  .announce-cta {
    color: #fff;
    font-size: 13px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.12s ease;
    flex-shrink: 0;
  }
  .announce-cta:hover { border-color: #fff; }

  @media (max-width: 720px) {
    .announce-text { white-space: normal; line-height: 1.3; }
    .announce-inner { height: auto; padding: 8px 0; }
  }
</style>
