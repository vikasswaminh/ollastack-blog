---
// Announcement bar — blueprint: centered gray strip with red dot + geo-smart leads text
---

<div class="announce">
  <div class="announce-inner">
    <span class="announce-dot" aria-hidden="true"></span>
    <span class="announce-text">
      <strong>GEO-smart leads</strong> — every form submission auto-stamped with country, city, region, and timezone.
    </span>
  </div>
</div>

<style>
  .announce {
    background: #f9f9f9;
    border-bottom: 1px solid #e5e5e7;
  }
  .announce-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 36px;
    font-size: 13px;
    color: #52525b;
    padding: 0 28px;
  }
  .announce-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e11d48;
    flex-shrink: 0;
  }
  .announce-text strong { color: #0a0a0a; }

  @media (max-width: 640px) {
    .announce-inner { font-size: 12px; }
  }
</style>
