---
// Exact announcement bar matching the screenshot
---

<aside class="announce-bar" aria-label="Announcements">
  <div class="announce-track">
    <div class="announce-item">
      <span class="dot-red"></span>
      <span class="tag-pill">AI AGENTS</span>
      <span class="announce-text"><strong>Agent Mailboxes</strong> — programmatic OTP reading & automated email verification in CI.</span>
    </div>
    <div class="announce-item">
      <span class="dot-red"></span>
      <span class="tag-pill">ZERO CONFIG</span>
      <span class="announce-text"><strong>Multi-Tenant SMTP</strong> — send from your custom domain with automatic DKIM & SPF.</span>
    </div>
    <div class="announce-item">
      <span class="dot-red"></span>
      <span class="tag-pill">LIVE TESTING</span>
      <span class="announce-text"><strong>Email Testing API</strong> — disposable inboxes for CI/CD Playwright & Cypress.</span>
    </div>
  </div>
</aside>

<style>
  .announce-bar {
    background: #ffffff;
    border-bottom: 1px solid #f1f5f9;
    padding: 8px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .announce-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    font-size: 12px;
    color: #475569;
  }
  .announce-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
  }
  .dot-red {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #DC2626;
    box-shadow: 0 0 6px rgba(220, 38, 38, 0.6);
  }
  .tag-pill {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #DC2626;
    background: #fef2f2;
    border: 1px solid #fecaca;
    padding: 1px 6px;
    border-radius: 4px;
  }
  .announce-text strong {
    color: #0f172a;
  }

  @media (max-width: 900px) {
    .announce-track {
      justify-content: flex-start;
      padding: 0 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .announce-track::-webkit-scrollbar { display: none; }
  }
</style>
